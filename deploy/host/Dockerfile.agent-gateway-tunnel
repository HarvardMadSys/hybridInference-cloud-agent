# One fixed-destination hop used by the remote-host topology. Separate image
# instances expose the inference and MCP-only listeners to sandbox groups,
# attached to each group's bridge; another exposes the control API only to
# runners.
#
# Small on purpose: it sits on every group bridge. The host rules open only its
# service port to a sandbox there, but the less installed here, the less to
# reason about. openssh-client and a shell, nothing else.
FROM alpine:3.21

RUN apk add --no-cache openssh-client

COPY deploy/host/agent-gateway-tunnel.sh /usr/local/bin/agent-gateway-tunnel
RUN chmod +x /usr/local/bin/agent-gateway-tunnel

# No HEALTHCHECK, deliberately. ssh already supervises itself here in ways this
# image can rely on: ExitOnForwardFailure means it dies rather than sit there
# having bound nothing, and the keepalives mean a peer that stops answering
# ends the process. Both turn into a restart via the compose policy. A port
# probe would need a TCP-testing tool in the image, and the only one available
# in this base is BusyBox's nc, whose flags vary by build — a healthcheck that
# is wrong about its own tooling reports a working tunnel as unhealthy forever.
# What actually answers the question is `sandbox_host.sh check`, which
# asks from inside the closed network where it matters.
# What this image is, in the two places a deployment looks: OCI's own labels,
# and one of ours naming the artifact's role. A resolver reads both out of the
# platform image it is about to run and compares them with the release
# manifest — the revision against the manifest's source commit, the role
# against the artifact it stands in for — so a build matrix that swaps two
# digests is caught where the release is consumed rather than where it is
# deployed. `SOURCE_COMMIT` is supplied by the publication build; an image
# built by hand says `unknown`, and a resolver refuses it.
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/HarvardMadSys/hybridInference-cloud-agent" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.hybridinference.artifact.role="tunnel"

ENTRYPOINT ["/usr/local/bin/agent-gateway-tunnel"]
