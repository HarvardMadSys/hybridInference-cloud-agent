# syntax=docker/dockerfile:1.7
#
# The self-hosted agent runner (issue #1041).
#
# This is the TRUSTED side. It holds the enrolled-host and short-lived clone
# credentials, then coordinates turns with the retained shared sandbox. Only
# the inference grant and MCP token cross into that sandbox. The agent itself
# never runs here, which is why this image carries a Docker client and the
# sandbox image deliberately does not.
#
# Two tools this image must have, and the reason each is load-bearing:
#
#   docker  The container backend shells out to it to start each sandbox.
#           Without it the runner's preflight fails on every host and no job
#           can run at all — the backend image alone is not enough.
#   git     The runner clones the job's repository before the agent starts.
#           Cloning here rather than inside the sandbox is what keeps the
#           repository credential out of the agent's reach.

FROM python:3.12-slim AS builder

ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR%/}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o APT::Update::Error-Mode=any update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_DEFAULT_TIMEOUT=120
ARG UV_HTTP_TIMEOUT=120
RUN pip install uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
# Mirrors Dockerfile.backend: the private routewise dependency needs a token,
# and `-s` so an empty secret (local dev) does not break anonymous fetches.
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
        token="$(cat /run/secrets/github_token)" && \
        git config --global \
            url."https://x-access-token:${token}@github.com/".insteadOf \
            "https://github.com/"; \
    fi && \
    uv sync --frozen --no-dev --no-install-project && \
    if [ -s /run/secrets/github_token ]; then \
        git config --global --unset-all \
            url."https://x-access-token:${token}@github.com/".insteadOf || true; \
    fi

FROM python:3.12-slim

ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR%/}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o APT::Update::Error-Mode=any update && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The client only — no daemon. The runner talks to the host's daemon over the
# bind-mounted socket; a second daemon in here would be both wrong and
# considerably more privilege than this needs.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
COPY --from=builder /app/.venv .venv
ENV PATH="/app/.venv/bin:$PATH"

COPY cloud_agent_contracts/ cloud_agent_contracts/
COPY cloud_agent_git/ cloud_agent_git/
COPY cloud_agent_host/ cloud_agent_host/
# A new runner may adopt retained containers created from the previous image.
# Keep the reviewed helper on the trusted side so it can atomically upgrade
# those containers before their first post-deploy activation.
COPY deploy/sandbox/member-process-reaper /usr/local/libexec/member-process-reaper
RUN chmod 0555 /usr/local/libexec/member-process-reaper
COPY deploy/sandbox/pi-freeinference deploy/sandbox/pi-mcp-bridge.ts \
     deploy/sandbox/opencode-freeinference deploy/sandbox/kilo-freeinference \
     deploy/sandbox/http-agent-live-bridge /usr/local/libexec/mcp-runtime/
RUN chmod 0555 /usr/local/libexec/mcp-runtime/*

# Root on purpose, and only here. The runner and broker need the host Docker
# socket to create/start/stop retained containers. Repository source is cloned
# into a short-lived runner directory, credential-scrubbed, and streamed into
# the container; that directory is never bind-mounted into the sandbox.
# What this image is, in the two places a deployment looks: OCI's own labels,
# and one of ours naming the artifact's role. A resolver reads both out of the
# platform image it is about to run and compares them with the release
# manifest — the revision against the manifest's source commit, the role
# against the artifact it stands in for — so a build matrix that swaps two
# digests is caught where the release is consumed rather than where it is
# deployed. `SOURCE_COMMIT` is supplied by the publication build; an image
# built by hand says `unknown`, and a resolver refuses it.
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/HarvardMadSys/hybridInference-cloud-agent" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.hybridinference.artifact.role="runner"

USER root

CMD ["python", "-m", "cloud_agent_host.runner"]
