# syntax=docker/dockerfile:1.7
#
# The allowlist proxy for the Trusted egress tier (issue #1041).
#
# This container is the only thing on each chat-private setup network with a
# route to the internet. Those networks are `internal: true`, so this is not a
# policy the sandbox is asked to respect — it is the only door in the room.
#
# It holds no credentials and mounts no socket. Its whole job is to accept
# CONNECT for a host on the generated allowlist and refuse everything else,
# which is why it is a separate image from the runner: the runner is trusted
# and holds enrolled-host credentials, and nothing that talks to an untrusted
# sandbox should share an image with it.
#
# The configuration is NOT baked in. It is rendered by
# `cloud_agent_host.egress_proxy` into a volume this container reads at
# start, because the allowlist is deployment configuration and rendering it
# there is what runs the validation that keeps a hostile value out of a config
# file.
#
# The standalone host compose starts this beside a network-isolated config
# renderer. The proxy joins the internal discovery backplane, every active
# chat-private setup bridge, and its routable uplink; it never joins the
# runner/control network or mounts Docker.

FROM debian:bookworm-slim

# Squid from the distribution, so security updates arrive with the base image.
# The tag pins a major version; a production deployment should pin the base by
# digest as well.
ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR%/}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o APT::Update::Error-Mode=any update && apt-get install -y --no-install-recommends \
        squid \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# **`chown` first, and this container does not start without it.**
#
# Squid switches to `cache_effective_user` (Debian: `proxy`) during startup and
# opens its log destinations *after* the switch. In a container `/dev/stdout`
# is a symlink to `/proc/self/fd/1` — a `prw-------` pipe owned by `root` —
# so the open fails, and squid treats an unwritable log as fatal:
#
#     FATAL: Cannot open '/dev/stdout' for writing.
#
# It exits, `restart: unless-stopped` restarts it, and it exits again. That
# loop ran 2814 times on staging from 2026-08-03 without one successful start,
# and it took every agent job with it: the runner's isolation preflight
# correctly refuses to start when the proxy is unreachable, so three runners
# and the workspace broker crash-looped behind a proxy that had never once come
# up.
#
# Two fixes were rejected. `cache_effective_user root` does not work at all —
# squid refuses with "Don't run Squid as root". Logging to a file `proxy` can
# write gives up the only reason these logs exist: a closed network drops a
# refused connection silently, so this proxy is the single place a denied
# egress attempt is observable, and a log that never reaches `docker logs` is
# a refusal nobody sees.
#
# `|| true` because a container run with a TTY has a different stdout that may
# not need (or accept) this. If the chown was needed and did not happen, squid
# still says so on its first line — this is a fix, not a silencer.
#
# `-k parse` next: a config Squid rejects should say so on the first line of
# this container's logs, not present as "the proxy is unreachable" three layers
# away in a runner's preflight. `&&` means a rejected config never reaches the
# run step.
#
# Then `-N` to stay in the foreground (the container *is* the supervisor) and
# `-f` to use the generated file rather than the package's default config,
# which permits far more than this deployment intends.
#
# No fallback to /etc/squid/squid.conf if the generated file is missing: this
# must fail rather than quietly start an allow-by-default proxy on the
# sandbox's network.
# What this image is, in the two places a deployment looks: OCI's own labels,
# and one of ours naming the artifact's role. A resolver reads both out of the
# platform image it is about to run and compares them with the release
# manifest — the revision against the manifest's source commit, the role
# against the artifact it stands in for — so a build matrix that swaps two
# digests is caught where the release is consumed rather than where it is
# deployed. `SOURCE_COMMIT` is supplied by the publication build; an image
# built by hand says `unknown`, and a resolver refuses it.
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/HarvardMadSys/hybridInference-cloud-agent" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.hybridinference.artifact.role="egress"

CMD ["/bin/sh", "-c", "chown proxy /dev/stdout /dev/stderr 2>/dev/null || true; squid -k parse -f /etc/squid/generated/squid.conf && exec squid -N -f /etc/squid/generated/squid.conf"]
