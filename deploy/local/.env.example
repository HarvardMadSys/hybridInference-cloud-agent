# Generated automatically as deploy/local/.env.local by ./deploy/local/dev.sh.
# This file documents the local-only shape; do not paste production secrets
# here. The generated file is ignored by git.

AGENT_POSTGRES_USER=cloudagent
AGENT_POSTGRES_DB=cloudagent
AGENT_POSTGRES_PASSWORD=
AGENT_DATABASE_URL=

GATEWAY_BASE_URL=http://local-gateway:8080
GATEWAY_JWKS_URL=http://local-gateway:8080/v1/identity/jwks
# Browser-facing, unlike the two above: the control plane redirects the browser
# here, so it must be an address the browser can reach — through the edge, not
# the compose network name.
GATEWAY_AUTHORIZE_URL=http://127.0.0.1:13002/authorize
AGENT_SESSION_REDIRECT_URI=http://127.0.0.1:13002/api/v1/session/callback
AGENT_WEB_BASE_URL=http://127.0.0.1:13002
GATEWAY_GRANT_DISPATCH_TOKEN=

AGENT_SESSION_SECRET=
AGENT_CONTROL_TOKEN_SECRET=
AGENT_SOURCE_CONTROL_ENCRYPTION_KEY=
AGENT_SANDBOX_MANAGER_TOKEN=
LOCAL_ENROLL_TOKEN=
LOCAL_ENROLL_TOKEN_SHA256=

AGENT_SESSION_COOKIE_SECURE=false
AGENT_REPO_ALLOWLIST=local/demo
AGENT_SANDBOX_MANAGER_URL_ALLOWED_HOSTS=sandbox-manager

AGENT_NETWORK_NAME=freeinference-local-control
AGENT_CONTROL_PLANE_PORT=18000
AGENT_MCP_RELAY_PORT=18001
AGENT_WEB_PORT=13003
LOCAL_EDGE_PORT=13002
LOCAL_PROJECT_NAME=freeinference-local
# dev.sh derives these from LOCAL_PROJECT_NAME unless an existing env file
# explicitly overrides them. Two host slots are the minimum for concurrent forks.
LOCAL_SANDBOX_IMAGE=freeinference-cloud-agent-sandbox-freeinference-local:local
LOCAL_HOST_SLOTS=2
AGENT_DEPLOYMENT_SHA=unknown
LOCAL_RELAY_NETWORK=freeinference-local-agent-relays
# One /29 per sandbox group. A second local stack on the same Docker engine
# needs a pool of its own: the host rules refuse the later of two that overlap.
LOCAL_CHAT_NETWORK_POOL=10.240.0.0/16
# The one resolver sandboxes may reach. dev.sh writes the resolver this Docker
# engine already gives containers (192.168.5.1 on Colima, for example), or
# 1.1.1.1 when it finds none.
LOCAL_EGRESS_DNS_SERVER=
# Extra IPv4 blocks sandboxes must not reach, on top of the private and
# special-purpose ones. Only adds protection.
LOCAL_EGRESS_PROTECTED_CIDRS=
# Optional override. Empty derives both loopback callback URLs from LOCAL_EDGE_PORT.
LOCAL_IDENTITY_ALLOWED_REDIRECTS=

AGENT_WEB_BASE_PATH=
AGENT_WEB_API_URL=/api
AGENT_WEB_GATEWAY_URL=
AGENT_WEB_APP_NAME=FreeInference Cloud Agent (local)

# The production default is 1800 seconds. Shorter locally makes stop/resume
# observable without changing the product default.
LOCAL_CHAT_IDLE_TIMEOUT_S=15
LOCAL_AGENT_TIMEOUT_S=600
AGENT_RETAINED_DOCKER_DATA_ROOT=/var/lib/docker
