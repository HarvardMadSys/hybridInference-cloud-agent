FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --no-cache-dir \
      "cryptography>=48.0.1" \
      "fastapi>=0.110.0" \
      "PyJWT>=2.13.0" \
      "uvicorn[standard]>=0.27.0" \
    && useradd --create-home --uid 10001 localgateway

COPY deploy/local/gateway.py /app/gateway.py

USER localgateway
EXPOSE 8080
CMD ["uvicorn", "gateway:app", "--host", "0.0.0.0", "--port", "8080"]
