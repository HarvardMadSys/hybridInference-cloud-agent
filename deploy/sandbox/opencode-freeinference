#!/usr/bin/env python3
"""Point OpenCode at this deployment's gateway, then run it.

OpenCode does not honour ``OPENAI_BASE_URL``, and its startup normally fetches
the models.dev catalog — which in the deny-all sandbox fails every time. This
wrapper closes both gaps: it writes an ``OPENCODE_CONFIG`` file declaring a
``freeinference`` provider over the **bundled** ``@ai-sdk/openai-compatible``
package (compiled into the CLI binary — nothing is downloaded at run time),
disables the catalog fetch and other phone-home paths, and ``exec``s the real
CLI with argv passed through untouched.

Ships in the sandbox image (reviewed and pinned there, like the CLI itself).
Same properties as the pi wrapper, deliberately:

- **The prompt never passes through a shell.** argv in, argv out, one exec.
- **The config never lives in the workspace.** It is written into the
  member's activation tmpfs.
- **json.dump does the quoting**, so a model id or URL cannot corrupt it.
"""

import json
import os
import sys


#: The environment variable the control plane publishes the relay entry in, as
#: ``{name: url}`` -- one entry, at the relay's merged endpoint, which answers
#: for every connection the job bound rather than for one alias each. Kept in
#: step with ``MCP_SERVERS_ENV`` in ``cloud_agent_host/runtimes.py``.
MCP_SERVERS_ENV = "AGENT_MCP_SERVERS"

#: The per-attempt token, referenced from the config rather than written into
#: it. Kept in step with ``MCP_TOKEN_ENV`` in ``cloud_agent_host/runtimes.py``.
MCP_TOKEN_ENV = "AGENT_MCP_TOKEN"

#: How this CLI interpolates an environment variable in a config file. Checked
#: against the pinned binary: it is a text substitution over the raw file, run
#: before parsing, so the reference has to survive JSON encoding as plain text
#: -- which it does, and which is why the wrong syntax here fails silently as a
#: literal ``{env:...}`` bearer token rather than as a config error.
_ENV_REFERENCE = "{env:" + MCP_TOKEN_ENV + "}"

#: Characters that cannot survive the substitution above: the token is written
#: into the config *text* before it is parsed, so an unescaped quote or
#: backslash would corrupt the document. Tokens this platform mints are
#: base64url and contain neither; this guards a future format.
_UNSAFE_IN_TOKEN = ('"', "\\")


def mcp_servers() -> dict[str, object]:
    """Build the platform's MCP entries from the environment.

    Normally one entry, at the relay's merged endpoint, rather than one key per
    connection: that endpoint lists every connection's tools from the single
    URL, already namespaced by alias, so a key per connection would register the
    same catalogue once per connection.

    An empty mapping is written when the run has no connections, and the key is
    written either way: a config that declared MCP only sometimes would leave
    the CLI free to find its own sources on the turns where it does not, which
    is the shape the project-config kill switch exists to prevent.
    """
    raw = os.environ.get(MCP_SERVERS_ENV) or "{}"
    try:
        endpoints = json.loads(raw)
    except ValueError:
        sys.stderr.write(
            f"opencode-freeinference: {MCP_SERVERS_ENV} is not valid JSON; refusing to start rather "
            "than running with no tools or with somebody else's.\n"
        )
        raise SystemExit(64) from None
    if not isinstance(endpoints, dict):
        sys.stderr.write(f"opencode-freeinference: {MCP_SERVERS_ENV} must be an object.\n")
        raise SystemExit(64)
    token = os.environ.get(MCP_TOKEN_ENV, "")
    if endpoints and not token:
        sys.stderr.write(
            f"opencode-freeinference: {MCP_SERVERS_ENV} names connections but {MCP_TOKEN_ENV} is "
            "empty; every call would be refused.\n"
        )
        raise SystemExit(64)
    if any(character in token for character in _UNSAFE_IN_TOKEN):
        sys.stderr.write(
            f"opencode-freeinference: {MCP_TOKEN_ENV} contains a character that cannot survive config "
            "interpolation.\n"
        )
        raise SystemExit(64)
    return {
        str(alias): {
            "type": "remote",
            "url": str(url),
            "enabled": True,
            "timeout": 1_560_000,
            "headers": {"Authorization": "Bearer " + _ENV_REFERENCE},
            # The relay speaks MCP with a job token, not OAuth. Left on, the CLI
            # would probe this platform for authorization-server metadata and
            # fail the server as unauthenticated before the first call.
            "oauth": False,
        }
        for alias, url in endpoints.items()
    }

def main() -> None:
    """Write OpenCode's provider config from the environment and exec it."""
    try:
        base_url = os.environ["OPENAI_BASE_URL"]
        api_key = os.environ["OPENAI_API_KEY"]
        model = os.environ["OPENCODE_GATEWAY_MODEL"]
    except KeyError as missing:
        sys.stderr.write(
            f"opencode-freeinference: {missing.args[0]} is not set; this wrapper "
            "is meant to be launched by the agent runner, which supplies it.\n"
        )
        raise SystemExit(64) from None

    # Provider config embeds the current turn credential. Retained execution
    # points this at /run/agent-activation (a tmpfs), while OpenCode's XDG data
    # root is separately placed under /agent-state for native session resume.
    config_dir = os.environ.get("OPENCODE_FREEINFERENCE_CONFIG_DIR")
    if config_dir:
        os.makedirs(config_dir, exist_ok=True)
        config_path = os.path.join(config_dir, "config.json")
    else:
        config_path = os.path.expanduser("~/.opencode-freeinference.json")
    # No command-line flag exists for the reasoning effort, so it arrives in
    # the environment and belongs here. Verified against the pinned CLI:
    # `options.reasoningEffort` is the one shape that reaches the wire as
    # `reasoning_effort`; `options.reasoning_effort` and a top-level key both
    # silently do nothing. Absent means no option at all, which is the request
    # this wrapper has always produced.
    model_entry: dict[str, object] = {"name": model}
    effort = os.environ.get("OPENCODE_GATEWAY_REASONING_EFFORT")
    if effort:
        model_entry["options"] = {"reasoningEffort": effort}
    config = {
        # One reviewed source, written every run -- including when it is empty.
        # The project config is disabled below, so this is the only MCP source
        # the CLI will see.
        "mcp": mcp_servers(),
        "provider": {
            "freeinference": {
                # Bundled in the opencode binary; with the catalog fetch
                # disabled below, nothing here needs the network.
                "npm": "@ai-sdk/openai-compatible",
                "name": "FreeInference",
                "options": {"baseURL": base_url, "apiKey": api_key},
                # The catalog is off, so the model must be declared or every
                # run dies with ProviderModelNotFoundError.
                "models": {model: model_entry},
            }
        }
    }
    with open(config_path, "w", encoding="utf-8") as handle:
        json.dump(config, handle)

    os.environ.update(
        {
            "OPENCODE_CONFIG": config_path,
            # OpenCode otherwise merges both `opencode.json` and `.opencode/`
            # from the repository after this reviewed config. Those sources
            # can declare local MCP commands. Its supported kill switch covers
            # both project config forms.
            "OPENCODE_DISABLE_PROJECT_CONFIG": "1",
            # Startup otherwise fetches models.dev and hard-fails without it —
            # in the sandbox that is every run, as a timeout that reads like a
            # broken model.
            "OPENCODE_DISABLE_MODELS_FETCH": "1",
            "OPENCODE_DISABLE_AUTOUPDATE": "1",
            # Default plugins are installed from npm at startup; the sandbox
            # has no route to a registry, so loading them must not be tried.
            "OPENCODE_DISABLE_DEFAULT_PLUGINS": "1",
        }
    )
    os.execvp("opencode", ["opencode", *sys.argv[1:]])


if __name__ == "__main__":
    main()
