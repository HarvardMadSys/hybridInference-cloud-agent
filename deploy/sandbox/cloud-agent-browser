def probe_user_namespaces() -> bool:
    """Whether this guest lets an unprivileged process use a user namespace.

    Creating one is not enough: under Ubuntu's AppArmor restriction
    (``kernel.apparmor_restrict_unprivileged_userns``) ``unshare --user``
    succeeds, but the namespace has no capabilities, and Chromium's sandbox
    then aborts with "No usable sandbox". Mapping a user into it is what that
    restriction refuses, so that is what is probed. A launch that still fails
    sandboxed falls back too (:meth:`Daemon._ensure_browser`).
    """
    try:
        result = subprocess.run(
            ["unshare", "--user", "--map-root-user", "true"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def chromium_argv(profile: str, *, sandboxed: bool) -> list[str]:
    argv = [CHROMIUM, *CHROMIUM_FLAGS, f"--user-data-dir={profile}"]
    if not sandboxed:
        argv.append("--no-sandbox")
    argv.append("about:blank")
    return argv


def chromium_env(profile: str, environ: dict[str, str] | None = None) -> dict[str, str]:
    """The service's environment, with a home Chromium can write.

    Chromium's crash handler refuses to start without a writable home, and a
    uid with no passwd entry gets ``/``. The profile's parent is the service's.
    """
    env = dict(os.environ if environ is None else environ)
    home = env.get("HOME", "")
    if not home or not os.access(home, os.W_OK):
        env["HOME"] = os.path.dirname(os.path.normpath(profile))
    return env


def _child_setup(read_fd: int, write_fd: int) -> None:
    """In the forked child: CDP pipe on fds 3/4, die with the daemon.

    The launch uses ``close_fds=False``: every descriptor Python opened is
    close-on-exec already (PEP 446), so only these two and stdio survive the
    exec. Both ends are first moved above 9, so placing one cannot overwrite
    the other when either already sits on 3 or 4.
    """
    with contextlib.suppress(Exception):
        ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGKILL)
    high_read = fcntl.fcntl(read_fd, fcntl.F_DUPFD_CLOEXEC, 10)
    high_write = fcntl.fcntl(write_fd, fcntl.F_DUPFD_CLOEXEC, 10)
    os.dup2(high_read, 3)
    os.dup2(high_write, 4)


class Channel:
    """One client's outbound frames, written by a task of its own.

    The browser's pipe is read by one loop for every client, so that loop must
    never wait for any client's socket: a client that stops reading an 8 MiB
    screenshot would otherwise hold every other client's replies until it
    reads again. Frames queue here instead; a client whose queue passes
    ``MAX_CLIENT_BACKLOG`` is disconnected.
    """

    def __init__(self, socket: WebSocket) -> None:
        self.socket = socket
        self.frames: collections.deque[bytes] = collections.deque()
        self.pending = 0
        self.closing = False
        self.wake = asyncio.Event()
        self.task = asyncio.get_running_loop().create_task(self._run())

    def send(self, frame: bytes) -> bool:
        """Queue one frame; False when the client is too far behind to keep."""
        if self.closing:
            return True
        self.frames.append(frame)
        self.pending += len(frame)
        self.wake.set()
        return self.pending <= MAX_CLIENT_BACKLOG

    def close_after_flush(self) -> None:
        self.closing = True
        self.wake.set()

    def abort(self) -> None:
        """Drop the connection now, unsent frames and all."""
        self.closing = True
        self.frames.clear()
        self.pending = 0
        self.task.cancel()
        self.socket.closed = True
        with contextlib.suppress(Exception):
            self.socket.writer.transport.abort()

    async def _run(self) -> None:
        writer = self.socket.writer
        try:
            while True:
                await self.wake.wait()
                self.wake.clear()
                while self.frames:
                    frame = self.frames.popleft()
                    self.pending -= len(frame)
                    writer.write(frame)
                    await writer.drain()
                if self.closing:
                    break
            await self.socket.close()
        except (ConnectionError, RuntimeError):
            self.socket.closed = True


@dataclass
class DownloadRoute:
    """A client's download directory, which Chromium writes to through ``staging``."""

    target: str
    staging: str
    named_by_guid: bool


@dataclass(eq=False)
class Peer:
    """What the daemon knows of one connected client beyond its CDP sessions."""

    channel: Channel
    #: The UID that owns the client's socket, from the kernel's socket table.
    uid: int | None
    routes: list[DownloadRoute] = field(default_factory=list)
    #: Each download's suggested file name, by guid.
    names: dict[str, str] = field(default_factory=dict)
    #: Each hand-off's outcome, "completed" or "canceled", by guid. A client
    #: with several sessions hears of one download once per session, and every
    #: copy of the event must wait for, and report, the one hand-off.
    handoffs: dict[str, asyncio.Future[str]] = field(default_factory=dict)


def tcp_peer_uid(server_port: int, client_port: int) -> int | None:
    """The UID that owns the loopback socket at ``client_port`` connected to us.

    Members share the container's loopback; the kernel's socket table is what
    says which user's process opened a connection.
    """
    local = f"0100007F:{client_port:04X}"
    remote = f"0100007F:{server_port:04X}"
    try:
        with open("/proc/net/tcp", encoding="ascii") as handle:
            lines = handle.read().splitlines()[1:]
    except OSError:
        return None
    for line in lines:
        fields = line.split()
        if len(fields) > 7 and fields[1] == local and fields[2] == remote:
            with contextlib.suppress(ValueError):
                return int(fields[7])
    return None


def browser_can_write(path: str) -> bool:
    """Whether Chromium, as this service's user, can create a file in ``path``."""
    probe = path if os.path.isdir(path) else os.path.dirname(os.path.normpath(path))
    return os.path.isdir(probe) and os.access(probe, os.W_OK | os.X_OK)


class Courier:
    """The service's end of one UID's courier connection (:func:`run_courier`)."""

    def __init__(self, uid: int, reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
        self.uid = uid
        self.reader = reader
        self.writer = writer
        self.next_id = 1
        self.pending: dict[int, asyncio.Future[dict[str, Any]]] = {}

    async def copy(self, src: str, dst: str) -> tuple[bool, str]:
        request_id = self.next_id
        self.next_id += 1
        future: asyncio.Future[dict[str, Any]] = asyncio.get_running_loop().create_future()
        self.pending[request_id] = future
        try:
            self.writer.write(
                json.dumps({"id": request_id, "src": src, "dst": dst}).encode() + b"\n"
            )
            await self.writer.drain()
            reply = await asyncio.wait_for(future, HANDOFF_TIMEOUT_S)
        except (ConnectionError, TimeoutError) as exc:
            return False, f"the courier did not answer: {exc or 'timed out'}"
        finally:
            self.pending.pop(request_id, None)
        return bool(reply.get("ok")), str(reply.get("error") or "")

    async def run(self) -> None:
        try:
            while True:
                line = await self.reader.readline()
                if not line:
                    break
                with contextlib.suppress(ValueError):
                    reply = json.loads(line)
                    future = self.pending.get(reply.get("id")) if isinstance(reply, dict) else None
                    if future is not None and not future.done():
                        future.set_result(reply)
        except (ConnectionError, asyncio.LimitOverrunError, ValueError):
            pass
        finally:
            for future in self.pending.values():
                if not future.done():
                    future.set_exception(ConnectionError("the courier left"))


class Daemon:
    """The service: a loopback CDP endpoint, and Chromium behind it on demand."""

    def __init__(self, paths: Paths, *, idle_s: float, ready_fd: int | None) -> None:
        self.paths = paths
        self.idle_s = idle_s
        self.ready_fd = ready_fd
        self.token = secrets.token_urlsafe(32)
        self.port = 0
        self.started_at = int(time.time())
        self.stopping: asyncio.Event | None = None
        self.last_active = time.monotonic()
        self.last_error = ""
        self.sandboxed: bool | None = None
        # The current Chromium run, if any. A run's pipe, multiplexer and
        # clients die with it; the next client starts a new one.
        self.chromium: subprocess.Popen[bytes] | None = None
        self.browser_writer: asyncio.StreamWriter | None = None
        self.pump: asyncio.Task[None] | None = None
        self.version: dict[str, Any] = {}
        self.peers: dict[Client, Peer] = {}
        #: One courier per UID, the latest to register.
        self.couriers: dict[int, Courier] = {}
        self.courier_joined: asyncio.Event | None = None
        self.mux = self._new_mux(None)
        self._launch_lock: asyncio.Lock | None = None
        self._version_id: int | None = None
        self._version_ready: asyncio.Future[dict[str, Any]] | None = None
        self._staging_count = 0

    # -- urls -------------------------------------------------------------

    @property
    def ws_url(self) -> str:
        return f"ws://127.0.0.1:{self.port}/{self.token}/devtools/browser"

    @property
    def browser_running(self) -> bool:
        return (
            self.chromium is not None
            and self.chromium.poll() is None
            and self.browser_writer is not None
        )

    # -- browser side -----------------------------------------------------

    def _new_mux(self, writer: asyncio.StreamWriter | None) -> Multiplexer:
        # Bound to one run's pipe: a client of an earlier run that leaves
        # late must not send its detach into the next run's browser.
        def to_browser(message: dict[str, Any]) -> None:
            if writer is not None and not writer.is_closing():
                writer.write(json.dumps(message).encode() + b"\0")

        return Multiplexer(
            to_browser,
            self._to_client,
            self._on_internal,
            rewrite=self._rewrite,
            on_event=self._on_event,
        )

    def _to_client(self, client: Client, message: dict[str, Any]) -> None:
        peer = self.peers.get(client)
        if peer is None:
            return
        if not peer.channel.send(encode_frame(OP_TEXT, json.dumps(message).encode())):
            print(
                f"cloud-agent-browser: {client.name} fell {peer.channel.pending} bytes "
                "behind; disconnecting it",
                file=sys.stderr,
                flush=True,
            )
            peer.channel.abort()
            return
        if client.hang_up:
            peer.channel.close_after_flush()

    def _on_internal(self, message: dict[str, Any]) -> None:
        ready = self._version_ready
        if message.get("id") == self._version_id and ready is not None and not ready.done():
            ready.set_result(message)

    # -- downloads across users ---------------------------------------------
    #
    # A client names a directory of its own for downloads; Playwright makes
    # one 0700 in its own temporary directory. Chromium runs as the service's
    # user and cannot write there, so the download is sent to a staging
    # directory of the service's instead, and when it finishes, the client's
    # UID's courier copies it to where the client looks for it, before the
    # client hears that it finished.

    def _rewrite(self, client: Client, message: dict[str, Any]) -> dict[str, Any]:
        if message.get("method") not in DOWNLOAD_COMMANDS:
            return message
        params = message.get("params") if isinstance(message.get("params"), dict) else {}
        behavior, target = params.get("behavior"), params.get("downloadPath")
        peer = self.peers.get(client)
        if (
            peer is None
            or behavior not in ("allow", "allowAndName")
            or not isinstance(target, str)
            or not os.path.isabs(target)
            or browser_can_write(target)
        ):
            return message
        self._staging_count += 1
        staging = os.path.join(self.paths.downloads, f"{client.name}-{self._staging_count}")
        os.makedirs(staging, mode=0o750, exist_ok=True)
        os.chmod(staging, 0o750)
        peer.routes.append(DownloadRoute(target, staging, behavior == "allowAndName"))
        return {**message, "params": {**params, "downloadPath": staging}}

    def _on_event(self, client: Client, message: dict[str, Any]) -> bool:
        method = message.get("method")
        peer = self.peers.get(client)
        if peer is None or not peer.routes or not isinstance(method, str):
            return True
        params = message.get("params") if isinstance(message.get("params"), dict) else {}
        guid = params.get("guid")
        if method.endswith(".downloadWillBegin") and isinstance(guid, str):
            peer.names[guid] = str(params.get("suggestedFilename") or "")
            return True
        if not method.endswith(".downloadProgress") or not isinstance(guid, str):
            return True
        state = params.get("state")
        if state not in ("completed", "canceled"):
            return True
        if guid in peer.handoffs:
            asyncio.get_running_loop().create_task(
                self._deliver_after(client, peer, peer.handoffs[guid], message)
            )
            return False
        staged = self._staged(peer, guid)
        if staged is None:
            return True
        if state == "canceled":
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(staged[0].staging, staged[1]))
            return True
        outcome: asyncio.Future[str] = asyncio.get_running_loop().create_future()
        peer.handoffs[guid] = outcome
        asyncio.get_running_loop().create_task(
            self._hand_off(client, peer, staged, outcome, message)
        )
        return False

    @staticmethod
    def _staged(peer: Peer, guid: str) -> tuple[DownloadRoute, str] | None:
        for route in reversed(peer.routes):
            name = guid if route.named_by_guid else peer.names.get(guid, "")
            if name and os.path.isfile(os.path.join(route.staging, name)):
                return route, name
        return None

    async def _hand_off(
        self,
        client: Client,
        peer: Peer,
        staged: tuple[DownloadRoute, str],
        outcome: asyncio.Future[str],
        message: dict[str, Any],
    ) -> None:
        route, name = staged
        source = os.path.join(route.staging, name)
        ok, why = False, f"no courier for uid {peer.uid}; run `cloud-agent-browser start` as it"
        courier = await self._courier_for(peer.uid)
        if courier is not None:
            ok, why = await courier.copy(source, os.path.join(route.target, name))
        with contextlib.suppress(OSError):
            os.unlink(source)
        if not ok:
            print(
                f"cloud-agent-browser: download for {client.name} not delivered: {why}",
                file=sys.stderr,
                flush=True,
            )
        outcome.set_result("completed" if ok else "canceled")
        await self._deliver_after(client, peer, outcome, message)

    async def _deliver_after(
        self, client: Client, peer: Peer, outcome: asyncio.Future[str], message: dict[str, Any]
    ) -> None:
        state = await asyncio.shield(outcome)
        params = message.get("params") or {}
        if self.peers.get(client) is peer:
            self._to_client(client, {**message, "params": {**params, "state": state}})

    async def _courier_for(self, uid: int | None) -> Courier | None:
        if uid is None or self.courier_joined is None:
            return None
        deadline = time.monotonic() + COURIER_WAIT_S
        while uid not in self.couriers and time.monotonic() < deadline:
            self.courier_joined.clear()
            with contextlib.suppress(TimeoutError):
                await asyncio.wait_for(self.courier_joined.wait(), deadline - time.monotonic())
        return self.couriers.get(uid)

    async def _accept_courier(
        self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter
    ) -> None:
        sock = writer.get_extra_info("socket")
        try:
            credentials = sock.getsockopt(
                socketlib.SOL_SOCKET, socketlib.SO_PEERCRED, struct.calcsize("3i")
            )
            _pid, uid, _gid = struct.unpack("3i", credentials)
        except (OSError, AttributeError, struct.error):
            writer.close()
            return
        courier = Courier(uid, reader, writer)
        self.couriers[uid] = courier
        assert self.courier_joined is not None
        self.courier_joined.set()
        try:
            await courier.run()
        finally:
            if self.couriers.get(uid) is courier:
                del self.couriers[uid]
            writer.close()

    def _forget_downloads(self, peer: Peer) -> None:
        for route in peer.routes:
            shutil.rmtree(route.staging, ignore_errors=True)
        peer.routes.clear()

    # -- Chromium -----------------------------------------------------------

    async def _start_chromium(self, loop: asyncio.AbstractEventLoop) -> asyncio.StreamReader:
        if self.sandboxed is None:
            self.sandboxed = probe_user_namespaces()
        if not self.sandboxed and not ALLOW_UNSANDBOXED:
            raise BrowserError("Chromium's sandbox needs user namespaces, which this guest refuses")
        ensure_private_dir(self.paths.profile)
        to_chrome_r, to_chrome_w = os.pipe()
        from_chrome_r, from_chrome_w = os.pipe()
        log = os.open(self.paths.log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o640)
        try:
            self.chromium = subprocess.Popen(  # fixed binary, fixed flags
                chromium_argv(self.paths.profile, sandboxed=self.sandboxed),
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=log,
                env=chromium_env(self.paths.profile),
                preexec_fn=lambda: _child_setup(to_chrome_r, from_chrome_w),
                close_fds=False,
            )
        except OSError as exc:
            os.close(to_chrome_w)
            os.close(from_chrome_r)
            raise BrowserError(f"cannot start {CHROMIUM}: {exc}") from exc
        finally:
            os.close(log)
            os.close(to_chrome_r)
            os.close(from_chrome_w)
        reader = asyncio.StreamReader(limit=MAX_MESSAGE_BYTES)
        await loop.connect_read_pipe(
            lambda: asyncio.StreamReaderProtocol(reader), os.fdopen(from_chrome_r, "rb", 0)
        )
        transport, protocol = await loop.connect_write_pipe(
            asyncio.streams.FlowControlMixin, os.fdopen(to_chrome_w, "wb", 0)
        )
        self.browser_writer = asyncio.StreamWriter(transport, protocol, None, loop)
        return reader

    async def _pump_browser(self, reader: asyncio.StreamReader, mux: Multiplexer) -> None:
        # Never waits on a client: each one's frames are written by its own
        # Channel. Reading on is what keeps every other client's replies moving.
        try:
            while True:
                raw = await reader.readuntil(b"\0")
                try:
                    message = json.loads(raw[:-1])
                except ValueError:
                    continue
                if isinstance(message, dict):
                    mux.from_browser(message)
        except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
            pass
        finally:
            if asyncio.current_task() is self.pump:
                # Only an exit nobody asked for ends the pump on its own: a
                # stop or an idle stop cancels it first.
                self.pump = None
                process = self.chromium
                self._close_browser("chromium exited")
                status = None if process is None else process.poll()
                append_incident(
                    self.paths.incidents,
                    "browser_crashed",
                    exit_code=status if status is not None and status >= 0 else None,
                    signal=-status if status is not None and status < 0 else None,
                )

    async def _launch(self) -> None:
        loop = asyncio.get_running_loop()
        reader = await self._start_chromium(loop)
        self.mux = self._new_mux(self.browser_writer)
        self.pump = loop.create_task(self._pump_browser(reader, self.mux))
        self._version_ready = loop.create_future()
        self._version_id = self.mux.internal("Browser.getVersion")
        done, _ = await asyncio.wait(
            {self._version_ready, self.pump},
            timeout=READY_TIMEOUT_S,
            return_when=asyncio.FIRST_COMPLETED,
        )
        if self._version_ready not in done or "result" not in self._version_ready.result():
            raise BrowserError("Chromium did not answer; see " + self.paths.log)

    async def _ensure_browser(self) -> bool:
        """Start Chromium unless it runs; False (and the reason logged) if it cannot."""
        assert self._launch_lock is not None
        async with self._launch_lock:
            if self.browser_running:
                return True
            self._close_browser(None)
            try:
                try:
                    await self._launch()
                except BrowserError:
                    if not (self.sandboxed and ALLOW_UNSANDBOXED):
                        raise
                    # The probe can pass where the sandbox still cannot work:
                    # Chromium aborts with "No usable sandbox" under some
                    # namespace policies. Fall back once, for this service.
                    self._close_browser(None)
                    self.sandboxed = False
                    print(
                        "cloud-agent-browser: Chromium could not start sandboxed (see the "
                        "log above); starting it with --no-sandbox",
                        file=sys.stderr,
                        flush=True,
                    )
                    await self._launch()
            except BrowserError as exc:
                print(f"cloud-agent-browser: {exc}", file=sys.stderr, flush=True)
                self._close_browser(None)
                self.last_error = str(exc)
                self._publish()
                return False
            assert self._version_ready is not None
            result = self._version_ready.result()["result"]
            self.version = {
                "Browser": result.get("product", ""),
                "Protocol-Version": result.get("protocolVersion", ""),
                "User-Agent": result.get("userAgent", ""),
                "V8-Version": result.get("jsVersion", ""),
            }
            self.last_error = ""
            self.last_active = time.monotonic()
            print(
                f"cloud-agent-browser: chromium started: {self.version['Browser']}"
                f"{'' if self.sandboxed else ' (--no-sandbox)'}",
                file=sys.stderr,
                flush=True,
            )
            self._publish()
            return True

    def _close_browser(self, reason: str | None) -> None:
        """End the current Chromium run, and every client connected to it."""
        if reason is not None and self.chromium is not None:
            print(f"cloud-agent-browser: chromium stopped: {reason}", file=sys.stderr, flush=True)
        pump, self.pump = self.pump, None
        if pump is not None and pump is not asyncio.current_task():
            pump.cancel()
        for peer in self.peers.values():
            peer.channel.close_after_flush()
            self._forget_downloads(peer)
        self.peers = {}
        if self.browser_writer is not None:
            self.browser_writer.close()
            self.browser_writer = None
        self.mux = self._new_mux(None)
        if self._version_ready is not None and not self._version_ready.done():
            self._version_ready.set_result({})
        self._stop_chromium()
        self.chromium = None
        self.version = {}
        if reason is not None:
            self._publish()

    # -- client side ------------------------------------------------------

    async def _handle(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
        try:
            head = await reader.readuntil(b"\r\n\r\n")
        except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
            writer.close()
            return
        request = parse_request(head)
        route = self._route(request)
        if route == "stop":
            was_running = self.browser_running
            self._close_browser("stopped by a member")
            await self._respond(writer, b"200 OK", json.dumps({"stopped": was_running}).encode())
            return
        if route != "socket" or len(self.peers) >= MAX_CLIENTS:
            await self._respond(
                writer, b"404 Not Found" if route != "socket" else b"503 Service Unavailable"
            )
            return
        if not await self._ensure_browser():
            await self._respond(writer, b"503 Service Unavailable", self.last_error.encode())
            return
        key = request["headers"].get("sec-websocket-key", "")
        writer.write(
            b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            + f"Sec-WebSocket-Accept: {websocket_accept(key)}\r\n\r\n".encode()
        )
        await writer.drain()
        await self._serve_client(WebSocket(reader, writer), self._peer_uid(writer))

    def _peer_uid(self, writer: asyncio.StreamWriter) -> int | None:
        peer = writer.get_extra_info("peername")
        if not isinstance(peer, tuple) or len(peer) < 2:
            return None
        return tcp_peer_uid(self.port, int(peer[1]))

    async def _respond(
        self, writer: asyncio.StreamWriter, status: bytes, body: bytes = b""
    ) -> None:
        writer.write(
            b"HTTP/1.1 "
            + status
            + f"\r\nContent-Length: {len(body)}\r\nConnection: close\r\n\r\n".encode()
            + body
        )
        with contextlib.suppress(ConnectionError):
            await writer.drain()
        writer.close()

    def _route(self, request: dict[str, Any] | None) -> str:
        if request is None or request["method"] != "GET":
            return "none"
        path = request["path"].split("?", 1)[0]
        parts = path.strip("/").split("/")
        if not parts or not hmac.compare_digest(parts[0].encode(), self.token.encode()):
            return "none"
        host = request["headers"].get("host", "")
        if host not in (f"127.0.0.1:{self.port}", f"localhost:{self.port}"):
            return "none"
        rest = parts[1:]
        headers = request["headers"]
        if rest == ["stop"]:
            return "stop"
        if (
            rest == ["devtools", "browser"]
            and headers.get("upgrade", "").lower() == "websocket"
            and "upgrade" in headers.get("connection", "").lower()
            and headers.get("sec-websocket-version") == "13"
            and headers.get("sec-websocket-key")
        ):
            return "socket"
        return "none"

    async def _serve_client(self, socket: WebSocket, uid: int | None) -> None:
        client = Client(name=f"client-{secrets.token_hex(4)}")
        # The run this client joined: it leaves that one, even after a restart.
        mux, browser_writer = self.mux, self.browser_writer
        peer = Peer(Channel(socket), uid)
        self.peers[client] = peer
        mux.connect(client)
        self.last_active = time.monotonic()
        try:
            while not client.hang_up and not peer.channel.closing:
                raw = await socket.receive()
                if raw is None:
                    break
                try:
                    message = json.loads(raw)
                except ValueError:
                    break
                if not isinstance(message, dict):
                    break
                mux.from_client(client, message)
                # Backpressure toward the browser is shared and fair: every
                # client waits for the one pipe. Never for another client.
                if browser_writer is not None and not browser_writer.is_closing():
                    with contextlib.suppress(ConnectionError):
                        await browser_writer.drain()
        except (FrameError, asyncio.IncompleteReadError, ConnectionError, OSError):
            pass
        finally:
            mux.disconnect(client)
            if self.peers.get(client) is peer:
                del self.peers[client]
            self._forget_downloads(peer)
            if client.hang_up and not peer.channel.task.done():
                # Let the reply to Browser.close reach the client first.
                peer.channel.close_after_flush()
                with contextlib.suppress(Exception):
                    await asyncio.wait_for(asyncio.shield(peer.channel.task), 5)
            peer.channel.abort()
            self.last_active = time.monotonic()

    # -- lifecycle --------------------------------------------------------

    def _stop(self, reason: str) -> None:
        if self.stopping is not None and not self.stopping.is_set():
            print(f"cloud-agent-browser: service stopping: {reason}", file=sys.stderr, flush=True)
            self.stopping.set()

    async def _watch_idle(self) -> None:
        while True:
            await asyncio.sleep(min(30.0, max(1.0, self.idle_s / 4)))
            if (
                self.chromium is not None
                and not self.peers
                and time.monotonic() - self.last_active > self.idle_s
            ):
                self._close_browser("idle")

    def _report_ready(self, line: str) -> None:
        if self.ready_fd is None:
            return
        with contextlib.suppress(OSError):
            os.write(self.ready_fd, line.encode())
            os.close(self.ready_fd)
        self.ready_fd = None

    async def run(self) -> int:
        loop = asyncio.get_running_loop()
        self.stopping = asyncio.Event()
        self.courier_joined = asyncio.Event()
        self._launch_lock = asyncio.Lock()
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            loop.add_signal_handler(signum, self._stop, signal.Signals(signum).name)
        server = None
        couriers = None
        idle = None
        try:
            shutil.rmtree(self.paths.downloads, ignore_errors=True)
            os.makedirs(self.paths.downloads, mode=0o750, exist_ok=True)
            with contextlib.suppress(FileNotFoundError):
                os.unlink(self.paths.courier_socket)
            # Group members connect to hand downloads over; the kernel says who.
            # Without it the browser still serves; only cross-user downloads stop.
            try:
                couriers = await asyncio.start_unix_server(
                    self._accept_courier, self.paths.courier_socket
                )
                os.chmod(self.paths.courier_socket, 0o660)
            except OSError as exc:
                print(
                    f"cloud-agent-browser: no download hand-off ({self.paths.courier_socket}): {exc}",
                    file=sys.stderr,
                    flush=True,
                )
            server = await asyncio.start_server(
                self._handle, "127.0.0.1", 0, limit=MAX_REQUEST_HEAD
            )
            self.port = server.sockets[0].getsockname()[1]
            self._publish()
            write_shared(self.paths.endpoint, self.ws_url + "\n")
            idle = loop.create_task(self._watch_idle())
            self._report_ready(f"ok {self.ws_url}\n")
            await self.stopping.wait()
            return 0
        except (BrowserError, OSError) as exc:
            self._report_ready(f"error {exc}\n")
            print(f"cloud-agent-browser: {exc}", file=sys.stderr, flush=True)
            return 1
        finally:
            self._unpublish()
            if server is not None:
                server.close()
            # Couriers end with the service they serve.
            for courier in list(self.couriers.values()):
                courier.writer.close()
            if couriers is not None:
                couriers.close()
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(self.paths.courier_socket)
            if idle is not None:
                idle.cancel()
            channels = [peer.channel for peer in self.peers.values()]
            self._close_browser(None)
            for channel in channels:
                with contextlib.suppress(Exception):
                    await asyncio.wait_for(channel.task, 5)

    def _publish(self) -> None:
        running = self.browser_running
        record = {
            "contract": CONTRACT_VERSION,
            "pid": os.getpid(),
            "endpoint": self.ws_url,
            "profile": self.paths.profile,
            "running": running,
            "chromium_pid": self.chromium.pid if running and self.chromium else None,
            "browser": self.version.get("Browser", "") if running else "",
            "chromium_sandbox": self.sandboxed,
            "last_error": self.last_error,
            "started_at": self.started_at,
        }
        write_shared(self.paths.record, json.dumps(record))

    def _unpublish(self) -> None:
        record = read_record(self.paths)
        if record is not None and record.get("pid") == os.getpid():
            for path in (self.paths.endpoint, self.paths.record):
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(path)

    def _stop_chromium(self) -> None:
        process = self.chromium
        if process is None or process.poll() is not None:
            return
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def parse_request(head: bytes) -> dict[str, Any] | None:
    try:
        text = head.decode("latin-1")
        line, *rest = text.split("\r\n")
        method, path, version = line.split(" ")
    except ValueError:
        return None
    if not version.startswith("HTTP/1."):
        return None
    headers: dict[str, str] = {}
    for header in rest:
        if ":" in header:
            name, value = header.split(":", 1)
            headers[name.strip().lower()] = value.strip()
    return {"method": method, "path": path, "headers": headers}


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------


def read_record(paths: Paths) -> dict[str, Any] | None:
    owner = service_owner(paths)
    if owner is None:
        return None
    text = read_trusted(paths.record, owner)
    try:
        record = json.loads(text) if text is not None else None
    except ValueError:
        return None
    return record if isinstance(record, dict) else None


def _is_service(pid: Any, owner: int) -> bool:
    if not isinstance(pid, int) or pid <= 1:
        return False
    try:
        if os.stat(f"/proc/{pid}").st_uid != owner:
            return False
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            argv = handle.read().split(b"\0")
    except OSError:
        return False
    return b"_serve" in argv and any(arg.endswith(b"cloud-agent-browser") for arg in argv)


def running_record(paths: Paths) -> dict[str, Any] | None:
    """The live service's record, or None when no service runs."""
    owner = service_owner(paths)
    record = read_record(paths)
    if owner is None or record is None or not _is_service(record.get("pid"), owner):
        return None
    if not isinstance(record.get("endpoint"), str):
        return None
    return record


def _stop_service(record: dict[str, Any], timeout_s: float = 10.0) -> None:
    pid, owner = record["pid"], os.getuid()
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline and _is_service(pid, owner):
        time.sleep(0.1)
    if _is_service(pid, owner):
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGKILL)


# -- the service user's commands -----------------------------------------------


def service_start(paths: Paths, *, idle_s: float) -> dict[str, Any]:
    """Start the service unless it runs. Idempotent; the platform runs it per start."""
    ensure_service_dir(paths.state)
    lock = os.open(paths.lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        record = running_record(paths)
        if record is not None:
            return record
        return _spawn(paths, idle_s=idle_s)
    finally:
        os.close(lock)


def service_stop(paths: Paths) -> bool:
    record = running_record(paths)
    if record is None:
        return False
    if service_owner(paths) != os.getuid():
        raise BrowserError("only the service user stops the service; a member runs `stop`")
    _stop_service(record)
    return True


def _spawn(paths: Paths, *, idle_s: float) -> dict[str, Any]:
    ready_r, ready_w = os.pipe()
    log = os.open(paths.log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o640)
    try:
        subprocess.Popen(  # this script, re-executed isolated
            [
                sys.executable,
                "-I",
                os.path.abspath(__file__),
                "_serve",
                str(ready_w),
                str(idle_s),
            ],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            pass_fds=(ready_w,),
            start_new_session=True,
            close_fds=True,
        )
    finally:
        os.close(log)
        os.close(ready_w)
    with os.fdopen(ready_r, "rb") as ready:
        line = ready.readline().decode(errors="replace").strip()
    if not line.startswith("ok "):
        detail = line.removeprefix("error ") or f"the service exited; see {paths.log}"
        raise BrowserError(detail)
    record = running_record(paths)
    if record is None:
        raise BrowserError("the service started but left no record")
    return record


# -- a member's commands -------------------------------------------------------


def _require_service(paths: Paths) -> dict[str, Any]:
    record = running_record(paths)
    if record is None:
        raise BrowserError(
            "this sandbox's browser service is not running; the platform starts it "
            "with the sandbox, so a new turn brings it back"
        )
    return record


def start(paths: Paths) -> dict[str, Any]:
    """Make sure Chromium runs, and return the service's status.

    Also makes sure this UID has a courier, which puts the browser's downloads
    where this UID's tools ask for them (:func:`run_courier`).
    """
    ensure_artifacts(paths.artifacts)
    record = _require_service(paths)
    ensure_courier(paths)
    asyncio.run(_wake(record["endpoint"]))
    return status(paths)


# -- the courier: downloads, handed from the service's user to a member's ------
#
# Chromium writes a download as the service's user, which cannot write into a
# client's own private directory (Playwright's is 0700 in the client's
# temporary directory). The service stages it in its own directory, readable
# by the sandbox group, and asks the client's UID's courier, a process of
# that UID, to copy it to the file the client will read. The courier trusts
# the service only so far: it copies a regular file the service user owns
# from the service's staging directory, into a directory this UID owns,
# under a name no file has yet. A compromised browser can make it add a new
# file to one of this UID's directories, and nothing else.


def _courier_lock(environ: dict[str, str] | None = None) -> str:
    env = os.environ if environ is None else environ
    home = env.get("HOME") or os.path.expanduser("~")
    directory = os.path.join(home, ".cloud-agent-browser")
    ensure_private_dir(directory)
    return os.path.join(directory, "courier.lock")


def ensure_courier(paths: Paths) -> None:
    """Start this UID's courier unless one runs. The service's own user needs none."""
    owner = service_owner(paths)
    if owner is None or owner == os.getuid():
        return
    lock_path = _courier_lock()
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return  # a courier holds it
        fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)
    subprocess.Popen(  # this script, re-executed isolated
        [sys.executable, "-I", os.path.abspath(__file__), "_courier"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )


def deliver(paths: Paths, owner: int, src: str, dst: str) -> None:
    """Copy one staged download to ``dst``, or raise ``BrowserError`` saying why not."""
    staging_root = os.path.realpath(paths.downloads) + os.sep
    if not os.path.realpath(src).startswith(staging_root):
        raise BrowserError("not a staged download")
    directory, name = os.path.split(dst)
    if not name or name in (".", "..") or not os.path.isabs(directory):
        raise BrowserError("not a file name")
    source = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        info = os.fstat(source)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner:
            raise BrowserError("the staged download is not the service's file")
        folder = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            folder_info = os.fstat(folder)
            if folder_info.st_uid != os.getuid():
                raise BrowserError("the target directory is not this user's")
            try:
                target = os.open(
                    name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o666, dir_fd=folder
                )
            except FileExistsError as exc:
                raise BrowserError("the target file already exists") from exc
        finally:
            os.close(folder)
        with os.fdopen(source, "rb", closefd=False) as reading, os.fdopen(target, "wb") as writing:
            shutil.copyfileobj(reading, writing, 1 << 20)
    finally:
        os.close(source)


def run_courier(paths: Paths) -> int:
    """This UID's courier: one per UID, until the service it serves stops."""
    lock = os.open(_courier_lock(), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    owner = service_owner(paths)
    if owner is None:
        return 1
    try:
        info = os.lstat(paths.courier_socket)
    except OSError:
        return 1
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != owner:
        return 1
    with socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM) as connection:
        connection.connect(paths.courier_socket)
        reading = connection.makefile("rb")
        for line in reading:
            try:
                request = json.loads(line)
                deliver(paths, owner, str(request["src"]), str(request["dst"]))
                reply = {"id": request.get("id"), "ok": True}
            except (BrowserError, OSError, ValueError, KeyError, TypeError) as exc:
                reply = {"id": request.get("id") if isinstance(request, dict) else None}
                reply.update(ok=False, error=str(exc)[:300])
            connection.sendall(json.dumps(reply).encode() + b"\n")
    return 0


async def _wake(url: str) -> None:
    # Connecting is what starts Chromium; a refusal carries the reason.
    client = await CdpClient.connect(url)
    try:
        await client.call("Browser.getVersion")
    finally:
        await client.socket.close()


def status(paths: Paths) -> dict[str, Any]:
    record = running_record(paths) or {}
    return {
        "contract": CONTRACT_VERSION,
        "service": bool(record),
        "running": bool(record.get("running")),
        "endpoint": record.get("endpoint"),
        "browser": record.get("browser") or None,
        "chromium_sandbox": record.get("chromium_sandbox"),
        "last_error": record.get("last_error") or None,
        "pid": record.get("pid"),
        "profile": record.get("profile"),
        "artifacts_dir": paths.artifacts,
    }


def stop(paths: Paths) -> bool:
    """Close Chromium for every member. The service and the profile stay."""
    record = running_record(paths)
    if record is None:
        return False
    url = record["endpoint"].removeprefix("ws://")
    hostport, _, path = url.partition("/")
    host, _, port = hostport.partition(":")
    token = path.split("/", 1)[0]
    connection = http.client.HTTPConnection(host, int(port), timeout=15)
    try:
        connection.request("GET", f"/{token}/stop")
        response = connection.getresponse()
        body = response.read(4096)
    except OSError as exc:
        raise BrowserError(f"the service did not answer: {exc}") from exc
    finally:
        connection.close()
    if response.status != 200:
        raise BrowserError(f"the service refused to stop the browser ({response.status})")
    try:
        return bool(json.loads(body).get("stopped"))
    except (ValueError, AttributeError):
        return False


# -- self-test: a minimal CDP client ------------------------------------------


class CdpClient:
    def __init__(self, socket: WebSocket) -> None:
        self.socket = socket
        self.next_id = 0
        self.events: list[dict[str, Any]] = []

    @classmethod
    async def connect(cls, url: str) -> CdpClient:
        rest = url.removeprefix("ws://")
        hostport, _, path = rest.partition("/")
        host, _, port = hostport.partition(":")
        reader, writer = await asyncio.open_connection(host, int(port), limit=MAX_MESSAGE_BYTES)
        key = base64.b64encode(secrets.token_bytes(16)).decode()
        writer.write(
            (
                f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\nUpgrade: websocket\r\n"
                f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                "Sec-WebSocket-Version: 13\r\n\r\n"
            ).encode()
        )
        await writer.drain()
        head = await reader.readuntil(b"\r\n\r\n")
        if not head.startswith(b"HTTP/1.1 101") or websocket_accept(key).encode() not in head:
            detail = ""
            with contextlib.suppress(Exception):
                body = await asyncio.wait_for(reader.read(4096), timeout=5)
                detail = body.decode(errors="replace")
            writer.close()
            status_line = head.splitlines()[0].decode(errors="replace")
            raise BrowserError(
                f"the browser refused the connection ({status_line}) {detail}".strip()
            )
        return cls(WebSocket(reader, writer, is_client=True))

    async def call(self, method: str, params: dict | None = None, session: str | None = None):
        self.next_id += 1
        message: dict[str, Any] = {"id": self.next_id, "method": method, "params": params or {}}
        if session:
            message["sessionId"] = session
        await self.socket.send(json.dumps(message).encode())
        while True:
            raw = await asyncio.wait_for(self.socket.receive(), timeout=30)
            if raw is None:
                raise BrowserError("connection closed")
            reply = json.loads(raw)
            if reply.get("id") == self.next_id:
                if "error" in reply:
                    raise BrowserError(f"{method}: {reply['error']}")
                return reply.get("result", {})
            self.events.append(reply)

    async def wait_event(self, method: str, match, timeout: float = 60) -> dict[str, Any]:
        """The first event ``method`` whose params ``match`` accepts, seen or still to come."""
        deadline = time.monotonic() + timeout
        while True:
            for event in self.events:
                if event.get("method") == method and match(event.get("params") or {}):
                    self.events.remove(event)
                    return event.get("params") or {}
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise BrowserError(f"no {method} event")
            raw = await asyncio.wait_for(self.socket.receive(), timeout=remaining)
            if raw is None:
                raise BrowserError("connection closed")
            self.events.append(json.loads(raw))


_DOWNLOAD_BODY = "cloud-agent-browser self-test download\n"
_DOWNLOAD_SCRIPT = (
    "const a = document.createElement('a');"
    f"a.href = URL.createObjectURL(new Blob([{json.dumps(_DOWNLOAD_BODY)}]));"
    "a.download = 'self-test.txt'; document.body.appendChild(a); a.click(); true"
)


async def _download_check(client: CdpClient, session: str) -> None:
    """A download into a directory only the caller can write, as Playwright makes one.

    Run by a member, Chromium (the service's user) cannot write there, so this
    is the courier's hand-off end to end; run by the service's user, it is a
    plain download.
    """
    target = tempfile.mkdtemp(prefix="cloud-agent-browser-download-")
    try:
        await client.call(
            "Browser.setDownloadBehavior",
            {"behavior": "allowAndName", "downloadPath": target, "eventsEnabled": True},
        )
        await client.call(
            "Runtime.evaluate", {"expression": _DOWNLOAD_SCRIPT, "userGesture": True}, session
        )
        begun = await client.wait_event("Browser.downloadWillBegin", lambda params: True)
        guid = begun["guid"]
        done = await client.wait_event(
            "Browser.downloadProgress",
            lambda params: (
                params.get("guid") == guid and params.get("state") in ("completed", "canceled")
            ),
        )
        if done["state"] != "completed":
            raise BrowserError("the download was canceled; see the service log")
        path = os.path.join(target, guid)
        with open(path, encoding="utf-8") as handle:
            if handle.read() != _DOWNLOAD_BODY:
                raise BrowserError("the downloaded file is not what the page offered")
        if os.stat(path).st_uid != os.getuid():
            raise BrowserError("the downloaded file is not the caller's")
    finally:
        shutil.rmtree(target, ignore_errors=True)


async def _self_test(url: str) -> None:
    first = await CdpClient.connect(url)
    second = await CdpClient.connect(url)
    version = await first.call("Browser.getVersion")
    target = await first.call("Target.createTarget", {"url": "about:blank"})
    attached = await first.call(
        "Target.attachToTarget", {"targetId": target["targetId"], "flatten": True}
    )
    session = attached["sessionId"]
    await first.call(
        "Page.navigate",
        {"url": "data:text/html,<title>ok</title><p>cloud-agent-browser</p>"},
        session,
    )
    for _ in range(50):
        value = await first.call(
            "Runtime.evaluate", {"expression": "document.title", "returnByValue": True}, session
        )
        if value.get("result", {}).get("value") == "ok":
            break
        await asyncio.sleep(0.1)
    else:
        raise BrowserError("the page did not load")
    shot = await first.call("Page.captureScreenshot", {"format": "png"}, session)
    if not base64.b64decode(shot["data"]).startswith(b"\x89PNG"):
        raise BrowserError("the screenshot is not a PNG")
    await _download_check(first, session)
    # The second client sees the browser, but not the first client's session.
    try:
        await second.call("Runtime.evaluate", {"expression": "1"}, session)
    except BrowserError:
        pass
    else:
        raise BrowserError("a client reached another client's session")
    targets = await second.call("Target.getTargets")
    if not any(info["targetId"] == target["targetId"] for info in targets["targetInfos"]):
        raise BrowserError("the second client does not see the shared page")
    await first.call("Target.closeTarget", {"targetId": target["targetId"]})
    await first.call("Browser.close")
    await second.socket.close()
    print(f"self-test ok: {version.get('product', '')}")


# -- entry point --------------------------------------------------------------

USAGE = """usage: cloud-agent-browser <command>

  start [--json]         start the sandbox's browser if needed; print its CDP
                         WebSocket URL (--json: the full status instead)
  status                 print the browser's state as JSON
  stop                   close the browser for every member (the profile stays)
  self-test              start the browser and check it end to end

  service start|stop     the platform's: run or end the service, as its user
"""


def _idle_s() -> float:
    try:
        value = float(os.environ.get("CLOUD_AGENT_BROWSER_IDLE_S", DEFAULT_IDLE_S))
    except ValueError:
        return DEFAULT_IDLE_S
    return value if value > 0 else DEFAULT_IDLE_S


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else ""
    paths = resolve_paths()
    try:
        if command == "_serve":
            ready_fd = int(argv[2])
            # Chromium must not hold the starting command's pipe open: a
            # service that died before answering has to read as EOF there.
            os.set_inheritable(ready_fd, False)
            # Downloads land in the shared artifacts directory, where every
            # member reads and removes them; the profile is 0700 regardless.
            os.umask(0o007)
            daemon = Daemon(paths, idle_s=float(argv[3]), ready_fd=ready_fd)
            return asyncio.run(daemon.run())
        if command == "service" and argv[2:] == ["start"]:
            print(service_start(paths, idle_s=_idle_s())["endpoint"])
            return 0
        if command == "service" and argv[2:] == ["stop"]:
            print("stopped" if service_stop(paths) else "not running")
            return 0
        if command == "start" and argv[2:] in ([], ["--json"]):
            record = start(paths)
            if argv[2:] == ["--json"]:
                print(json.dumps(record, indent=2))
            else:
                print(record["endpoint"])
            return 0
        if command == "_courier":
            return run_courier(paths)
        if command == "status":
            print(json.dumps(status(paths), indent=2))
            return 0
        if command == "stop":
            print("stopped" if stop(paths) else "not running")
            return 0
        if command == "self-test":
            record = start(paths)
            asyncio.run(_self_test(record["endpoint"]))
            return 0
    except BrowserError as exc:
        print(f"cloud-agent-browser: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        if exc.errno == errno.ENOSPC:
            print("cloud-agent-browser: no space left on device", file=sys.stderr)
            return 1
        raise
    print(USAGE, file=sys.stderr, end="")
    return 64 if command not in ("-h", "--help", "help") else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
