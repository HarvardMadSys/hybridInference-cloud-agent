@dataclass(frozen=True)
class Paths:
    state: str
    profile: str
    artifacts: str

    @property
    def endpoint(self) -> str:
        return os.path.join(self.state, "endpoint")

    @property
    def record(self) -> str:
        return os.path.join(self.state, "daemon.json")

    @property
    def lock(self) -> str:
        return os.path.join(self.state, "daemon.lock")

    @property
    def log(self) -> str:
        return os.path.join(self.state, "daemon.log")


def resolve_paths(environ: dict[str, str] | None = None) -> Paths:
    """The service's directories: the image's, or overrides, or the home."""
    env = os.environ if environ is None else environ
    home = env.get("HOME") or os.path.expanduser("~")
    base = os.path.join(home, ".cloud-agent-browser")
    return Paths(
        state=env.get("CLOUD_AGENT_BROWSER_STATE_DIR") or os.path.join(base, "run"),
        profile=env.get("CLOUD_AGENT_BROWSER_PROFILE") or os.path.join(base, "profile"),
        artifacts=env.get("CLOUD_AGENT_ARTIFACTS_DIR")
        or os.path.join(WORKSPACE, ".cloud-agent-artifacts"),
    )


def _own_dir(path: str, mode: int) -> None:
    os.makedirs(path, mode=mode, exist_ok=True)
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise BrowserError(f"{path} is not a directory owned by this user")
    if stat.S_IMODE(info.st_mode) != mode:
        os.chmod(path, mode)


def ensure_private_dir(path: str) -> None:
    """Create ``path`` 0700, and refuse one this UID does not own."""
    _own_dir(path, 0o700)


def ensure_service_dir(path: str) -> None:
    """Create the state directory 0750: the service writes, the group reads."""
    _own_dir(path, 0o750)


def write_shared(path: str, data: str) -> None:
    """Replace ``path`` atomically with a 0640 file: the group reads it."""
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640)
    try:
        os.fchmod(fd, 0o640)
        os.write(fd, data.encode())
    finally:
        os.close(fd)
    os.replace(tmp, path)


def service_owner(paths: Paths) -> int | None:
    """The UID that runs the service, or None when its directory is unusable.

    The directory must be one no other user can write to: a member trusts
    the endpoint it reads there with every other member's browser traffic.
    """
    try:
        info = os.lstat(paths.state)
    except OSError:
        return None
    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
        return None
    return info.st_uid


def read_trusted(path: str, owner: int) -> str | None:
    """``path``'s text, if the service user wrote it and nobody else can."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner or info.st_mode & 0o022:
            return None
        with os.fdopen(fd, encoding="utf-8") as handle:
            fd = -1
            return handle.read(1 << 20)
    except (OSError, ValueError):
        return None
    finally:
        if fd >= 0:
            os.close(fd)


def ensure_artifacts(path: str) -> None:
    """Create the shared artifacts directory and keep it out of Git.

    Best effort: a workspace without Git, or one this member cannot write,
    leaves the browser usable and the directory to the tool.
    """
    old = os.umask(0o002)
    try:
        os.makedirs(path, exist_ok=True)
    except OSError:
        return
    finally:
        os.umask(old)
    with contextlib.suppress(OSError):
        if os.stat(path).st_uid == os.getuid():
            os.chmod(path, 0o2770)
    parent, name = os.path.split(os.path.normpath(path))
    git_dir = os.path.join(parent, ".git")
    if not os.path.isdir(git_dir):
        return
    entry = f"/{name}/"
    exclude = os.path.join(git_dir, "info", "exclude")
    with contextlib.suppress(OSError):
        os.makedirs(os.path.dirname(exclude), exist_ok=True)
        try:
            with open(exclude, encoding="utf-8") as handle:
                if entry in handle.read().splitlines():
                    return
        except FileNotFoundError:
            pass
        with open(exclude, "a", encoding="utf-8") as handle:
            handle.write(f"\n{entry}\n")


# --------------------------------------------------------------------------
# WebSocket framing (RFC 6455, the subset CDP clients use)
# --------------------------------------------------------------------------

OP_CONTINUATION, OP_TEXT, OP_BINARY, OP_CLOSE, OP_PING, OP_PONG = 0x0, 0x1, 0x2, 0x8, 0x9, 0xA


def websocket_accept(key: str) -> str:
    digest = hashlib.sha1(key.encode("ascii") + WEBSOCKET_GUID).digest()
    return base64.b64encode(digest).decode("ascii")


def encode_frame(opcode: int, payload: bytes, *, mask: bool = False) -> bytes:
    """One final frame. Servers send unmasked frames; clients must mask."""
    head = bytearray([0x80 | opcode])
    length = len(payload)
    mask_bit = 0x80 if mask else 0
    if length < 126:
        head.append(mask_bit | length)
    elif length < 1 << 16:
        head.append(mask_bit | 126)
        head += struct.pack("!H", length)
    else:
        head.append(mask_bit | 127)
        head += struct.pack("!Q", length)
    if not mask:
        return bytes(head) + payload
    key = secrets.token_bytes(4)
    return bytes(head) + key + _unmask(payload, key)


def _unmask(payload: bytes, key: bytes) -> bytes:
    if not payload:
        return payload
    repeated = (key * (len(payload) // 4 + 1))[: len(payload)]
    return (int.from_bytes(payload, "big") ^ int.from_bytes(repeated, "big")).to_bytes(
        len(payload), "big"
    )


class FrameError(Exception):
    """The peer broke the protocol; the connection is closed."""


async def read_frame(
    reader: asyncio.StreamReader, *, require_mask: bool
) -> tuple[bool, int, bytes]:
    """Return ``(fin, opcode, payload)`` of the next frame."""
    first, second = await reader.readexactly(2)
    if first & 0x70:
        raise FrameError("reserved bits set")
    fin, opcode = bool(first & 0x80), first & 0x0F
    masked, length = bool(second & 0x80), second & 0x7F
    if require_mask and not masked:
        raise FrameError("client frame is not masked")
    if length == 126:
        (length,) = struct.unpack("!H", await reader.readexactly(2))
    elif length == 127:
        (length,) = struct.unpack("!Q", await reader.readexactly(8))
    if length > MAX_MESSAGE_BYTES:
        raise FrameError("frame too large")
    if opcode >= OP_CLOSE and (length > 125 or not fin):
        raise FrameError("bad control frame")
    key = await reader.readexactly(4) if masked else b""
    payload = await reader.readexactly(length)
    return fin, opcode, _unmask(payload, key) if masked else payload


class WebSocket:
    """One framed connection: whole text messages in, whole messages out."""

    def __init__(
        self,
        reader: asyncio.StreamReader,
        writer: asyncio.StreamWriter,
        *,
        is_client: bool = False,
    ) -> None:
        self.reader = reader
        self.writer = writer
        self.is_client = is_client
        self.closed = False

    async def receive(self) -> bytes | None:
        """The next data message, or None once the peer closed."""
        parts: list[bytes] = []
        size = 0
        while True:
            fin, opcode, payload = await read_frame(self.reader, require_mask=not self.is_client)
            if opcode == OP_CLOSE:
                await self.close()
                return None
            if opcode == OP_PING:
                await self._send(OP_PONG, payload)
                continue
            if opcode == OP_PONG:
                continue
            if opcode not in (OP_CONTINUATION, OP_TEXT, OP_BINARY):
                raise FrameError("unknown opcode")
            if (opcode == OP_CONTINUATION) != bool(parts):
                raise FrameError("unexpected continuation")
            size += len(payload)
            if size > MAX_MESSAGE_BYTES:
                raise FrameError("message too large")
            parts.append(payload)
            if fin:
                return b"".join(parts)

    async def send(self, message: bytes) -> None:
        await self._send(OP_TEXT, message)

    async def _send(self, opcode: int, payload: bytes) -> None:
        if self.closed:
            return
        self.writer.write(encode_frame(opcode, payload, mask=self.is_client))
        await self.writer.drain()

    async def close(self) -> None:
        if self.closed:
            return
        with contextlib.suppress(Exception):
            self.writer.write(encode_frame(OP_CLOSE, b"\x03\xe8", mask=self.is_client))
            await self.writer.drain()
        self.closed = True
        with contextlib.suppress(Exception):
            self.writer.close()


# --------------------------------------------------------------------------
# CDP multiplexing
# --------------------------------------------------------------------------

SESSION_NOT_FOUND = -32001


@dataclass(eq=False)
class Client:
    """One connected tool. ``root`` is its browser-level session on the pipe."""

    name: str
    root: str | None = None
    sessions: set[str] = field(default_factory=set)
    #: Messages for the browser that arrived before ``root`` existed.
    held: list[dict[str, Any]] = field(default_factory=list)
    #: Set when the client asked for ``Browser.close``: it is disconnected.
    hang_up: bool = False


@dataclass
class _Pending:
    client: Client | None
    client_id: Any
    method: str
    at_root: bool


class Multiplexer:
    """Route one CDP pipe between many clients, each in its own sessions.

    Pure routing: ``to_browser`` and ``to_client`` are callbacks, so the rules
    are testable without Chromium or sockets.
    """

    def __init__(self, to_browser, to_client, on_internal=None) -> None:
        self._to_browser = to_browser
        self._to_client = to_client
        self._on_internal = on_internal or (lambda message: None)
        self._next_id = 1
        self._pending: dict[int, _Pending] = {}
        self._owners: dict[str, Client] = {}
        self.clients: list[Client] = []

    def _send(self, message: dict[str, Any], pending: _Pending) -> int:
        browser_id = self._next_id
        self._next_id += 1
        self._pending[browser_id] = pending
        self._to_browser({**message, "id": browser_id})
        return browser_id

    def internal(self, method: str, params: dict[str, Any] | None = None) -> int:
        """Send a command of the daemon's own on the pipe's connection."""
        message: dict[str, Any] = {"method": method}
        if params:
            message["params"] = params
        return self._send(message, _Pending(None, None, method, at_root=False))

    def connect(self, client: Client) -> None:
        self.clients.append(client)
        self._send(
            {"method": "Target.attachToBrowserTarget"},
            _Pending(client, None, "Target.attachToBrowserTarget", at_root=False),
        )

    def disconnect(self, client: Client) -> None:
        if client in self.clients:
            self.clients.remove(client)
        for session in client.sessions:
            self._owners.pop(session, None)
        client.sessions.clear()
        for pending in self._pending.values():
            if pending.client is client:
                pending.client = None
        if client.root is not None:
            # Detaching the browser session ends the sessions it created.
            # Pages it opened stay open: the browser is the sandbox's.
            self.internal("Target.detachFromTarget", {"sessionId": client.root})

    def from_client(self, client: Client, message: dict[str, Any]) -> None:
        client_id = message.get("id")
        method = message.get("method")
        if not isinstance(client_id, int) or not isinstance(method, str):
            raise FrameError("a CDP command needs an integer id and a method")
        if client.root is None:
            client.held.append(message)
            return
        session = message.get("sessionId")
        if session is None:
            if method == "Browser.close":
                # One tool closing must not take the browser from the others.
                client.hang_up = True
                self._to_client(client, {"id": client_id, "result": {}})
                return
            outgoing = {**message, "sessionId": client.root}
            self._send(outgoing, _Pending(client, client_id, method, at_root=True))
            return
        if self._owners.get(session) is not client or session == client.root:
            self._to_client(
                client,
                {
                    "id": client_id,
                    "sessionId": session,
                    "error": {
                        "code": SESSION_NOT_FOUND,
                        "message": f"Session with given id not found: {session}",
                    },
                },
            )
            return
        self._send(message, _Pending(client, client_id, method, at_root=False))

    def from_browser(self, message: dict[str, Any]) -> None:
        if "id" in message:
            self._reply(message)
        else:
            self._event(message)

    def _claim(self, client: Client, session: Any) -> None:
        if isinstance(session, str) and session not in self._owners:
            self._owners[session] = client
            client.sessions.add(session)

    def _release(self, session: Any) -> None:
        owner = self._owners.pop(session, None) if isinstance(session, str) else None
        if owner is not None:
            owner.sessions.discard(session)

    def _reply(self, message: dict[str, Any]) -> None:
        pending = self._pending.pop(message["id"], None)
        if pending is None:
            return
        client = pending.client
        result = message.get("result")
        if pending.method == "Target.attachToBrowserTarget" and pending.client_id is None:
            self._attach_root(pending, message)
            return
        if client is None:
            self._on_internal(message)
            return
        if pending.method == "Target.attachToTarget" and isinstance(result, dict):
            self._claim(client, result.get("sessionId"))
        reply = {**message, "id": pending.client_id}
        if pending.at_root:
            reply.pop("sessionId", None)
        self._to_client(client, reply)

    def _attach_root(self, pending: _Pending, message: dict[str, Any]) -> None:
        client = pending.client
        result = message.get("result")
        session = result.get("sessionId") if isinstance(result, dict) else None
        if client is None:
            # The client left before its session existed: give it back.
            if isinstance(session, str):
                self.internal("Target.detachFromTarget", {"sessionId": session})
            return
        if not isinstance(session, str):
            client.hang_up = True
            self._to_client(client, {"method": "Inspector.detached", "params": {}})
            return
        client.root = session
        self._owners[session] = client
        client.sessions.add(session)
        held, client.held = client.held, []
        for queued in held:
            self.from_client(client, queued)

    def _event(self, message: dict[str, Any]) -> None:
        session = message.get("sessionId")
        owner = self._owners.get(session) if isinstance(session, str) else None
        if owner is None:
            return
        method = message.get("method")
        params = message.get("params") if isinstance(message.get("params"), dict) else {}
        if method == "Target.attachedToTarget":
            self._claim(owner, params.get("sessionId"))
        elif method == "Target.detachedFromTarget":
            self._release(params.get("sessionId"))
        if session == owner.root:
            message = {key: value for key, value in message.items() if key != "sessionId"}
        self._to_client(owner, message)


