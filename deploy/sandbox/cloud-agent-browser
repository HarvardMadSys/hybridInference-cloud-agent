CONTRACT_VERSION = "1"
CHROMIUM = "/usr/bin/chromium"
WORKSPACE = "/workspace"

#: How long the browser waits with no client before it stops. A member that
#: comes back later gets a fresh process on the same profile.
DEFAULT_IDLE_S = 900.0
#: Chromium must answer its first command within this, or start fails.
READY_TIMEOUT_S = 30.0
#: One CDP message, in either direction. Full-page screenshots of long pages
#: run to tens of megabytes; nothing legitimate comes near this.
MAX_MESSAGE_BYTES = 128 * 1024 * 1024
MAX_CLIENTS = 32
MAX_REQUEST_HEAD = 16 * 1024

#: Whether the managed browser may run without Chromium's own sandbox when the
#: guest refuses unprivileged user namespaces (Docker's default seccomp profile
#: does, under runc and Kata alike). Decided at the Phase 0 review
#: (docs/agents/specs/2026-11-02-computer-use-base-capability.md): the member
#: UID already runs unvetted repository code, the Kata VM and the member UID
#: are the boundary, and the same member could start this binary with
#: ``--no-sandbox`` itself. ``status`` reports which mode is in effect.
ALLOW_UNSANDBOXED = True

WEBSOCKET_GUID = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
PR_SET_PDEATHSIG = 1

# Flags every managed launch uses. Background networking, component updates,
# crash upload and metrics are off for the same reason the agent CLIs'
# telemetry is: nothing in a sandbox should phone home on its own.
CHROMIUM_FLAGS = (
    "--headless=new",
    "--remote-debugging-pipe",
    "--no-first-run",
    "--no-default-browser-check",
    "--disable-dev-shm-usage",
    "--disable-background-networking",
    "--disable-component-update",
    "--disable-breakpad",
    "--disable-sync",
    "--metrics-recording-only",
    "--no-pings",
    "--password-store=basic",
    "--renderer-process-limit=4",
)


class BrowserError(Exception):
    """A failure this command reports on stderr with exit status 1."""


