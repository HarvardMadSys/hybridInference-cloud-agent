# syntax=docker/dockerfile:1.7
#
# The image an agent job actually executes in (issue #1041).
#
# This is the untrusted side of the system: it runs an agent that will install
# dependencies and execute code from a repository nobody vetted. Two rules
# follow from that and shape everything below.
#
# 1. **No credentials are baked in.** The only secret that ever reaches this
#    image is the job's model-scoped token, injected as an environment variable
#    at run time. It authorizes a fixed set of models and MCP tools and nothing
#    else — spend is governed by the user's quota at the gateway, not by
#    anything this container holds. There is no GitHub token here, because the
#    agent never pushes — it emits a patch and the trusted publisher outside
#    handles git.
# 2. **Nothing here is trusted at run time.** Legacy jobs throw the container
#    away after one attempt; shared-live chats retain the same stopped Docker
#    writable layer until an explicit future cleanup policy removes it. Both
#    modes run as non-root and (under the kata backend) have their own kernel.
#
# Runtimes are pinned rather than floating: an agent CLI that silently updates
# changes its own event format, and the normalized event mapping in
# cloud_agent_host/runtimes.py is written against a specific shape.

FROM node:22-bookworm-slim

# Pin every agent runtime. Bump deliberately, and re-run the agent-loop
# conformance suite (a deployment's harness under services/) when you
# do — that suite exists to catch an event-format change before it reaches a
# user's job.
#
# These were `latest`, which made the comment above a wish rather than a fact,
# and it cost a real job: `latest` resolved to Claude Code 2.1.220, which sends
# a `role: "system"` message inside `messages`. The gateway passed it through
# where it stood and every model call came back
# `400 System message must be at the beginning` — so each job died at its first
# turn, with an error that pointed at the model rather than at the CLI version.
# An unpinned agent CLI is a dependency that changes under you between builds.
#
# The defaults live here, beside the event parser in
# `cloud_agent_host/runtimes.py` that is written against them — those two
# are the pair that has to agree, so the reviewed value belongs in the same
# tree as the code it was reviewed against.
#
# Each is also a build argument a deployment may override
# (`deploy/host/sandbox_host.sh` passes them from that host's `.env`), because
# *which* reviewed version an environment runs is deployment configuration, not
# source. Without that, "let staging soak the new CLI for a week while
# production stays put" was a change to the code both environments build from,
# and every version bump — including a revert at 3am — needed a pull request.
# An override must still be an exact version; the check at the end of this file
# is what makes that true rather than merely asked for.
ARG CLAUDE_CODE_VERSION=2.1.220
ARG CODEX_VERSION=0.145.0
ARG PI_VERSION=0.73.1
ARG OPENCODE_VERSION=1.18.9
ARG KILO_VERSION=7.4.17

# Extra versions this image also carries, comma-separated, so an admin can
# switch a deployment between them from the admin page without a rebuild
# (`agent_runner_policy.runtime_versions`; the runner selects one by PATH).
#
# Empty by default, and an empty list means this image holds exactly the pins
# above — the shape every deployment is in today, byte for byte.
#
# Separate from the pin rather than folded into one list because the pin
# answers a different question and must keep answering it alone: it is the
# *default*, what a job runs when nothing has selected anything, and what the
# `.version` label below reports. A single list would make "the default" the
# first element of a string, which nothing downstream could read.
#
# **Every extra version is a version the event parser must handle.**
# `runtimes.py` normalizes one shape per runtime, and offering a version is a
# claim that it parses — see the conformance suite in `tests/external/`. Adding
# an entry here without running it is how a broken option reaches the menu.
ARG CLAUDE_CODE_EXTRA_VERSIONS=
ARG CODEX_EXTRA_VERSIONS=
ARG PI_EXTRA_VERSIONS=
ARG OPENCODE_EXTRA_VERSIONS=
ARG KILO_EXTRA_VERSIONS=

# The menu: default first, extras after. Derived, never passed — a caller that
# could set these directly could put a version in a label that the install
# below never installed.
ARG CLAUDE_CODE_VERSIONS=${CLAUDE_CODE_VERSION}${CLAUDE_CODE_EXTRA_VERSIONS:+,${CLAUDE_CODE_EXTRA_VERSIONS}}
ARG CODEX_VERSIONS=${CODEX_VERSION}${CODEX_EXTRA_VERSIONS:+,${CODEX_EXTRA_VERSIONS}}
ARG PI_VERSIONS=${PI_VERSION}${PI_EXTRA_VERSIONS:+,${PI_EXTRA_VERSIONS}}
ARG OPENCODE_VERSIONS=${OPENCODE_VERSION}${OPENCODE_EXTRA_VERSIONS:+,${OPENCODE_EXTRA_VERSIONS}}
ARG KILO_VERSIONS=${KILO_VERSION}${KILO_EXTRA_VERSIONS:+,${KILO_EXTRA_VERSIONS}}

# Tools an agent legitimately needs to understand and change a repository.
# Deliberately not installed: anything that would let it reach the host
# (docker CLI) or persist beyond the job.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
        jq \
        ripgrep \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# One prefix per version, the default symlinked onto PATH, and each version
# checked against its own binary. See the script's header for why the layout is
# what it does the work — the runner selects a version by prepending
# `/opt/runtimes/<runtime-id>/<version>/bin`, and nothing in the adapters or the
# wrappers has to know that happened.
#
# Removed afterwards: an agent that can install another CLI version into its own
# sandbox is an agent that can step outside the version its attempt is stamped
# with.
COPY deploy/sandbox/install-runtimes.sh /tmp/install-runtimes.sh
RUN chmod 0755 /tmp/install-runtimes.sh \
    && /tmp/install-runtimes.sh claude-code @anthropic-ai/claude-code claude "${CLAUDE_CODE_VERSIONS}" \
    && /tmp/install-runtimes.sh codex @openai/codex codex "${CODEX_VERSIONS}" \
    && /tmp/install-runtimes.sh pi @mariozechner/pi-coding-agent pi "${PI_VERSIONS}" \
    && /tmp/install-runtimes.sh opencode opencode-ai opencode "${OPENCODE_VERSIONS}" \
    && /tmp/install-runtimes.sh kilo @kilocode/cli kilo "${KILO_VERSIONS}" \
    && npm cache clean --force \
    && rm /tmp/install-runtimes.sh

# Claude's CLI has a live stdin transport but no prompt-free public fork RPC.
# The exact-version Python SDK supplies that native transcript mutation. Keep
# it in a dedicated immutable venv so the runtime helper never depends on a
# package from the repository or the host.
RUN python3 -m venv /opt/claude-agent-sdk \
    && /opt/claude-agent-sdk/bin/pip install --no-cache-dir \
        "claude-agent-sdk==0.2.148"

# The version stamp the runner reads (issue #54): image labels, keyed by
# registry id, derived from the pins above so a label can never disagree with
# what is installed. The heartbeat reports them, the claim copies them onto
# each attempt, and the checkpoint gate compares them before handing a session
# to a resumed turn — an unlabeled image degrades every one of those to
# "unknown", which is a replay, not an error.
#
# Two labels per runtime, answering two questions that diverge the moment an
# image carries more than one version:
#
#   .version   what a job gets when nothing selected anything — the default,
#              and the only one an older control plane knows how to read.
#   .versions  the whole menu, which is what the admin page offers and what the
#              claim checks a selection against before honouring it.
#
# `.version` is deliberately still a single exact version rather than the first
# element of `.versions`: every existing reader parses it as one, and a reader
# that has not been taught about menus must degrade to "the default", not to a
# comma-separated string it will happily stamp onto an attempt.
LABEL org.freeinference.runtime.claude-code.version="${CLAUDE_CODE_VERSION}" \
      org.freeinference.helper.claude-agent-sdk.version="0.2.148" \
      org.freeinference.runtime.codex.version="${CODEX_VERSION}" \
      org.freeinference.runtime.pi.version="${PI_VERSION}" \
      org.freeinference.runtime.opencode.version="${OPENCODE_VERSION}" \
      org.freeinference.runtime.kilo.version="${KILO_VERSION}" \
      org.freeinference.runtime.claude-code.versions="${CLAUDE_CODE_VERSIONS}" \
      org.freeinference.runtime.codex.versions="${CODEX_VERSIONS}" \
      org.freeinference.runtime.pi.versions="${PI_VERSIONS}" \
      org.freeinference.runtime.opencode.versions="${OPENCODE_VERSIONS}" \
      org.freeinference.runtime.kilo.versions="${KILO_VERSIONS}" \
      org.freeinference.shared-sandbox.protocol="v1"

# pi, OpenCode, and Kilo all ignore OPENAI_BASE_URL; each one's supported
# route to a custom gateway is a provider config file whose content (gateway
# address, per-job credential, model) is only known at run time. These
# reviewed wrappers write that file from the environment and exec the real
# CLI — the runner invokes the wrapper, never the bare binary. The OpenCode
# and Kilo wrappers additionally disable the models.dev catalog fetch and
# default-plugin install, both of which hard-fail in the deny-all sandbox
# (Kilo's wrapper also kills the fork's extra phone-home paths).
COPY deploy/sandbox/pi-freeinference /usr/local/bin/pi-freeinference
COPY deploy/sandbox/opencode-freeinference /usr/local/bin/opencode-freeinference
COPY deploy/sandbox/kilo-freeinference /usr/local/bin/kilo-freeinference
COPY deploy/sandbox/http-agent-live-bridge /usr/local/bin/http-agent-live-bridge
COPY deploy/sandbox/claude-session-fork /usr/local/bin/claude-session-fork
RUN chmod 0755 /usr/local/bin/pi-freeinference /usr/local/bin/opencode-freeinference \
        /usr/local/bin/kilo-freeinference /usr/local/bin/http-agent-live-bridge \
        /usr/local/bin/claude-session-fork

# `--ignore-user-config` does not suppress a trusted repository's
# .codex/config.toml. Codex 0.145 applies this requirements allowlist after all
# config layers, so the empty table is the fail-closed P0 MCP policy.
COPY deploy/sandbox/codex-requirements.toml /etc/codex/requirements.toml
RUN chmod 0644 /etc/codex/requirements.toml

# Non-root by default. Legacy jobs bind-mount a worktree; restartable chats keep
# it in the container writable layer. Neither gives the agent a reason to have
# root — and a kernel escape needs a much better bug when it starts
# unprivileged.
#
# The uid is PINNED, and must match SANDBOX_UID in
# cloud_agent_host/sandbox.py: the runner chowns each job
# worktree to that id before mounting it. If the two drift, the agent cannot
# write a single file in its own working tree and git refuses to run at all
# ("dubious ownership") — a failure that looks nothing like its cause.
#
# Restartable chat containers keep both directories in their Docker writable
# layer (never a host bind or named volume). Creating them while still root
# makes this image work for both that mode and the legacy bind-mounted path.
RUN groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agent \
    && slot=0; while [ "$slot" -lt 128 ]; do \
         uid=$((11001 + slot)); \
         useradd --uid "$uid" --gid 10001 --create-home \
           --home-dir "/home/agent-member-$slot" --shell /bin/bash \
           "agent-member-$slot"; \
         slot=$((slot + 1)); \
       done \
    && install -d -m 2770 -o 10001 -g 10001 /workspace /agent-state \
    && install -d -m 0700 -o 10001 -g 10001 /run/agent-activation \
    && install -d -m 0711 -o 0 -g 10001 /run/agent-members
USER agent
WORKDIR /workspace

# Turn off every phone-home an agent CLI does by default. The egress allowlist
# blocks these anyway; setting them here means a blocked request never becomes
# a confusing timeout in the middle of a job.
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_ERROR_REPORTING=1 \
    npm_config_update_notifier=false \
    CI=1 \
    PI_OFFLINE=1

# Fail loudly at build time if a runtime did not land, rather than at 3am when
# a job claims it and dies — and prove each one *is* the version this image
# claims to hold.
#
# The second half is what makes the pins safe to hand to a deployment. The
# labels above are derived from the build arguments, and everything downstream
# treats a label as a statement of fact about the binary: the heartbeat reports
# it, the claim copies it onto the attempt, and the checkpoint gate compares it
# before letting a thread resume its own session. Hand-reviewed exact pins made
# that true by construction. An operator-supplied value does not — `latest`, a
# range like `^2.1`, or a version npm quietly resolved elsewhere each produce an
# image whose label is a lie, and the first symptom of that lie is a thread
# that silently forgets its history (a version mismatch downgrades to replay).
#
# So the rule is: the pin must be an exact version, and this proves it before
# the image exists.
#
# `install-runtimes.sh` already made this check against *every* version under
# its own prefix. This one is not a duplicate: it runs each binary the way a job
# does, through PATH, and so proves the separate claim that the symlinked
# default is the version `.version` advertises. An extras list that shadowed the
# default — a bad symlink, an install ordering mistake — passes there and fails
# here.
RUN set -eu; \
    check() { \
        got="$("$1" --version 2>&1 | tail -1)"; \
        case "$got" in \
            *"$2"*) echo "$1: $got" ;; \
            *) echo "ERROR: $1 reports '$got', but this image is labelled '$2'." >&2; \
               echo "A runtime pin must be an exact version — a dist-tag or a range" >&2; \
               echo "makes the version label, and every record derived from it, a lie." >&2; \
               exit 1 ;; \
        esac; \
    }; \
    check claude "${CLAUDE_CODE_VERSION}"; \
    check codex "${CODEX_VERSION}"; \
    check pi "${PI_VERSION}"; \
    check opencode "${OPENCODE_VERSION}"; \
    check kilo "${KILO_VERSION}"

# No ENTRYPOINT: the runner supplies the full argv from the runtime adapter,
# so this image never decides what an agent run looks like.
CMD ["/bin/bash", "-lc", "echo 'agent sandbox image; the runner supplies the command' && exit 64"]
