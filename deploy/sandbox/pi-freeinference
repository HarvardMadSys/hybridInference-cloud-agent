#!/usr/bin/env python3
"""Point the pi coding agent at this deployment's gateway, then run it.

pi does not honour ``OPENAI_BASE_URL`` — its built-in providers carry fixed
endpoints, and the supported route to a custom gateway is a provider entry in
``~/.pi/agent/models.json`` (see pi's docs/models.md). The gateway address is
only known at run time, so the config cannot be baked into the sandbox image;
this wrapper writes it from the environment on every start and ``exec``s the
real CLI with argv passed through untouched.

Ships in the sandbox image (reviewed and pinned there, like the CLI itself).
Three properties are deliberate:

- **The prompt never passes through a shell.** argv in, argv out, one exec.
- **The config never lives in the workspace.** It is written into the
  member's activation tmpfs.
- **json.dump does the quoting**, so a model id or URL that would break
  hand-rolled string templating cannot corrupt the config.
"""

import json
import os
import shutil
import sys

#: The packages pi has been published as. It moved to the second in May 2026;
#: the image's default still comes from the first.
PI_PACKAGES = ("@mariozechner/pi-coding-agent", "@earendil-works/pi-coding-agent")
#: The first release that gates a repository's own resources behind project
#: trust, and the first that accepts ``--approve``.
PROJECT_TRUST_SINCE = (0, 79, 0)


def plugin_args() -> list[str]:
    """Load only user-selected packages alongside the reviewed MCP bridge."""
    try:
        paths = json.loads(os.environ.get("AGENT_PLUGIN_PATHS") or "[]")
    except ValueError:
        sys.stderr.write("pi-freeinference: AGENT_PLUGIN_PATHS is not valid JSON.\n")
        raise SystemExit(64) from None
    if not isinstance(paths, list) or any(
        not isinstance(path, str) or not os.path.isabs(path) for path in paths
    ):
        sys.stderr.write("pi-freeinference: AGENT_PLUGIN_PATHS must contain absolute paths.\n")
        raise SystemExit(64)
    return [argument for path in paths for argument in ("-e", path)]


def pi_release() -> tuple[int, ...] | None:
    """The release of the pi on PATH, from its package manifest.

    Read from the file rather than asked of the CLI: ``pi --version`` would
    start a second Node process before every launch. ``None`` when no manifest
    of pi's is found above the resolved binary, or its version is not a plain
    release, which leaves pi's own defaults.
    """
    found = shutil.which("pi")
    if not found:
        return None
    directory = os.path.dirname(os.path.realpath(found))
    while True:
        try:
            with open(os.path.join(directory, "package.json"), encoding="utf-8") as handle:
                manifest = json.load(handle)
        except (OSError, ValueError):
            manifest = None
        if isinstance(manifest, dict) and manifest.get("name") in PI_PACKAGES:
            try:
                return tuple(int(part) for part in str(manifest.get("version")).split("."))
            except ValueError:
                return None
        parent = os.path.dirname(directory)
        if parent == directory:
            return None
        directory = parent


def trust_args() -> list[str]:
    """Read the repository's own pi resources, as pi did before project trust.

    From 0.79.0 pi loads a repository's ``.pi/settings.json``, ``.pi/skills``,
    ``.agents/skills`` and ``.pi/SYSTEM.md`` only for a trusted project, and
    in JSON and RPC mode it skips them unless a saved decision says otherwise.
    0.73.1 read them all, and so do the other agents here, so the decision is
    made explicit for every run. That is all it changes: ``--no-extensions``
    still keeps every extension and MCP server a repository names from
    loading, trusted or not, and ``PI_OFFLINE`` keeps pi from installing the
    packages a repository's settings list, as it did on 0.73.1.
    """
    release = pi_release()
    return ["--approve"] if release is not None and release >= PROJECT_TRUST_SINCE else []


def main() -> None:
    """Write pi's provider config from the environment and exec pi."""
    try:
        base_url = os.environ["OPENAI_BASE_URL"]
        api_key = os.environ["OPENAI_API_KEY"]
        model = os.environ["PI_GATEWAY_MODEL"]
    except KeyError as missing:
        sys.stderr.write(
            f"pi-freeinference: {missing.args[0]} is not set; this wrapper is "
            "meant to be launched by the agent runner, which supplies it.\n"
        )
        raise SystemExit(64) from None

    # The runtime points PI_CODING_AGENT_DIR at the activation tmpfs. The
    # generated models.json contains the short-lived turn credential and must
    # disappear when the chat container stops; native session JSONL lives in
    # the separately supplied --session-dir under /agent-state.
    config_dir = os.environ.get("PI_CODING_AGENT_DIR") or os.path.expanduser("~/.pi/agent")
    os.makedirs(config_dir, exist_ok=True)
    entry: dict[str, object] = {"id": model}
    if os.environ.get("PI_GATEWAY_REASONING"):
        # `--thinking` on its own does nothing. Verified against pi 0.73.1
        # against a recording endpoint: with the model entry as written above,
        # every level produced a request with no `reasoning_effort` at all;
        # adding this made the flag land. The runner sets the variable only
        # for a turn that asked for a depth, because declaring it always would
        # make pi send `medium` on every turn — which would quietly change
        # what every existing job does.
        entry["reasoning"] = True
    config = {
        "providers": {
            "freeinference": {
                "baseUrl": base_url,
                "api": "openai-completions",
                "apiKey": api_key,
                "models": [entry],
            }
        }
    }
    with open(os.path.join(config_dir, "models.json"), "w", encoding="utf-8") as handle:
        json.dump(config, handle)

    # pi accepts explicit package directories under --no-extensions (checked on
    # 0.73.1 and 1.2.0); the CLI resolves each manifest's extensions, skills,
    # prompts, and themes.
    os.execvp("pi", ["pi", *plugin_args(), *trust_args(), *sys.argv[1:]])


if __name__ == "__main__":
    main()
