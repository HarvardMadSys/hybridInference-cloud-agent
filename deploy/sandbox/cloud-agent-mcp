def _read_record(path: str) -> dict[str, Any] | None:
    try:
        with open(path, encoding="utf-8") as handle:
            record = json.load(handle)
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) else None


def _is_ours(pid: Any, role: bytes) -> bool:
    if not isinstance(pid, int) or pid <= 1:
        return False
    try:
        if os.stat(f"/proc/{pid}").st_uid != os.getuid():
            return False
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            argv = handle.read().split(b"\0")
    except OSError:
        return False
    return role in argv and any(arg.endswith(b"cloud-agent-mcp") for arg in argv)


def _running(record_path: str, role: bytes) -> dict[str, Any] | None:
    record = _read_record(record_path)
    return record if record is not None and _is_ours(record.get("pid"), role) else None


def _spawn(argv: list[str], log_path: str) -> str:
    """Start this script detached, and wait for its ready line."""
    ready_r, ready_w = os.pipe()
    log = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        subprocess.Popen(  # this script, re-executed isolated
            [sys.executable, "-I", os.path.abspath(__file__), *argv, str(ready_w)],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            pass_fds=(ready_w,),
            start_new_session=True,
            close_fds=True,
        )
    finally:
        os.close(log)
        os.close(ready_w)
    with os.fdopen(ready_r, "rb") as ready:
        line = ready.readline().decode(errors="replace").strip()
    if not line.startswith("ok"):
        raise GatewayError(line.removeprefix("error ") or f"it exited; see {log_path}")
    return line


def _stop(record_path: str, role: bytes) -> bool:
    record = _running(record_path, role)
    if record is None:
        return False
    pid = record["pid"]
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline and _is_ours(pid, role):
        time.sleep(0.1)
    if _is_ours(pid, role):
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGKILL)
    return True


def _locked(lock_path: str):
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def service_start(paths: Paths) -> dict[str, Any]:
    """Start the gateway unless it runs. Idempotent; as agent-mcp."""
    if os.getuid() != GATEWAY_UID:
        raise GatewayError(f"the gateway runs as uid {GATEWAY_UID}")
    ensure_private_dir(paths.state)
    lock = _locked(paths.lock)
    try:
        record = _running(paths.record, b"_serve")
        if record is None:
            _spawn(["_serve"], paths.log)
            record = _running(paths.record, b"_serve")
        if record is None:
            raise GatewayError("the gateway started but left no record")
        return record
    finally:
        os.close(lock)


def runner_start(paths: Paths, slot: int, *, idle_s: float) -> dict[str, Any]:
    """Start a slot's runner unless it runs. Idempotent; as that slot's runner user."""
    if os.getuid() != RUNNER_UID_BASE + slot:
        raise GatewayError(f"slot {slot}'s runner runs as uid {RUNNER_UID_BASE + slot}")
    ensure_private_dir(paths.slot_dir(slot), 0o710)
    lock = _locked(paths.runner_lock(slot))
    try:
        record = _running(paths.runner_record(slot), b"_runner")
        if record is None:
            _spawn(["_runner", str(slot), str(idle_s)], paths.runner_log(slot))
            record = _running(paths.runner_record(slot), b"_runner")
        if record is None:
            raise GatewayError("the runner started but left no record")
        return record
    finally:
        os.close(lock)


def admit(paths: Paths, slot: int, document: Any) -> Admission:
    """Replace one slot's admission, as its owner; no servers removes it.

    Only the admission owner (root, through the host's exec) writes here.
    The runner and the gateway read it, and can do nothing else to it.
    """
    if os.getuid() != ADMISSION_OWNER_UID:
        raise GatewayError(f"admissions are written as uid {ADMISSION_OWNER_UID}")
    admission = parse_admission(slot, document)
    if not admission.servers:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(paths.admission(slot))
        return admission
    info = os.lstat(paths.admissions)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise GatewayError(f"{paths.admissions} is not a directory only this user writes")
    write_file(paths.admission(slot), json.dumps(admission_document(admission)), 0o644)
    return admission


USAGE = """usage: cloud-agent-mcp <command>   (the platform's)

  admit <slot>           as root: replace a slot's admitted servers; JSON on
                         stdin: {"token_sha256": "...", "servers": [{alias,
                         command, args, env}]}; no servers removes it
  runner start|stop <slot>
                         as agent-mcp-<slot>: run or end that slot's servers
  service start|stop     as agent-mcp: run or end the gateway on
                         http://127.0.0.1:47801/mcp
  status                 print the gateway's state as JSON
"""


def _idle_s() -> float:
    try:
        value = float(os.environ.get("CLOUD_AGENT_MCP_IDLE_S", DEFAULT_IDLE_S))
    except ValueError:
        return DEFAULT_IDLE_S
    return value if value > 0 else DEFAULT_IDLE_S


def _slot(raw: str) -> int:
    if not raw.isdigit() or not 0 <= int(raw) < MAX_SLOTS:
        raise GatewayError("a slot is a number below 128")
    return int(raw)


def main(argv: list[str]) -> int:
    command, rest = (argv[1] if len(argv) > 1 else ""), argv[2:]
    paths = resolve_paths()
    try:
        if command == "_serve":
            ready_fd = int(rest[0])
            os.set_inheritable(ready_fd, False)
            return asyncio.run(Gateway(paths).run(ready_fd))
        if command == "_runner":
            slot, idle_s, ready_fd = _slot(rest[0]), float(rest[1]), int(rest[2])
            os.set_inheritable(ready_fd, False)
            # Servers write into the shared workspace and artifacts directory,
            # where every member reads what they write.
            os.umask(0o007)
            return asyncio.run(Runner(paths, slot, idle_s=idle_s).run(ready_fd))
        if command == "service" and rest == ["start"]:
            service_start(paths)
            print(ENDPOINT)
            return 0
        if command == "service" and rest == ["stop"]:
            print("stopped" if _stop(paths.record, b"_serve") else "not running")
            return 0
        if command == "runner" and len(rest) == 2 and rest[0] in ("start", "stop"):
            slot = _slot(rest[1])
            if rest[0] == "start":
                runner_start(paths, slot, idle_s=_idle_s())
                print(f"slot {slot} runner running")
            else:
                print("stopped" if _stop(paths.runner_record(slot), b"_runner") else "not running")
            return 0
        if command == "admit" and len(rest) == 1:
            try:
                document = json.loads(sys.stdin.read(1 << 20))
            except ValueError as exc:
                raise GatewayError("the admission is not JSON") from exc
            admission = admit(paths, _slot(rest[0]), document)
            print(f"admitted {len(admission.servers)} server(s) for slot {admission.slot}")
            return 0
        if command == "status" and not rest:
            record = _running(paths.record, b"_serve") or {}
            print(json.dumps({"running": bool(record), "endpoint": ENDPOINT, **record}, indent=2))
            return 0
    except GatewayError as exc:
        print(f"cloud-agent-mcp: {exc}", file=sys.stderr)
        return 1
    print(USAGE, file=sys.stderr, end="")
    return 64 if command not in ("-h", "--help", "help") else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
