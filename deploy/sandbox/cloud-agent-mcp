@dataclass(frozen=True)
class Paths:
    #: The gateway's own state: its record, lock and log.
    state: str
    #: Root-owned: one admission per slot.
    admissions: str
    #: One directory per slot, its runner's: socket, record, lock, logs.
    slots: str

    @property
    def record(self) -> str:
        return os.path.join(self.state, "gateway.json")

    @property
    def lock(self) -> str:
        return os.path.join(self.state, "gateway.lock")

    @property
    def log(self) -> str:
        return os.path.join(self.state, "gateway.log")

    def admission(self, slot: int) -> str:
        return os.path.join(self.admissions, f"{slot}.json")

    def slot_dir(self, slot: int) -> str:
        return os.path.join(self.slots, str(slot))

    def runner_socket(self, slot: int) -> str:
        return os.path.join(self.slot_dir(slot), "runner.sock")

    def runner_record(self, slot: int) -> str:
        return os.path.join(self.slot_dir(slot), "runner.json")

    def runner_lock(self, slot: int) -> str:
        return os.path.join(self.slot_dir(slot), "runner.lock")

    def runner_log(self, slot: int) -> str:
        return os.path.join(self.slot_dir(slot), "runner.log")

    def server_log(self, slot: int, alias: str) -> str:
        return os.path.join(self.slot_dir(slot), f"{alias}.log")


def resolve_paths(environ: dict[str, str] | None = None) -> Paths:
    env = os.environ if environ is None else environ
    home = env.get("HOME") or os.path.expanduser("~")
    return Paths(
        state=env.get("CLOUD_AGENT_MCP_STATE_DIR") or os.path.join(home, ".cloud-agent-mcp"),
        admissions=env.get("CLOUD_AGENT_MCP_ADMISSIONS_DIR") or "/run/agent-mcp-admissions",
        slots=env.get("CLOUD_AGENT_MCP_SLOTS_DIR") or "/run/agent-mcp-slots",
    )


def ensure_private_dir(path: str, mode: int = 0o700) -> None:
    """Create ``path``, and refuse one this UID does not own."""
    os.makedirs(path, mode=mode, exist_ok=True)
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise GatewayError(f"{path} is not a directory owned by this user")
    if stat.S_IMODE(info.st_mode) != mode:
        os.chmod(path, mode)


def write_file(path: str, data: str, mode: int = 0o600) -> None:
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.fchmod(fd, mode)
        os.write(fd, data.encode())
    finally:
        os.close(fd)
    os.replace(tmp, path)


def container_started_at() -> float:
    """When this container's first process started, in epoch seconds."""
    try:
        with open("/proc/1/stat", encoding="ascii") as handle:
            ticks = int(handle.read().rsplit(")", 1)[1].split()[19])
        with open("/proc/stat", encoding="ascii") as handle:
            boot = next(int(line.split()[1]) for line in handle if line.startswith("btime "))
        return boot + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration):
        return 0.0


