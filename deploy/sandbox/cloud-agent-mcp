@dataclass
class HttpRequest:
    method: str
    path: str
    headers: dict[str, str]
    body: bytes = b""


@dataclass
class HttpResponse:
    status: str
    body: bytes = b""
    headers: dict[str, str] = field(default_factory=dict)


def _rpc_result(request_id: Any, result: Any) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": request_id, "result": result}


def _rpc_error(request_id: Any, code: int, message: str) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}


class Gateway:
    """The fixed address: authenticates a member, then asks its slot's runner."""

    def __init__(self, paths: Paths) -> None:
        self.paths = paths
        self.admissions = Admissions(paths)
        self.stopping: asyncio.Event | None = None

    # -- HTTP -------------------------------------------------------------

    async def handle(self, request: HttpRequest) -> HttpResponse:
        if request.path.split("?", 1)[0] != "/mcp":
            return HttpResponse("404 Not Found")
        if request.headers.get("host", "") not in (f"{HOST}:{PORT}", f"localhost:{PORT}"):
            return HttpResponse("403 Forbidden")
        authorization = request.headers.get("authorization", "")
        token = authorization[7:].strip() if authorization[:7].lower() == "bearer " else ""
        admission = self.admissions.for_token(token)
        if admission is None:
            return HttpResponse("401 Unauthorized", headers={"WWW-Authenticate": "Bearer"})
        if request.method == "DELETE":
            return HttpResponse("200 OK")
        if request.method != "POST":
            # No server-initiated stream: the tool list does not change while
            # a CLI holds it, because a changed admission restarts the CLI.
            return HttpResponse("405 Method Not Allowed", headers={"Allow": "POST, DELETE"})
        try:
            message = json.loads(request.body)
        except ValueError:
            return self._json(_rpc_error(None, -32700, "parse error"))
        if not isinstance(message, dict) or message.get("jsonrpc") != "2.0":
            return self._json(_rpc_error(None, -32600, "one JSON-RPC 2.0 message per request"))
        if "id" not in message:
            return HttpResponse("202 Accepted")  # notifications, responses: nothing to do
        method = message.get("method")
        _log(f"slot {admission.slot}: {method if isinstance(method, str) else '?'}")
        response = self._json(await self.dispatch(admission, message))
        if method == "initialize":
            response.headers["Mcp-Session-Id"] = secrets.token_urlsafe(16)
        return response

    @staticmethod
    def _json(message: dict[str, Any]) -> HttpResponse:
        return HttpResponse(
            "200 OK",
            json.dumps(message, separators=(",", ":")).encode(),
            {"Content-Type": "application/json"},
        )

    # -- MCP --------------------------------------------------------------

    async def dispatch(self, admission: Admission, message: dict[str, Any]) -> dict[str, Any]:
        request_id, method = message["id"], message.get("method")
        params = message.get("params") if isinstance(message.get("params"), dict) else {}
        try:
            if method == "initialize":
                asked = params.get("protocolVersion")
                version = asked if asked in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0]
                return _rpc_result(
                    request_id,
                    {
                        "protocolVersion": version,
                        "capabilities": {"tools": {"listChanged": False}},
                        "serverInfo": {"name": SERVER_NAME, "version": "1"},
                        "instructions": (
                            "MCP servers the user chose to run inside this sandbox, next to "
                            "the task. Each tool is named <server>__<tool>."
                        ),
                    },
                )
            if method == "ping":
                return _rpc_result(request_id, {})
            if method == "tools/list":
                if not admission.servers:
                    return _rpc_result(request_id, {"tools": []})
                reply = await ask_runner(
                    self.paths, admission.slot, {"op": "list"}, START_TIMEOUT_S + 30
                )
                return _rpc_result(request_id, {"tools": reply.get("tools", [])})
            if method == "tools/call":
                name = params.get("name")
                if not isinstance(name, str):
                    return _rpc_error(request_id, -32602, "tools/call needs a name")
                reply = await ask_runner(
                    self.paths,
                    admission.slot,
                    {"op": "call", "name": name, "arguments": params.get("arguments")},
                    CALL_TIMEOUT_S + START_TIMEOUT_S,
                )
                return _rpc_result(request_id, reply.get("result", {}))
            return _rpc_error(request_id, -32601, f"method not found: {method}")
        except RemoteError as exc:
            return _rpc_error(request_id, exc.code, exc.message)

    # -- lifecycle --------------------------------------------------------

    async def _serve_connection(
        self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter
    ) -> None:
        try:
            request = await read_http_request(reader)
            response = await self.handle(request) if request else HttpResponse("400 Bad Request")
            writer.write(encode_http_response(response))
            await writer.drain()
        except (ConnectionError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
            pass
        finally:
            with contextlib.suppress(Exception):
                writer.close()

    async def run(self, ready_fd: int | None) -> int:
        loop = asyncio.get_running_loop()
        self.stopping = asyncio.Event()
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            loop.add_signal_handler(signum, self.stopping.set)
        try:
            server = await asyncio.start_server(
                self._serve_connection, HOST, PORT, limit=MAX_HEAD_BYTES, reuse_address=True
            )
        except OSError as exc:
            _report(ready_fd, f"error cannot listen on {HOST}:{PORT}: {exc}\n")
            return 1
        write_file(
            self.paths.record,
            json.dumps({"pid": os.getpid(), "endpoint": ENDPOINT, "started_at": int(time.time())}),
        )
        _report(ready_fd, f"ok {ENDPOINT}\n")
        _log(f"serving {ENDPOINT}")
        try:
            await self.stopping.wait()
            return 0
        finally:
            server.close()
            with contextlib.suppress(FileNotFoundError):
                os.unlink(self.paths.record)


def _report(ready_fd: int | None, line: str) -> None:
    if ready_fd is None:
        return
    with contextlib.suppress(OSError):
        os.write(ready_fd, line.encode())
        os.close(ready_fd)


async def read_http_request(reader: asyncio.StreamReader) -> HttpRequest | None:
    head = await reader.readuntil(b"\r\n\r\n")
    try:
        text = head.decode("latin-1")
    except UnicodeDecodeError:
        return None
    lines = text.split("\r\n")
    parts = lines[0].split(" ")
    if len(parts) != 3 or not parts[2].startswith("HTTP/1."):
        return None
    headers: dict[str, str] = {}
    for line in lines[1:]:
        if not line:
            continue
        name, sep, value = line.partition(":")
        if not sep:
            return None
        headers[name.strip().lower()] = value.strip()
    if "chunked" in headers.get("transfer-encoding", "").lower():
        body = await _read_chunked(reader)
    else:
        try:
            length = int(headers.get("content-length", "0"))
        except ValueError:
            return None
        if not 0 <= length <= MAX_REQUEST_BYTES:
            return None
        body = await reader.readexactly(length) if length else b""
    return HttpRequest(parts[0], parts[1], headers, body)


async def _read_chunked(reader: asyncio.StreamReader) -> bytes:
    body = bytearray()
    while True:
        size_line = await reader.readuntil(b"\r\n")
        size = int(size_line.split(b";", 1)[0].strip() or b"0", 16)
        if size == 0:
            await reader.readuntil(b"\r\n")
            return bytes(body)
        if len(body) + size > MAX_REQUEST_BYTES:
            raise ConnectionError("request too large")
        body += await reader.readexactly(size)
        await reader.readexactly(2)


def encode_http_response(response: HttpResponse) -> bytes:
    headers = {
        **response.headers,
        "Content-Length": str(len(response.body)),
        "Connection": "close",
        "Cache-Control": "no-store",
    }
    head = f"HTTP/1.1 {response.status}\r\n" + "".join(
        f"{name}: {value}\r\n" for name, value in headers.items()
    )
    return head.encode() + b"\r\n" + response.body


