def read_record(paths: Paths) -> dict[str, Any] | None:
    try:
        with open(paths.record, encoding="utf-8") as handle:
            record = json.load(handle)
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) else None


def _is_gateway(pid: Any) -> bool:
    if not isinstance(pid, int) or pid <= 1:
        return False
    try:
        if os.stat(f"/proc/{pid}").st_uid != os.getuid():
            return False
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            argv = handle.read().split(b"\0")
    except OSError:
        return False
    return b"_serve" in argv and any(arg.endswith(b"cloud-agent-mcp") for arg in argv)


def running_record(paths: Paths) -> dict[str, Any] | None:
    record = read_record(paths)
    return record if record is not None and _is_gateway(record.get("pid")) else None


def service_start(paths: Paths, *, idle_s: float) -> dict[str, Any]:
    ensure_private_dir(paths.state)
    ensure_private_dir(paths.admissions)
    lock = os.open(paths.lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        record = running_record(paths)
        if record is not None:
            return record
        return _spawn(paths, idle_s=idle_s)
    finally:
        os.close(lock)


def _spawn(paths: Paths, *, idle_s: float) -> dict[str, Any]:
    # A gateway that was not running served nobody: the admissions it left
    # are for CLIs that are gone, whose tokens must not open the new one.
    for name in os.listdir(paths.admissions):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(os.path.join(paths.admissions, name))
    ready_r, ready_w = os.pipe()
    log = os.open(paths.log, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        subprocess.Popen(  # this script, re-executed isolated
            [sys.executable, "-I", os.path.abspath(__file__), "_serve", str(ready_w), str(idle_s)],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            pass_fds=(ready_w,),
            start_new_session=True,
            close_fds=True,
        )
    finally:
        os.close(log)
        os.close(ready_w)
    with os.fdopen(ready_r, "rb") as ready:
        line = ready.readline().decode(errors="replace").strip()
    if not line.startswith("ok "):
        raise GatewayError(line.removeprefix("error ") or f"the gateway exited; see {paths.log}")
    record = running_record(paths)
    if record is None:
        raise GatewayError("the gateway started but left no record")
    return record


def service_stop(paths: Paths) -> bool:
    record = running_record(paths)
    if record is None:
        return False
    pid = record["pid"]
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline and _is_gateway(pid):
        time.sleep(0.1)
    if _is_gateway(pid):
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGKILL)
    return True


def admit(paths: Paths, slot: int, document: Any, *, idle_s: float) -> Admission:
    """Replace one member's admission, and make sure the gateway serves it.

    An empty server list removes the admission instead: the member's CLI is
    then told of no sandbox server, and must not reach one an earlier launch
    of the same slot was given.
    """
    admission = parse_admission(slot, document)
    if not admission.servers:
        revoke(paths, slot)
        return admission
    # First: a gateway that starts forgets every admission before this one.
    service_start(paths, idle_s=idle_s)
    ensure_private_dir(paths.state)
    ensure_private_dir(paths.admissions)
    write_private(paths.admission(slot), json.dumps(admission_document(admission)))
    return admission


def revoke(paths: Paths, slot: int) -> bool:
    try:
        os.unlink(paths.admission(slot))
    except FileNotFoundError:
        return False
    return True


USAGE = """usage: cloud-agent-mcp <command>   (the platform's; run as agent-mcp)

  service start|stop     run or end the gateway on http://127.0.0.1:47801/mcp
  admit <slot>           replace a member's admitted servers, and serve them;
                         JSON on stdin: {"token_sha256": "...",
                         "servers": [{alias, command, args, env}]}; no servers
                         removes the admission
  revoke <slot>          remove a member's admission
  status                 print the gateway's state as JSON
"""


def _idle_s() -> float:
    try:
        value = float(os.environ.get("CLOUD_AGENT_MCP_IDLE_S", DEFAULT_IDLE_S))
    except ValueError:
        return DEFAULT_IDLE_S
    return value if value > 0 else DEFAULT_IDLE_S


def _slot(raw: str) -> int:
    if not raw.isdigit():
        raise GatewayError("a slot is a number")
    return int(raw)


def main(argv: list[str]) -> int:
    command, rest = (argv[1] if len(argv) > 1 else ""), argv[2:]
    paths = resolve_paths()
    try:
        if command == "_serve":
            ready_fd = int(rest[0])
            os.set_inheritable(ready_fd, False)
            # Servers write into the shared workspace and artifacts directory,
            # where every member reads what they write.
            os.umask(0o007)
            return asyncio.run(Gateway(paths, idle_s=float(rest[1])).run(ready_fd))
        if command == "service" and rest == ["start"]:
            print(service_start(paths, idle_s=_idle_s())["endpoint"])
            return 0
        if command == "service" and rest == ["stop"]:
            print("stopped" if service_stop(paths) else "not running")
            return 0
        if command == "admit" and len(rest) == 1:
            try:
                document = json.loads(sys.stdin.read(1 << 20))
            except ValueError as exc:
                raise GatewayError("the admission is not JSON") from exc
            admission = admit(paths, _slot(rest[0]), document, idle_s=_idle_s())
            print(f"admitted {len(admission.servers)} server(s) for slot {admission.slot}")
            return 0
        if command == "revoke" and len(rest) == 1:
            print("revoked" if revoke(paths, _slot(rest[0])) else "not admitted")
            return 0
        if command == "status" and not rest:
            record = running_record(paths) or {}
            print(json.dumps({"running": bool(record), "endpoint": ENDPOINT, **record}, indent=2))
            return 0
    except GatewayError as exc:
        print(f"cloud-agent-mcp: {exc}", file=sys.stderr)
        return 1
    print(USAGE, file=sys.stderr, end="")
    return 64 if command not in ("-h", "--help", "help") else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
