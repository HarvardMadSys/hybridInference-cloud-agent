class RemoteError(Exception):
    """A JSON-RPC error a server returned, passed on to the client as it is."""

    def __init__(self, code: Any, message: str) -> None:
        super().__init__(message)
        self.code = code if isinstance(code, int) else -32603
        self.message = message


def browser_endpoint() -> str:
    """The sandbox browser's CDP URL, starting Chromium if needed."""
    try:
        result = subprocess.run(
            [BROWSER_LAUNCHER, "start"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=90,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise GatewayError(f"the sandbox browser is unavailable: {exc}") from exc
    if result.returncode != 0 or not result.stdout.startswith("ws://"):
        raise GatewayError("the sandbox browser is unavailable: " + result.stderr.strip()[-300:])
    return result.stdout.strip()


def server_argv_env(spec: ServerSpec, home: str) -> tuple[list[str], dict[str, str]]:
    """The process a spec starts, with placeholders filled in."""
    values = [spec.command, *spec.args, *(value for _, value in spec.env)]
    cdp = browser_endpoint() if any(BROWSER_PLACEHOLDER in value for value in values) else ""

    def fill(value: str) -> str:
        return value.replace(BROWSER_PLACEHOLDER, cdp) if cdp else value

    env = {
        "PATH": SANDBOX_PATH,
        "HOME": home,
        "LANG": "C.UTF-8",
        # No install hook of any package runs, here or in its dependencies.
        "npm_config_ignore_scripts": "true",
        "npm_config_yes": "true",
        "npm_config_update_notifier": "false",
        "npm_config_fund": "false",
        "npm_config_audit": "false",
        "CHROME_PATH": os.environ.get("CHROME_PATH", "/usr/bin/chromium"),
    }
    env.update({key: fill(value) for key, value in spec.env})
    return [spec.command, *(fill(arg) for arg in spec.args)], env


class Backend:
    """A running stdio server: newline-delimited JSON-RPC on its stdin/stdout."""

    def __init__(self, spec: ServerSpec, slot: int, paths: Paths) -> None:
        self.spec = spec
        self.slot = slot
        self.paths = paths
        self.process: asyncio.subprocess.Process | None = None
        self.pending: dict[int, asyncio.Future[dict[str, Any]]] = {}
        self.next_id = 1
        self.reader_task: asyncio.Task[None] | None = None
        self.started: asyncio.Future[None] | None = None
        self.last_used = time.monotonic()
        #: Calls running now. A server with any is never idle.
        self.active = 0
        self.tools: list[dict[str, Any]] | None = None
        self.lock = asyncio.Lock()

    @property
    def alive(self) -> bool:
        return self.process is not None and self.process.returncode is None

    @property
    def idle_for(self) -> float:
        return 0.0 if self.active else time.monotonic() - self.last_used

    async def ensure(self) -> None:
        async with self.lock:
            if self.alive and self.started is not None and self.started.done():
                self.started.result()
                return
            await self._start()

    async def _start(self) -> None:
        self.stop()
        home = os.environ.get("HOME") or os.path.expanduser("~")
        argv, env = await asyncio.to_thread(server_argv_env, self.spec, home)
        log = os.open(
            self.paths.server_log(self.slot, self.spec.alias),
            os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW,
            0o600,
        )
        try:
            self.process = await asyncio.create_subprocess_exec(
                *argv,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=log,
                env=env,
                cwd=WORKSPACE if os.path.isdir(WORKSPACE) else "/",
                limit=MAX_MESSAGE_BYTES,
                start_new_session=True,
            )
        except OSError as exc:
            raise GatewayError(f"{self.spec.alias}: cannot start {argv[0]}: {exc}") from exc
        finally:
            os.close(log)
        _log(f"server started: slot {self.slot} {self.spec.alias} pid {self.process.pid}")
        loop = asyncio.get_running_loop()
        self.started = loop.create_future()
        self.reader_task = loop.create_task(self._read(self.process))
        self.tools = None
        try:
            result = await self._request(
                "initialize",
                {
                    "protocolVersion": PROTOCOL_VERSIONS[0],
                    # None: a server must never ask the agent for roots,
                    # sampling or input through this gateway.
                    "capabilities": {},
                    "clientInfo": {"name": "cloud-agent-mcp", "version": "1"},
                },
                timeout=START_TIMEOUT_S,
            )
            if "protocolVersion" not in result:
                raise GatewayError(f"{self.spec.alias}: initialize returned no protocolVersion")
            await self._notify("notifications/initialized")
        except BaseException as exc:
            self.started.set_exception(
                exc if isinstance(exc, GatewayError) else GatewayError(f"{self.spec.alias}: {exc}")
            )
            self.started.exception()  # retrieved: the caller sees it via ensure()
            self.stop()
            raise
        self.started.set_result(None)

    async def _read(self, process: asyncio.subprocess.Process) -> None:
        assert process.stdout is not None
        try:
            while True:
                line = await process.stdout.readline()
                if not line:
                    break
                try:
                    message = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(message, dict):
                    continue
                if "method" in message and "id" in message:
                    # A request from the server. Only ping is answered: the
                    # runner offered no client capability for anything else.
                    reply: dict[str, Any] = {"jsonrpc": "2.0", "id": message["id"]}
                    if message["method"] == "ping":
                        reply["result"] = {}
                    else:
                        reply["error"] = {"code": -32601, "message": "not supported"}
                    await self._write(reply)
                    continue
                future = self.pending.pop(message.get("id"), None) if "id" in message else None
                if future is not None and not future.done():
                    future.set_result(message)
        except (ConnectionError, asyncio.LimitOverrunError, ValueError, GatewayError):
            pass
        finally:
            for future in self.pending.values():
                if not future.done():
                    future.set_exception(GatewayError(f"{self.spec.alias}: the server exited"))
            self.pending.clear()

    async def _write(self, message: dict[str, Any]) -> None:
        process = self.process
        if process is None or process.stdin is None or process.returncode is not None:
            raise GatewayError(f"{self.spec.alias}: the server is not running")
        process.stdin.write(json.dumps(message, separators=(",", ":")).encode() + b"\n")
        with contextlib.suppress(ConnectionError):
            await process.stdin.drain()

    async def _notify(self, method: str, params: dict[str, Any] | None = None) -> None:
        message: dict[str, Any] = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            message["params"] = params
        await self._write(message)

    async def _request(self, method: str, params: dict[str, Any], *, timeout: float) -> Any:
        request_id = self.next_id
        self.next_id += 1
        future: asyncio.Future[dict[str, Any]] = asyncio.get_running_loop().create_future()
        self.pending[request_id] = future
        await self._write({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        try:
            reply = await asyncio.wait_for(future, timeout)
        except TimeoutError:
            self.pending.pop(request_id, None)
            with contextlib.suppress(GatewayError):
                await self._notify(
                    "notifications/cancelled", {"requestId": request_id, "reason": "timed out"}
                )
            raise GatewayError(f"{self.spec.alias}: {method} timed out") from None
        if "error" in reply:
            error = reply["error"] if isinstance(reply["error"], dict) else {}
            raise RemoteError(error.get("code", -32603), str(error.get("message", "error")))
        return reply.get("result", {})

    async def list_tools(self) -> list[dict[str, Any]]:
        await self.ensure()
        if self.tools is None:
            tools: list[dict[str, Any]] = []
            cursor = None
            for _ in range(50):
                params = {"cursor": cursor} if cursor else {}
                result = await self._request("tools/list", params, timeout=START_TIMEOUT_S)
                tools.extend(tool for tool in result.get("tools", []) if isinstance(tool, dict))
                cursor = result.get("nextCursor")
                if not cursor:
                    break
            self.tools = tools
        self.last_used = time.monotonic()
        return self.tools

    async def call_tool(self, name: str, arguments: Any) -> Any:
        # Counted from before the start: a call must not find its server
        # retired while it waits for it, nor while it runs.
        self.active += 1
        try:
            await self.ensure()
            return await self._request(
                "tools/call", {"name": name, "arguments": arguments or {}}, timeout=CALL_TIMEOUT_S
            )
        finally:
            self.active -= 1
            self.last_used = time.monotonic()

    def stop(self) -> None:
        process, self.process = self.process, None
        if self.reader_task is not None:
            self.reader_task.cancel()
            self.reader_task = None
        if process is not None and process.returncode is None:
            # The whole session: npx and uvx run the server as a child.
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(process.pid, signal.SIGTERM)
            _log(f"server stopped: slot {self.slot} {self.spec.alias} pid {process.pid}")
        self.started = None
        self.tools = None


# --------------------------------------------------------------------------
# A slot's runner
# --------------------------------------------------------------------------


def peer_uid(writer: asyncio.StreamWriter) -> int | None:
    sock = writer.get_extra_info("socket")
    try:
        credentials = sock.getsockopt(
            socketlib.SOL_SOCKET, socketlib.SO_PEERCRED, struct.calcsize("3i")
        )
    except (OSError, AttributeError):
        return None
    return struct.unpack("3i", credentials)[1]


class Runner:
    """One slot's servers, as its own UID, answering only the gateway."""

    def __init__(self, paths: Paths, slot: int, *, idle_s: float) -> None:
        self.paths = paths
        self.slot = slot
        self.idle_s = idle_s
        self.admissions = Admissions(paths)
        self.backends: dict[tuple[str, str], Backend] = {}
        #: Presented tool name -> (server key, the server's own name), as last listed.
        self.routes: dict[str, tuple[tuple[str, str], str]] = {}
        self.warmed: set[tuple[str, str]] = set()
        self.stopping: asyncio.Event | None = None

    def specs(self) -> tuple[ServerSpec, ...]:
        admission = self.admissions.get(self.slot)
        return admission.servers if admission is not None else ()

    def backend(self, spec: ServerSpec) -> Backend:
        key = (spec.alias, spec.digest)
        backend = self.backends.get(key)
        if backend is None:
            backend = self.backends[key] = Backend(spec, self.slot, self.paths)
        return backend

    async def list_tools(self) -> list[dict[str, Any]]:
        async def one(spec: ServerSpec) -> list[tuple[str, dict[str, Any], str]]:
            try:
                tools = await self.backend(spec).list_tools()
            except (GatewayError, RemoteError) as exc:
                # One broken server must not take the others' tools away.
                _log(f"tools/list failed: slot {self.slot} {spec.alias}: {exc}")
                return []
            listed = []
            for tool in tools:
                name = tool.get("name")
                if isinstance(name, str):
                    listed.append((presented_name(spec.alias, name), tool, name))
            return listed

        specs = self.specs()
        lists = await asyncio.gather(*(one(spec) for spec in specs))
        routes: dict[str, tuple[tuple[str, str], str]] = {}
        presented: list[dict[str, Any]] = []
        for spec, listed in zip(specs, lists, strict=True):
            for public, tool, own in listed:
                routes[public] = ((spec.alias, spec.digest), own)
                presented.append({**tool, "name": public})
        self.routes = routes
        return presented

    async def call_tool(self, presented: str, arguments: Any) -> Any:
        route = self.routes.get(presented)
        if route is None or route[0] not in {(spec.alias, spec.digest) for spec in self.specs()}:
            # A name this runner has not listed since a change: list again,
            # each server on its own, so a broken one cannot answer for another.
            await self.list_tools()
            route = self.routes.get(presented)
        if route is None:
            raise RemoteError(-32602, f"unknown tool: {presented}")
        key, own = route
        spec = next((spec for spec in self.specs() if (spec.alias, spec.digest) == key), None)
        if spec is None:
            raise RemoteError(-32602, f"unknown tool: {presented}")
        return await self.backend(spec).call_tool(own, arguments)

    def warm(self) -> None:
        """Start each newly admitted server now, so a CLI's first tool list is quick."""
        for spec in self.specs():
            key = (spec.alias, spec.digest)
            if key not in self.warmed:
                self.warmed.add(key)
                asyncio.get_running_loop().create_task(self._warm_one(spec))

    async def _warm_one(self, spec: ServerSpec) -> None:
        try:
            await self.backend(spec).list_tools()
        except (GatewayError, RemoteError) as exc:
            _log(f"warm-up failed: slot {self.slot} {spec.alias}: {exc}")

    def retire(self) -> None:
        """Stop servers idle past the timeout with no call running, and withdrawn ones."""
        admitted = {(spec.alias, spec.digest) for spec in self.specs()}
        for key, backend in list(self.backends.items()):
            if key not in admitted:
                backend.stop()
                del self.backends[key]
                self.warmed.discard(key)
            elif backend.alive and backend.idle_for > self.idle_s:
                backend.stop()

    async def handle(self, request: dict[str, Any]) -> dict[str, Any]:
        op = request.get("op")
        try:
            if op == "list":
                return {"tools": await self.list_tools()}
            if op == "call" and isinstance(request.get("name"), str):
                return {"result": await self.call_tool(request["name"], request.get("arguments"))}
            return {"error": {"code": -32601, "message": f"unknown runner op: {op}"}}
        except RemoteError as exc:
            return {"error": {"code": exc.code, "message": exc.message}}
        except GatewayError as exc:
            return {"error": {"code": -32603, "message": str(exc)}}

    async def _serve_connection(
        self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter
    ) -> None:
        try:
            # The gateway only. A server, a member or another slot's runner
            # can reach this socket's directory, not this runner's servers.
            if peer_uid(writer) != GATEWAY_UID:
                return
            line = await reader.readline()
            request = json.loads(line) if line else None
            reply = await self.handle(request) if isinstance(request, dict) else {}
            writer.write(json.dumps(reply, separators=(",", ":")).encode() + b"\n")
            await writer.drain()
        except (ConnectionError, ValueError, asyncio.LimitOverrunError):
            pass
        finally:
            with contextlib.suppress(Exception):
                writer.close()

    async def _watch(self) -> None:
        retire_every = min(30.0, max(1.0, self.idle_s / 4))
        last_retire = time.monotonic()
        while True:
            await asyncio.sleep(1.0)
            self.warm()
            if time.monotonic() - last_retire >= retire_every:
                last_retire = time.monotonic()
                self.retire()

    async def run(self, ready_fd: int | None) -> int:
        loop = asyncio.get_running_loop()
        self.stopping = asyncio.Event()
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            loop.add_signal_handler(signum, self.stopping.set)
        sock_path = self.paths.runner_socket(self.slot)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(sock_path)
        try:
            server = await asyncio.start_unix_server(
                self._serve_connection, sock_path, limit=MAX_MESSAGE_BYTES
            )
            # The gateway is in the agent group; the peer check does the rest.
            os.chmod(sock_path, 0o660)
        except OSError as exc:
            _report(ready_fd, f"error cannot listen on {sock_path}: {exc}\n")
            return 1
        write_file(
            self.paths.runner_record(self.slot),
            json.dumps({"pid": os.getpid(), "slot": self.slot, "started_at": int(time.time())}),
        )
        watcher = loop.create_task(self._watch())
        _report(ready_fd, "ok\n")
        _log(f"runner serving slot {self.slot}")
        try:
            await self.stopping.wait()
            return 0
        finally:
            watcher.cancel()
            server.close()
            for backend in self.backends.values():
                backend.stop()
            with contextlib.suppress(FileNotFoundError):
                os.unlink(sock_path)
            with contextlib.suppress(FileNotFoundError):
                os.unlink(self.paths.runner_record(self.slot))


async def ask_runner(paths: Paths, slot: int, request: dict[str, Any], timeout: float) -> Any:
    """Send one request to a slot's runner; its result, or ``RemoteError``."""
    sock_path = paths.runner_socket(slot)
    try:
        info = os.lstat(sock_path)
    except OSError as exc:
        raise RemoteError(-32603, f"slot {slot}'s servers are not running") from exc
    # Only that slot's runner could have made this socket in its directory.
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != RUNNER_UID_BASE + slot:
        raise RemoteError(-32603, f"slot {slot}'s runner socket is not its runner's")
    try:
        reader, writer = await asyncio.open_unix_connection(sock_path, limit=MAX_MESSAGE_BYTES)
    except OSError as exc:
        raise RemoteError(-32603, f"slot {slot}'s servers are not running") from exc
    try:
        writer.write(json.dumps(request, separators=(",", ":")).encode() + b"\n")
        await writer.drain()
        line = await asyncio.wait_for(reader.readline(), timeout)
    except ConnectionResetError:
        line = b""  # a refusal: the runner closed before reading the request
    except (OSError, TimeoutError) as exc:
        raise RemoteError(-32603, f"slot {slot}'s servers did not answer") from exc
    finally:
        with contextlib.suppress(Exception):
            writer.close()
    if not line:
        # How a runner refuses a peer that is not the gateway, or how it exits.
        raise RemoteError(-32603, f"slot {slot}'s runner closed without answering")
    try:
        reply = json.loads(line)
    except ValueError as exc:
        raise RemoteError(-32603, f"slot {slot}'s servers did not answer") from exc
    if not isinstance(reply, dict) or not reply:
        raise RemoteError(-32603, f"slot {slot}'s servers refused the gateway")
    if "error" in reply:
        error = reply["error"] if isinstance(reply["error"], dict) else {}
        raise RemoteError(error.get("code", -32603), str(error.get("message", "error")))
    return reply


