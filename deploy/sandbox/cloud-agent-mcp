@dataclass(frozen=True)
class ServerSpec:
    """One admitted server: what it is called and how it starts."""

    alias: str
    command: str
    args: tuple[str, ...]
    env: tuple[tuple[str, str], ...]

    @property
    def digest(self) -> str:
        body = json.dumps([self.command, self.args, self.env], separators=(",", ":"))
        return hashlib.sha256(body.encode()).hexdigest()[:16]


@dataclass(frozen=True)
class Admission:
    slot: int
    token_sha256: str
    servers: tuple[ServerSpec, ...]


def parse_admission(slot: int, document: Any) -> Admission:
    """Validate what the host sent; anything unexpected refuses the whole admission."""
    if not 0 <= slot < MAX_SLOTS:
        raise GatewayError("slot is out of range")
    if not isinstance(document, dict) or set(document) != {"token_sha256", "servers"}:
        raise GatewayError("an admission is {token_sha256, servers}")
    digest = document["token_sha256"]
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise GatewayError("token_sha256 must be 64 lowercase hex digits")
    raw_servers = document["servers"]
    if not isinstance(raw_servers, list) or len(raw_servers) > MAX_SERVERS:
        raise GatewayError(f"servers must be a list of at most {MAX_SERVERS}")
    servers: list[ServerSpec] = []
    for raw in raw_servers:
        if not isinstance(raw, dict) or set(raw) - {"alias", "command", "args", "env"}:
            raise GatewayError("a server is {alias, command, args, env}")
        alias, command = raw.get("alias"), raw.get("command")
        args, env = raw.get("args", []), raw.get("env", {})
        if not isinstance(alias, str) or not _ALIAS.match(alias) or NAMESPACE_SEPARATOR in alias:
            raise GatewayError(f"invalid alias {alias!r}")
        if command not in ALLOWED_COMMANDS:
            raise GatewayError(f"{alias}: the command must be one of {sorted(ALLOWED_COMMANDS)}")
        if not isinstance(args, list) or not all(isinstance(arg, str) for arg in args):
            raise GatewayError(f"{alias}: args must be strings")
        if not isinstance(env, dict) or not all(
            isinstance(key, str) and _ENV_NAME.match(key) and isinstance(value, str)
            for key, value in env.items()
        ):
            raise GatewayError(f"{alias}: env must map variable names to strings")
        servers.append(ServerSpec(alias, command, tuple(args), tuple(sorted(env.items()))))
    if len({server.alias for server in servers}) != len(servers):
        raise GatewayError("aliases must be distinct")
    return Admission(slot, digest, tuple(servers))


def admission_document(admission: Admission) -> dict[str, Any]:
    return {
        "token_sha256": admission.token_sha256,
        "servers": [
            {
                "alias": server.alias,
                "command": server.command,
                "args": list(server.args),
                "env": dict(server.env),
            }
            for server in admission.servers
        ],
    }


def token_digest(token: str) -> str:
    return hashlib.sha256(token.encode()).hexdigest()


class Admissions:
    """Every slot's admission, reread from disk when a file changes.

    An admission counts only when its owner is the admission owner (root, as
    the host writes it) and no one else can write it, and when it was written
    after this container started.
    """

    def __init__(self, paths: Paths) -> None:
        self.paths = paths
        self.started_at = container_started_at()
        self._cache: dict[int, tuple[tuple[int, int, int], Admission | None]] = {}

    def get(self, slot: int) -> Admission | None:
        path = self.paths.admission(slot)
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            self._cache.pop(slot, None)
            return None
        key = (info.st_mtime_ns, info.st_ino, info.st_size)
        cached = self._cache.get(slot)
        if cached is not None and cached[0] == key:
            return cached[1]
        admission = None
        trusted = (
            stat.S_ISREG(info.st_mode)
            and info.st_uid == ADMISSION_OWNER_UID
            and not info.st_mode & 0o022
            and info.st_mtime >= self.started_at - 1
        )
        if trusted:
            with (
                contextlib.suppress(OSError, ValueError, GatewayError),
                open(path, encoding="utf-8") as handle,
            ):
                admission = parse_admission(slot, json.load(handle))
        self._cache[slot] = (key, admission)
        return admission

    def slots(self) -> list[int]:
        try:
            names = os.listdir(self.paths.admissions)
        except OSError:
            return []
        return sorted(
            int(name.removesuffix(".json"))
            for name in names
            if name.endswith(".json") and name.removesuffix(".json").isdigit()
        )

    def for_token(self, token: str) -> Admission | None:
        if not token:
            return None
        digest = token_digest(token)
        found = None
        for slot in self.slots():
            admission = self.get(slot)
            # Compare every one, in constant time: which slot matched must not
            # show in how long the answer took.
            if admission is not None and hmac.compare_digest(admission.token_sha256, digest):
                found = admission
        return found


# --------------------------------------------------------------------------
# Naming, as the relay presents names (cloud_agent.mcp.protocol.presented_name)
# --------------------------------------------------------------------------

_HASH_NAMESPACE = "mcp_h"
_DIGEST_HEX = 32


def sanitize_name(raw: str) -> str:
    cleaned = _NAME_SAFE.sub("_", (raw or "").strip()).strip("_")
    return cleaned or "tool"


def presented_name(alias: str, capability: str) -> str:
    candidate = f"{sanitize_name(alias)}{NAMESPACE_SEPARATOR}{sanitize_name(capability)}"
    if (
        candidate == f"{alias}{NAMESPACE_SEPARATOR}{capability}"
        and NAMESPACE_SEPARATOR not in alias
        and alias != _HASH_NAMESPACE
        and len(candidate) <= MAX_PRESENTED_NAME
    ):
        return candidate
    digest = hashlib.sha256(json.dumps([alias, capability]).encode()).hexdigest()[:_DIGEST_HEX]
    prefix = f"{_HASH_NAMESPACE}{NAMESPACE_SEPARATOR}"
    budget = MAX_PRESENTED_NAME - len(prefix) - len(digest) - len(NAMESPACE_SEPARATOR)
    return f"{prefix}{candidate[:budget]}{NAMESPACE_SEPARATOR}{digest}"


