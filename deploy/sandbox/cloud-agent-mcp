#!/usr/bin/python3 -I
"""The sandbox's MCP gateway: user-selected stdio MCP servers, next to the agent.

A user can choose to run an MCP server *in the sandbox* (location ``sandbox``)
instead of behind the platform relay: it then sees the task's ``localhost``,
its files and the sandbox's browser. The trusted host decides which servers a
member may use; this gateway runs them and presents them to the member's
agent CLI as one Streamable HTTP MCP server, ``sandbox``, the way the relay
presents the remote ones as ``session``.

Why a gateway, and not a stdio entry in each CLI's config:

- It runs as its own user (``agent-mcp``), which no member's turn-end reap
  scans. A server a CLI spawned as the member would be killed at the end of
  any turn in which it started.
- Every runtime already speaks HTTP MCP to the relay, so each needs one more
  URL, not a stdio client of its own (pi's bridge has none).
- The URL is fixed (``http://127.0.0.1:47801/mcp``), so Codex's root-owned
  allowlist names it once for every member.

The host admits a member's servers before it launches the member's CLI::

    cloud-agent-mcp admit <slot> < {"token_sha256": ..., "servers": [...]}

The token is the member's MCP credential, the one its CLI already sends to the
relay, so every runtime reaches both servers with one header. The gateway
keeps only its SHA-256: a server it runs, as the same user, cannot read a
member's credential back. A request is served for the member whose admission
matches its bearer token, and only with that member's servers. Each
admitted server starts on first use, one process per member and server, and
stops after the idle timeout. Tools are presented as ``<alias>__<tool>``, as
the relay names them. Only tools are forwarded; the gateway offers the
servers no client capabilities (roots, sampling, elicitation), so they never
ask the agent anything.

A server's arguments and environment may name ``${CLOUD_AGENT_BROWSER_CDP}``,
replaced at start with the sandbox browser's CDP URL (``cloud-agent-browser
start``): a template can bind Playwright MCP to the managed browser without
knowing its token.

Installs run with npm's ``ignore-scripts`` on, so a package's install hooks do
not run. The host has already refused a package without an exact version.

It runs isolated (``-I``), like the other helpers in this image, and uses the
standard library only.
"""

from __future__ import annotations

import asyncio
import contextlib
import fcntl
import hashlib
import hmac
import json
import os
import re
import secrets
import signal
import stat
import subprocess
import sys
import time
from dataclasses import dataclass, field
from typing import Any

PORT = 47801
HOST = "127.0.0.1"
ENDPOINT = f"http://{HOST}:{PORT}/mcp"
SERVER_NAME = "sandbox"
NAMESPACE_SEPARATOR = "__"
#: The relay's limit for a presented name (cloud_agent.mcp.protocol): a CLI
#: prefixes ``mcp__<server>__``, and ``sandbox`` is as long as ``session``.
MAX_PRESENTED_NAME = 64 - len("mcp__sandbox__")
MAX_SLOTS = 128
MAX_SERVERS = 16
MAX_REQUEST_BYTES = 8 * 1024 * 1024
MAX_MESSAGE_BYTES = 64 * 1024 * 1024
MAX_HEAD_BYTES = 16 * 1024
#: A server that has served no call for this long is stopped; the next call starts it.
DEFAULT_IDLE_S = 900.0
#: How long a server may take to install and answer ``initialize``.
START_TIMEOUT_S = 180.0
#: One tool call. Browser actions and builds can be slow; the CLIs allow 26 minutes.
CALL_TIMEOUT_S = 1500.0
PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")
BROWSER_PLACEHOLDER = "${CLOUD_AGENT_BROWSER_CDP}"
BROWSER_LAUNCHER = "/usr/local/bin/cloud-agent-browser"
#: The commands a sandbox server may start with, as the host's launch policy
#: allows them (cloud_agent.mcp.launch). Checked again here: the gateway runs
#: nothing else, whatever an admission says.
ALLOWED_COMMANDS = frozenset({"npx", "uvx"})
#: As the relay's alias pattern (cloud_agent_shared.sandbox_mcp.ALIAS_PATTERN).
_ALIAS = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$")
_NAME_SAFE = re.compile(r"[^A-Za-z0-9_-]")
_ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,127}$")
SANDBOX_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WORKSPACE = "/workspace"


class GatewayError(Exception):
    """A failure this command reports on stderr with exit status 1."""


