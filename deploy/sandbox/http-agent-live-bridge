#!/usr/bin/python3 -I
"""Private stdio bridge for OpenCode/Kilo's authenticated loopback server.

The host supervisor deliberately owns only one Docker-exec stdin/stdout pipe.
OpenCode and Kilo expose their resident protocol over HTTP/SSE instead, so this
small stdlib-only process keeps the server and its random Basic-auth secret
inside the member's process group and translates it to fenced JSON lines.

The password is generated in memory, never persisted or placed in argv.  The
server binds loopback only, and this bridge is run under the member-specific
UID/tmpfs slot.  stdout is protocol-only; child diagnostics go to stderr.
"""

from __future__ import annotations

import base64
import contextlib
import json
import os
import re
import secrets
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import Any

_RUNTIMES = {
    "opencode": {
        "wrapper": "opencode-freeinference",
        "username": "opencode",
        "password_env": "OPENCODE_SERVER_PASSWORD",
        "username_env": "OPENCODE_SERVER_USERNAME",
        "directory_header": "x-opencode-directory",
    },
    "kilo": {
        "wrapper": "kilo-freeinference",
        "username": "kilo",
        "password_env": "KILO_SERVER_PASSWORD",
        "username_env": "KILO_SERVER_USERNAME",
        "directory_header": "x-kilo-directory",
    },
}


class BridgeError(RuntimeError):
    """A local protocol or server error that must fail closed."""


def _is_platform_user(message: Any) -> bool:
    """Distinguish one outer prompt from provider-internal continuations."""
    if not isinstance(message, dict):
        return False
    info = message.get("info")
    if not isinstance(info, dict) or info.get("role") != "user":
        return False
    parts = message.get("parts")
    if not isinstance(parts, list):
        raise BridgeError("native user message has no parts")
    # A compaction request is represented as a user message with a dedicated
    # part; auto-continue is a synthetic text part. Both belong to the already
    # active platform turn. A genuine prompt has at least one non-synthetic,
    # non-compaction part (text, file, image, etc.).
    if any(isinstance(part, dict) and part.get("type") == "compaction" for part in parts):
        return False
    return any(
        isinstance(part, dict)
        and part.get("type") != "compaction"
        and part.get("synthetic") is not True
        for part in parts
    )


def fork_payload(messages: Any, source_native_turn_no: int) -> dict[str, str]:
    """Resolve one settled ordinal to the servers' exclusive fork boundary."""
    if source_native_turn_no < 1:
        raise BridgeError("fork source_native_turn_no must be positive")
    if not isinstance(messages, list):
        raise BridgeError("native message history has an invalid shape")
    user_messages = [message["info"] for message in messages if _is_platform_user(message)]
    if source_native_turn_no > len(user_messages):
        raise BridgeError(
            "native history does not contain the requested fork turn "
            f"({source_native_turn_no} of {len(user_messages)})"
        )
    if source_native_turn_no == len(user_messages):
        return {}
    # Both pinned servers define messageID as an exclusive upper bound. The
    # next user message includes the selected completed exchange without
    # copying the prompt Edit & rewind replaces.
    next_message_id = user_messages[source_native_turn_no].get("id")
    if not isinstance(next_message_id, str) or not next_message_id:
        raise BridgeError("next native user message has no id")
    return {"messageID": next_message_id}


#: Entries one context summary carries; the largest are kept.
CONTEXT_MAX_ENTRIES = 300
CONTEXT_PREVIEW_CHARS = 160
_CJK = re.compile(r"[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uac00-\ud7af\uf900-\ufaff\uff00-\uffef]")
_ASCII = re.compile(r"[\x00-\x7f]")
#: What the servers put in place of a tool output they pruned from context.
PRUNED_OUTPUT = "[Old tool result content cleared]"


def carried_messages(messages: Any) -> list[dict[str, Any]]:
    """The messages a request carries, as the pinned servers filter compacted history.

    A port of ``filterCompacted`` (OpenCode 1.18.9 ``session/message-v2.ts``,
    the same in Kilo 7.4.17), applied to the oldest-first list
    ``GET /session/{id}/message`` returns.
    """
    if not isinstance(messages, list):
        return []
    newest_first = [m for m in reversed(messages) if isinstance(m, dict) and isinstance(m.get("info"), dict)]
    result: list[dict[str, Any]] = []
    completed: set[str] = set()
    retain = None
    for msg in newest_first:
        info = msg["info"]
        parts = [p for p in msg.get("parts") or [] if isinstance(p, dict)]
        result.append(msg)
        if retain:
            if info.get("id") == retain:
                break
            continue
        if info.get("role") == "user" and info.get("id") in completed:
            part = next((p for p in parts if p.get("type") == "compaction"), None)
            if part is None:
                continue
            if not part.get("tail_start_id"):
                break
            retain = part["tail_start_id"]
            if info.get("id") == retain:
                break
            continue
        if info.get("role") == "assistant" and info.get("summary") and info.get("finish") and not info.get("error"):
            completed.add(str(info.get("parentID")))
    result.reverse()

    def has_tail_compaction(msg: dict[str, Any]) -> dict[str, Any] | None:
        if msg["info"].get("role") != "user":
            return None
        return next(
            (p for p in msg.get("parts") or [] if isinstance(p, dict) and p.get("type") == "compaction" and p.get("tail_start_id")),
            None,
        )

    compaction_index = max((i for i, m in enumerate(result) if has_tail_compaction(m)), default=-1)
    if compaction_index < 0:
        return result
    compaction = result[compaction_index]
    part = has_tail_compaction(compaction) or {}
    summary_index = next(
        (
            i
            for i, m in enumerate(result)
            if i > compaction_index
            and m["info"].get("role") == "assistant"
            and m["info"].get("summary")
            and m["info"].get("parentID") == compaction["info"].get("id")
        ),
        -1,
    )
    tail_index = next((i for i, m in enumerate(result) if m["info"].get("id") == part.get("tail_start_id")), -1)
    if 0 <= tail_index < compaction_index and summary_index > compaction_index:
        return [
            *result[compaction_index : summary_index + 1],
            *result[tail_index:compaction_index],
            *result[summary_index + 1 :],
        ]
    return result


def _context_entry(category: str, label: Any, text: str, **extra: Any) -> dict[str, Any]:
    cjk = len(_CJK.findall(text))
    ascii_chars = len(_ASCII.findall(text))
    preview = " ".join(text.split())[:CONTEXT_PREVIEW_CHARS]
    entry = {
        "category": category,
        "label": str(label or "")[:200],
        "chars": len(text),
        "ascii": ascii_chars,
        "cjk": cjk,
        "other": max(0, len(text) - ascii_chars - cjk),
        "preview": preview,
    }
    entry.update({key: value for key, value in extra.items() if value})
    return entry


def _part_entries(info: dict[str, Any], part: dict[str, Any]) -> list[dict[str, Any]]:
    kind = part.get("type")
    message_ref = {"message_id": str(info.get("id") or ""), "part_id": str(part.get("id") or "")}
    if kind == "text":
        text = str(part.get("text") or "")
        if info.get("role") == "user":
            category = "injected" if part.get("synthetic") else "user_messages"
        else:
            category = "compaction_summary" if info.get("summary") else "assistant"
        return [_context_entry(category, info.get("role"), text, ref=message_ref, synthetic=part.get("synthetic") is True)]
    if kind == "reasoning":
        return [_context_entry("reasoning", "reasoning", str(part.get("text") or ""), ref=message_ref)]
    if kind == "file":
        return [_context_entry("user_messages", part.get("filename") or "file", f"[file {part.get('mime') or ''}]", ref=message_ref)]
    if kind != "tool":
        return []
    state = part.get("state") if isinstance(part.get("state"), dict) else {}
    call_ref = {**message_ref, "tool_use_id": str(part.get("callID") or "")}
    tool = part.get("tool") or "tool"
    entries = [
        _context_entry("tool_calls", tool, json.dumps(state.get("input"), ensure_ascii=False, default=str), ref=call_ref)
    ]
    timing = state.get("time") if isinstance(state.get("time"), dict) else {}
    if state.get("status") in {"completed", "error"}:
        if timing.get("compacted"):
            entries.append(_context_entry("tool_results", tool, PRUNED_OUTPUT, ref=call_ref, pruned=True))
        else:
            output = str(state.get("output") or state.get("error") or "")
            entries.append(_context_entry("tool_results", tool, output, ref=call_ref, is_error=state.get("status") == "error"))
    return entries


def _tool_entries(tools: Any) -> list[dict[str, Any]]:
    entries = []
    for tool in tools if isinstance(tools, list) else []:
        if not isinstance(tool, dict):
            continue
        name = str(tool.get("id") or "")
        if name == "invalid":
            # Registered to absorb malformed calls, never offered to the model:
            # ``activeTools`` filters it out (OpenCode 1.18.9 session/llm.ts).
            continue
        text = f"{tool.get('description') or ''}\n{json.dumps(tool.get('parameters'), ensure_ascii=False, default=str)}"
        # The platform's relay names its tools session_<alias>__<tool>.
        category = "mcp_tools" if name.startswith("session_") and "__" in name else "tool_definitions"
        entries.append(_context_entry(category, name, text))
    return entries


def latest_model(messages: Any) -> tuple[str, str]:
    """The provider and model of the newest assistant message."""
    for msg in reversed(messages if isinstance(messages, list) else []):
        info = msg.get("info") if isinstance(msg, dict) else None
        if isinstance(info, dict) and info.get("role") == "assistant" and info.get("providerID") and info.get("modelID"):
            return str(info["providerID"]), str(info["modelID"])
    return "", ""


def context_summary(messages: Any, tools: Any, *, provider: str = "") -> dict[str, Any]:
    """What the session's next request would carry, as bounded entries.

    Messages are filtered as the server filters compacted history; a tool
    output the server pruned is listed as pruned, with the placeholder the
    server sends instead. ``tools`` is ``None`` when the list could not be read.
    """
    all_messages = [m for m in messages if isinstance(m, dict)] if isinstance(messages, list) else []
    carried = carried_messages(all_messages)
    entries: list[dict[str, Any]] = []
    for msg in carried:
        info = msg.get("info") if isinstance(msg.get("info"), dict) else {}
        for part in msg.get("parts") or []:
            if isinstance(part, dict):
                entries.extend(_part_entries(info, part))
    entries.extend(_tool_entries(tools))
    kept = sorted(entries, key=lambda e: -e["chars"])[:CONTEXT_MAX_ENTRIES]
    return {
        "messages": len(carried),
        "provider": provider,
        "tools_listed": tools is not None,
        "entries": kept,
        "entries_omitted": max(0, len(entries) - len(kept)),
        "excluded": {
            "compacted_messages": max(0, len(all_messages) - len(carried)),
            "pruned_tool_outputs": sum(1 for e in entries if e.get("pruned")),
        },
    }


class Bridge:
    def __init__(self, runtime: str) -> None:
        if runtime not in _RUNTIMES:
            raise BridgeError(f"unsupported live HTTP runtime: {runtime!r}")
        self.runtime = runtime
        self.config = _RUNTIMES[runtime]
        self.workdir = os.environ.get("AGENT_LIVE_WORKDIR", "/workspace")
        self.model = (
            os.environ.get("OPENCODE_GATEWAY_MODEL")
            if runtime == "opencode"
            else os.environ.get("KILO_GATEWAY_MODEL")
        )
        if not self.model:
            raise BridgeError("gateway model is missing")
        self.session_id = os.environ.get("AGENT_LIVE_SESSION_ID") or None
        self.username = str(self.config["username"])
        self.password = secrets.token_urlsafe(48)
        self.auth = (
            "Basic " + base64.b64encode(f"{self.username}:{self.password}".encode()).decode()
        )
        self.port = self._available_port()
        self.base_url = f"http://127.0.0.1:{self.port}"
        self.child: subprocess.Popen[str] | None = None
        self._stdout_lock = threading.Lock()
        self._stopping = threading.Event()
        self._turn_lock = threading.Lock()
        self._turn_id: str | None = None
        self._turn_saw_busy = False
        self._turn_failed = False
        self._questions: set[str] = set()
        self._permission_sessions: set[str] = set()
        self._events_connected = threading.Event()

    @staticmethod
    def _available_port() -> int:
        # The server has no inherited-listener option. Holding an ephemeral
        # loopback socket until immediately before spawn minimizes the only
        # race without exposing a fixed port shared by member processes.
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.bind(("127.0.0.1", 0))
            return int(sock.getsockname()[1])

    def emit(self, value: dict[str, Any]) -> None:
        with self._stdout_lock:
            sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
            sys.stdout.flush()

    def _headers(self, *, json_body: bool = False) -> dict[str, str]:
        headers = {
            "Authorization": self.auth,
            "Accept": "application/json",
            str(self.config["directory_header"]): self.workdir,
        }
        if json_body:
            headers["Content-Type"] = "application/json"
        return headers

    def request(
        self,
        method: str,
        path: str,
        payload: dict[str, Any] | None = None,
        *,
        timeout: float = 30,
    ) -> Any:
        body = None if payload is None else json.dumps(payload).encode()
        request = urllib.request.Request(
            self.base_url + path,
            data=body,
            headers=self._headers(json_body=payload is not None),
            method=method,
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                content = response.read()
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")[:1000]
            raise BridgeError(f"{method} {path} returned {exc.code}: {detail}") from exc
        except OSError as exc:
            raise BridgeError(f"{method} {path} failed: {exc}") from exc
        if not content:
            return None
        try:
            return json.loads(content)
        except json.JSONDecodeError as exc:
            raise BridgeError(f"{method} {path} returned invalid JSON") from exc

    def start(self) -> None:
        env = dict(os.environ)
        env[str(self.config["password_env"])] = self.password
        env[str(self.config["username_env"])] = self.username
        argv = [
            str(self.config["wrapper"]),
            "serve",
            "--hostname",
            "127.0.0.1",
            "--port",
            str(self.port),
        ]
        self.child = subprocess.Popen(
            argv,
            cwd=self.workdir,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        threading.Thread(target=self._relay_child_output, args=(False,), daemon=True).start()
        threading.Thread(target=self._relay_child_output, args=(True,), daemon=True).start()

        deadline = time.monotonic() + 30
        while True:
            if self.child.poll() is not None:
                raise BridgeError(f"{self.runtime} serve exited during startup")
            try:
                health = self.request("GET", "/global/health", timeout=1)
                if isinstance(health, dict) and health.get("healthy") is True:
                    break
            except BridgeError:
                pass
            if time.monotonic() >= deadline:
                raise BridgeError(f"{self.runtime} serve did not become healthy")
            time.sleep(0.05)

        if self.session_id:
            resumed = self.request(
                "GET", f"/session/{urllib.parse.quote(self.session_id, safe='')}"
            )
            if not isinstance(resumed, dict) or resumed.get("id") != self.session_id:
                raise BridgeError("server resumed a different native session")
        else:
            created = self.request(
                "POST",
                "/session",
                {
                    # The outer sandbox is the permission boundary. This is
                    # the server-mode equivalent of the existing `run --auto`.
                    "permission": [{"permission": "*", "pattern": "*", "action": "allow"}]
                },
            )
            if not isinstance(created, dict) or not created.get("id"):
                raise BridgeError("server did not return a native session id")
            self.session_id = str(created["id"])

        self._permission_sessions = {str(self.session_id)}
        endpoints = json.loads(os.environ.get("AGENT_MCP_SERVERS") or "{}")
        if endpoints:
            statuses = self.request("GET", "/mcp", timeout=35)
            if not isinstance(statuses, dict) or any(
                not isinstance(statuses.get(name), dict)
                or statuses[name].get("status") != "connected"
                for name in endpoints
            ):
                raise BridgeError(f"{self.runtime} could not initialize the session MCP relay")

        threading.Thread(target=self._watch_child, daemon=True).start()
        self._start_event_stream()
        self.emit(
            {
                "bridge": "ready",
                "runtime": self.runtime,
                "session_id": self.session_id,
            }
        )

    def _relay_child_output(self, stderr: bool) -> None:
        assert self.child is not None
        stream = self.child.stderr if stderr else self.child.stdout
        assert stream is not None
        label = "stderr" if stderr else "stdout"
        for line in stream:
            sys.stderr.write(f"[{self.runtime} serve {label}] {line}")
            sys.stderr.flush()

    def _watch_child(self) -> None:
        assert self.child is not None
        code = self.child.wait()
        if self._stopping.is_set():
            return
        self.emit({"bridge": "fatal", "detail": f"serve exited with status {code}"})
        os._exit(code or 1)

    def _start_event_stream(self) -> None:
        """Subscribe before advertising readiness; native events are not replayed."""
        threading.Thread(target=self._events, daemon=True).start()
        if not self._events_connected.wait(timeout=30):
            raise BridgeError(f"{self.runtime} event stream did not become ready")

    def _events(self) -> None:
        failures = 0
        while not self._stopping.is_set():
            request = urllib.request.Request(
                self.base_url + "/event",
                headers={**self._headers(), "Accept": "text/event-stream"},
                method="GET",
            )
            reason = "closed by server"
            healthy = False
            try:
                with urllib.request.urlopen(request, timeout=60) as response:
                    data: list[str] = []
                    for raw in response:
                        if self._stopping.is_set():
                            return
                        line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
                        if line.startswith(":"):
                            # Both pinned servers emit SSE heartbeat comments.
                            # Unlike the eager connected frame, a heartbeat
                            # proves this subscription stayed alive.
                            healthy = True
                        elif line.startswith("data:"):
                            data.append(line[5:].lstrip())
                        elif not line and data:
                            event_type = self._event_payload("\n".join(data))
                            healthy = healthy or event_type not in {
                                None,
                                "server.connected",
                            }
                            data.clear()
            except Exception as exc:
                reason = str(exc)
            if self._stopping.is_set():
                return

            if healthy:
                failures = 0
            self._event_stream_lost(reason)
            failures += 1
            if failures in (1, 5, 20):
                # A failed active turn has already emitted its fenced
                # diagnostic and settlement. Keep this ownerless reconnect
                # notice off stdout so a later turn cannot consume it.
                sys.stderr.write(
                    f"[{self.runtime} bridge] event stream reconnect {failures}: {reason}\n"
                )
                sys.stderr.flush()
            time.sleep(min(1.0, failures * 0.05))

    def _event_stream_lost(self, detail: str) -> None:
        """Close the admission gate and terminate any turn whose events were lost."""
        # Clear before taking the turn lock: a prompt request may hold that lock,
        # but no waiter may continue believing this live-only stream is usable.
        self._events_connected.clear()
        with self._turn_lock:
            turn_id = self._turn_id
        if turn_id is not None:
            self._fail_active_turn(
                turn_id,
                f"event stream lost: {detail}",
                settle_without_idle=True,
            )

    def _fail_active_turn(
        self,
        turn_id: str,
        detail: str,
        *,
        settle_without_idle: bool,
    ) -> None:
        """Own one captured turn through its session-wide abort."""
        with self._turn_lock:
            if self._turn_id != turn_id:
                return
            self.emit({"bridge": "diagnostic", "detail": detail})

            abort_path = f"/session/{urllib.parse.quote(str(self.session_id), safe='')}/abort"
            try:
                # Both pinned servers finish cancellation before this request
                # returns. Keep ownership throughout so the session-wide abort
                # cannot race with admission of a replacement turn.
                self.request("POST", abort_path, timeout=5)
            except BridgeError as abort_error:
                self._events_connected.clear()
                self._turn_id = None
                self._turn_saw_busy = False
                self._turn_failed = False
                self._questions.clear()
                self._permission_sessions = {str(self.session_id)}
                self.emit(
                    {
                        "bridge": "fatal",
                        "detail": f"{detail}; native abort failed: {abort_error}",
                    }
                )
                return

            self._turn_failed = True
            self._turn_saw_busy = True
            if settle_without_idle:
                # The stream is gone, so its abort-generated cleanup frames
                # cannot be observed. The synchronous abort is the boundary.
                self._settle_locked(turn_id)
                return

            # On a healthy stream, cancellation has already queued tool-error
            # and idle frames. Preserve ownership until the reader drains them.
            timer = threading.Timer(
                10,
                self._abort_settlement_timeout,
                args=(turn_id, detail),
            )
            timer.daemon = True
            timer.start()

    def _abort_settlement_timeout(self, turn_id: str, detail: str) -> None:
        """Fail the bridge if a successful abort never produces native idle."""
        with self._turn_lock:
            if self._turn_id != turn_id:
                return
            self._events_connected.clear()
            self._turn_id = None
            self._turn_saw_busy = False
            self._turn_failed = False
            self._questions.clear()
            self._permission_sessions = {str(self.session_id)}
            self.emit(
                {
                    "bridge": "fatal",
                    "detail": f"{detail}; native idle did not follow abort",
                }
            )

    def _reply_permission(self, session_id: str, request_id: str, turn_id: str) -> bool:
        """Answer a one-shot request or terminate its turn instead of hanging."""
        path = (
            "/session/"
            + urllib.parse.quote(session_id, safe="")
            + "/permissions/"
            + urllib.parse.quote(request_id, safe="")
        )
        last_error: BridgeError | None = None
        for attempt in range(3):
            try:
                self.request(
                    "POST",
                    path,
                    {"response": "once"},
                    timeout=5,
                )
                return True
            except BridgeError as exc:
                last_error = exc
                if attempt < 2:
                    time.sleep(0.05 * (attempt + 1))

        assert last_error is not None
        self._fail_active_turn(
            turn_id,
            f"permission reply failed after 3 attempts: {last_error}",
            settle_without_idle=False,
        )
        return False

    def _event_payload(self, payload: str) -> str | None:
        try:
            event = json.loads(payload)
        except json.JSONDecodeError:
            self.emit({"bridge": "diagnostic", "detail": "invalid SSE JSON"})
            return None
        if not isinstance(event, dict):
            return None
        properties = event.get("properties")
        if not isinstance(properties, dict):
            return None
        event_type = event.get("type")
        if not isinstance(event_type, str):
            return None

        session_id = properties.get("sessionID")
        part = properties.get("part")
        if not session_id and isinstance(part, dict):
            session_id = part.get("sessionID")
        info = properties.get("info")
        if not session_id and isinstance(info, dict):
            session_id = info.get("sessionID")

        if event_type == "server.connected":
            # Both pinned servers register their bus listener before emitting
            # this frame, so it proves that a new turn cannot outrun SSE.
            with self._turn_lock:
                self._events_connected.set()
            return event_type
        with self._turn_lock:
            active = self._turn_id
            if active is None:
                return event_type
            if (
                event_type == "message.part.updated"
                and session_id == self.session_id
                and isinstance(part, dict)
                and part.get("type") == "tool"
                and part.get("tool") == "task"
            ):
                state = part.get("state")
                state = state if isinstance(state, dict) else {}
                metadata = state.get("metadata")
                metadata = metadata if isinstance(metadata, dict) else {}
                child_session_id = metadata.get("sessionId")
                if isinstance(child_session_id, str) and child_session_id:
                    # OpenCode and Kilo create Task children outside the root
                    # session's permission rules. Follow only the relationship
                    # the root reports, without granting an unrelated session.
                    self._permission_sessions.add(child_session_id)
            approve_permission = (
                event_type == "permission.asked" and session_id in self._permission_sessions
            )

        if approve_permission:
            # The outer sandbox is the permission boundary. New root sessions
            # already carry a wildcard rule; this also covers resumed roots and
            # the explicitly tracked child session a Task tool creates.
            request_id = properties.get("id")
            if request_id and not self._reply_permission(str(session_id), str(request_id), active):
                return event_type

        if session_id != self.session_id:
            return event_type

        with self._turn_lock:
            if self._turn_id != active:
                return event_type
            if event_type == "question.asked" and isinstance(properties.get("id"), str):
                self._questions.add(properties["id"])
            elif event_type in {"question.replied", "question.rejected"}:
                self._questions.discard(str(properties.get("requestID") or ""))
            if event_type == "session.status":
                status = properties.get("status")
                if isinstance(status, dict) and status.get("type") != "idle":
                    self._turn_saw_busy = True
                if isinstance(status, dict) and status.get("type") == "idle":
                    self._settle_locked(active)
                    return event_type
            elif event_type == "session.idle":
                self._settle_locked(active)
                return event_type
            elif event_type == "session.error":
                self._turn_failed = True
        self.emit({"bridge": "event", "turn_id": active, "event": event})
        return event_type

    def _settle_locked(self, turn_id: str) -> None:
        # The server emits busy/status before its matching idle. Ignore a
        # subscription's stale initial idle so it cannot settle a new prompt.
        if not self._turn_saw_busy:
            return
        status = "failed" if self._turn_failed else "completed"
        self.emit({"bridge": "settled", "turn_id": turn_id, "status": status})
        self._turn_id = None
        self._turn_saw_busy = False
        self._turn_failed = False
        self._questions.clear()

    def command(self, command: dict[str, Any]) -> None:
        command_id = str(command.get("id") or "")
        kind = command.get("type")
        if not command_id:
            raise BridgeError("command id is required")
        if kind == "turn":
            prompt = command.get("prompt")
            if not isinstance(prompt, str):
                raise BridgeError("turn prompt must be text")
            if not self._events_connected.wait(timeout=30):
                raise BridgeError(f"{self.runtime} event stream is not ready")
            with self._turn_lock:
                if not self._events_connected.is_set():
                    raise BridgeError(f"{self.runtime} event stream is reconnecting")
                if self._turn_id is not None:
                    raise BridgeError("a turn is already active")
                self._turn_id = command_id
                self._permission_sessions = {str(self.session_id)}
                self._turn_saw_busy = False
                self._turn_failed = False
                try:
                    # Hold the ownership lock through admission. A concurrent
                    # stream loss clears readiness first, then waits here and
                    # aborts this captured turn after prompt_async returns.
                    self.request(
                        "POST",
                        f"/session/{urllib.parse.quote(str(self.session_id), safe='')}/prompt_async",
                        {
                            "model": {
                                "providerID": "freeinference",
                                "modelID": self.model,
                            },
                            "parts": [{"type": "text", "text": prompt}],
                        },
                    )
                except Exception:
                    self._turn_id = None
                    self._turn_saw_busy = False
                    self._turn_failed = False
                    self._questions.clear()
                    raise
                self.emit({"bridge": "turn_accepted", "turn_id": command_id})
            return
        if kind == "interrupt":
            with self._turn_lock:
                if self._turn_id != command.get("turn_id"):
                    raise BridgeError("interrupt targets a stale turn")
            self.request(
                "POST", f"/session/{urllib.parse.quote(str(self.session_id), safe='')}/abort"
            )
            self.emit({"bridge": "interrupt_accepted", "id": command_id})
            return
        if kind == "question":
            request_id = command.get("request_id")
            with self._turn_lock:
                if (
                    self._turn_id != command.get("turn_id")
                    or not isinstance(request_id, str)
                    or request_id not in self._questions
                ):
                    raise BridgeError("question targets a stale request")
            path = "/question/" + urllib.parse.quote(request_id, safe="")
            if command.get("reject") is True:
                self.request("POST", path + "/reject")
            else:
                answers = command.get("answers")
                if not isinstance(answers, list) or any(
                    not isinstance(answer, list)
                    or any(not isinstance(value, str) for value in answer)
                    for answer in answers
                ):
                    raise BridgeError("question answers must be lists of text")
                self.request("POST", path + "/reply", {"answers": answers})
            with self._turn_lock:
                self._questions.discard(request_id)
            self.emit({"bridge": "question_answered", "id": command_id})
            return
        if kind == "fork":
            with self._turn_lock:
                if self._turn_id is not None:
                    raise BridgeError("cannot fork an active session")
            source_native_turn_no = command.get("source_native_turn_no")
            if (
                not isinstance(source_native_turn_no, int)
                or isinstance(source_native_turn_no, bool)
                or source_native_turn_no < 1
            ):
                raise BridgeError("fork source_native_turn_no must be a positive integer")
            messages = self.request(
                "GET",
                f"/session/{urllib.parse.quote(str(self.session_id), safe='')}/message",
            )
            payload = fork_payload(messages, source_native_turn_no)
            child = self.request(
                "POST",
                f"/session/{urllib.parse.quote(str(self.session_id), safe='')}/fork?"
                + urllib.parse.urlencode({"directory": self.workdir}),
                payload,
            )
            if not isinstance(child, dict) or not child.get("id"):
                raise BridgeError("fork did not return a child session id")
            self.emit(
                {
                    "bridge": "fork_result",
                    "id": command_id,
                    "source_session_id": self.session_id,
                    "session_id": str(child["id"]),
                }
            )
            return
        if kind == "ping":
            self.emit({"bridge": "pong", "id": command_id, "session_id": self.session_id})
            return
        if kind == "context":
            # Read-only and between turns only: what the next request carries.
            with self._turn_lock:
                if self._turn_id is not None:
                    raise BridgeError("context is read between turns")
            messages = self.request(
                "GET",
                f"/session/{urllib.parse.quote(str(self.session_id), safe='')}/message",
            )
            provider, model = latest_model(messages)
            tools = None
            if provider and model:
                with contextlib.suppress(Exception):
                    tools = self.request(
                        "GET",
                        "/experimental/tool?"
                        + urllib.parse.urlencode({"provider": provider, "model": model}),
                    )
            self.emit(
                {
                    "bridge": "context_result",
                    "id": command_id,
                    "context": context_summary(messages, tools, provider=provider),
                }
            )
            return
        raise BridgeError(f"unknown command type: {kind!r}")

    def run(self) -> None:
        self.start()
        for line in sys.stdin:
            try:
                value = json.loads(line)
                if not isinstance(value, dict):
                    raise BridgeError("command must be a JSON object")
                self.command(value)
            except Exception as exc:
                command_id = ""
                with contextlib.suppress(Exception):
                    command_id = str(value.get("id") or "")  # type: ignore[possibly-undefined]
                self.emit({"bridge": "command_error", "id": command_id, "detail": str(exc)})
        self.stop()

    def stop(self) -> None:
        self._stopping.set()
        child = self.child
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: http-agent-live-bridge <opencode|kilo>")
    bridge: Bridge | None = None
    try:
        bridge = Bridge(sys.argv[1])

        def terminate(*_: object) -> None:
            assert bridge is not None
            bridge.stop()
            # ``stdin`` may still be open when Docker stops the member. Stop
            # must therefore terminate this bridge too, rather than returning
            # to a blocking ``for line in stdin`` after its child is gone.
            raise SystemExit(0)

        signal.signal(signal.SIGTERM, terminate)
        signal.signal(signal.SIGINT, terminate)
        bridge.run()
    except Exception as exc:
        if bridge is not None:
            bridge.emit({"bridge": "fatal", "detail": str(exc)})
            bridge.stop()
        else:
            sys.stderr.write(f"http-agent-live-bridge: {exc}\n")
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
