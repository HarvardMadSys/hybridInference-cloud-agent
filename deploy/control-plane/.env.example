# Control plane — copy to `.env` at the deploy checkout root and fill in.
#
#   cp deploy/control-plane/.env.example .env
#
# ENVIRONMENT.md is the reference; this is the checklist. Every variable the
# compose file refuses to start without is here with an empty value, so
# `docker compose up` fails naming the one that is missing rather than
# starting a stack that is wrong in a way nobody sees until a user hits it.
#
# **Do not commit the filled-in file.** `.gitignore` covers `.env`; secret
# scanning runs on this repository and it will be public.

# ─── Required: the stack will not start without these ────────────────────

# Postgres. This service owns this database outright — it is not the
# gateway's, and pointing it at the gateway's is how two schemas end up in one
# place with no migration story.
AGENT_DATABASE_URL=
AGENT_POSTGRES_PASSWORD=

# The gateway this deployment federates with. Identity and inference grants
# both come from here.
GATEWAY_BASE_URL=
GATEWAY_JWKS_URL=

# Authorizes this service to mint and revoke grants and to read the internal
# lookups. **The same value must be set on the gateway**, and it must differ
# between staging and production — one value shared across both makes a
# staging compromise a production one.
#
#   openssl rand -hex 32
GATEWAY_GRANT_DISPATCH_TOKEN=
# The gateway's consent page, and this service's callback as the public
# internet addresses it. The callback must also appear verbatim in the
# gateway's IDENTITY_ALLOWED_REDIRECTS — matched as an exact string.
GATEWAY_AUTHORIZE_URL=
AGENT_SESSION_REDIRECT_URI=
# Where the browser lands once signed in: the web app's public origin,
# including any base path.
AGENT_WEB_BASE_URL=

# Signs browser sessions. Its own secret, not the gateway's: no signing key
# crosses the two services in either direction.
#
#   openssl rand -hex 32
AGENT_SESSION_SECRET=

# Signs the per-attempt worker and sandbox tokens. Rotating it invalidates
# every token in flight, which is why the cutover drains first.
#
#   openssl rand -hex 32
AGENT_CONTROL_TOKEN_SECRET=

# Wraps stored GitHub installation, GitLab OAuth, and per-user MCP credentials.
# **Generate once and keep it for good** — regenerating it orphans every
# encrypted connection, and there is no way back from that.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SOURCE_CONTROL_ENCRYPTION_KEY=

# New chats require an enrolled Kata host with verified kernel isolation.
# The local development Compose overlay explicitly uses trusted-v1 for runc.
AGENT_DEFAULT_EXECUTION_PROFILE=untrusted-kata-v1

# Authorizes the control plane to every enrolled host's workspace broker. The
# same value must be set on each host; generate it once per environment.
#
#   openssl rand -hex 32
AGENT_WORKSPACE_BROKER_TOKEN=

# Managed by deploy/control-plane/deploy.sh. Keep this empty in the persistent
# file: the deployment command exports the exact target commit for Compose,
# and a direct `docker compose up` without that fence must fail closed.
AGENT_DEPLOYMENT_SHA=

# ─── The web bundle: build arguments, so changing one is a rebuild ───────
#
# The first three are **required**. Empty is a legitimate answer for a deployment
# that owns its own hostname and silently wrong for one that does not, and the
# wrongness does not show at start — so compose makes you say which.

# The prefix this app is mounted under. `/agents` serves it inside the
# gateway's own hostname; empty for a deployment with a hostname of its own.
#
# **Whatever this is, the gateway's `IDENTITY_ALLOWED_REDIRECTS` must contain
# `<origin><this>/callback` verbatim** — matched as an exact string, and Next
# does not prefix a URL the code concatenates.
AGENT_WEB_BASE_PATH=/agents

# The control plane as the browser calls it. Relative, because the proxy
# serves both from one origin: `<base path>/api`, which it strips before
# forwarding. A cross-origin value additionally needs CORS-with-credentials
# here, because the session is a cookie.
AGENT_WEB_API_URL=/agents/api

# The gateway's consent page.
#   https://<gateway>/authorize
AGENT_WEB_GATEWAY_URL=

AGENT_WEB_APP_NAME=

# The rest of the header. All optional: empty hides the organisation name and
# the Status link rather than rendering an empty one.
AGENT_WEB_ORG_NAME=
AGENT_WEB_ORG_URL=

# The deployment's status page, opened in a new tab.
#   https://status.<domain>/
AGENT_WEB_STATUS_URL=

# `true` shows a link to the gateway's Docs Assistant, which is the gateway's
# page and not this service's. Anything else hides it.
AGENT_WEB_FEATURE_RAG=

# ─── Optional, with the ones that are easy to miss ───────────────────────

# Which broker hosts this service will talk to. Empty means no restriction,
# which is only right on a single-host deployment.
AGENT_BROKER_URL_ALLOWED_HOSTS=

# There is no MCP registry variable. A deployment-configured server list is
# the team-MCP feature this product does not offer; per-user connections will
# replace it. The relay stays and currently resolves no servers.

# The MCP relay as a sandbox reaches it: a host-local alias, not this
# service's own bind address.
AGENT_SANDBOX_MCP_URL=

# GitHub App, for repository access and publishing. Absent means users can
# connect nothing.
AGENT_GITHUB_APP_ID=
AGENT_GITHUB_APP_CLIENT_ID=
AGENT_GITHUB_APP_CLIENT_SECRET=
AGENT_GITHUB_APP_PRIVATE_KEY_PATH=
AGENT_GITHUB_APP_INSTALL_URL=

# GitLab OAuth, same story.
AGENT_GITLAB_OAUTH_CLIENT_ID=
AGENT_GITLAB_OAUTH_CLIENT_SECRET=
AGENT_GITLAB_OAUTH_REDIRECT_URI=

# Behind a TLS-terminating proxy, which is the deployed shape.
AGENT_SESSION_COOKIE_SECURE=true
AGENT_TRUST_PROXY_HEADERS=true

AGENT_LOG_LEVEL=INFO
AGENT_REPO_ALLOWLIST=
AGENT_PUBLISH_BASE_BRANCH=

# The docker network this stack creates, which the gateway's frontend joins to
# proxy /agents/* here. Defaults to `cloud-agent`; both sides must agree.
AGENT_NETWORK_NAME=cloud-agent

# Optional edge for a deployment that owns its own hostname (see the `edge`
# service). Leave COMPOSE_PROFILES unset under the gateway's hostname.
# COMPOSE_PROFILES=edge
# AGENT_EDGE_BIND=127.0.0.1
# AGENT_EDGE_PORT=3003
