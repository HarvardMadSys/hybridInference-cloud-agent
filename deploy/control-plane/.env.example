# Control plane bootstrap — copy to the deploy checkout root as .env.
# Keep real values outside this public repository.
#
# This file holds only what the control plane needs before it can read its
# database, and how its containers are wired. Everything else is configured in
# Admin -> Settings: the public web address, account mail, sign-up, signing and
# encryption keys, integrations, sandbox archives, appearance and behavior. A
# missing required setting is named at the top of the Admin pages.
#
# A new installation fills in nothing here by hand. On its first run, deploy.sh
# generates the empty keys below into this file, and the control plane
# generates its signing and credential encryption keys into its settings. The
# first administrator signs in with the one-time setup code the control plane
# logs (agent_local_setup_pending) at /setup/administrator.
# deploy.sh never replaces a value that is set, and generates one only where no
# data can depend on it yet: an existing deployment missing a value is stopped
# and told what to set. Back this file up with the database: the settings root
# key below decrypts every saved secret.
#
# Upgrading: a value an older release read from this file was imported into the
# database on first start, and the database wins from then on. Such lines can
# be deleted; docs/developer/upgrade-notes.md lists them.

# Agent-owned PostgreSQL database; keep its DSN and initialization password
# consistent. The default PostgreSQL user and database are both cloudagent.
# Leave both empty to use the bundled database: deploy.sh generates the
# password and the matching DSN. For another database, set both, and the two
# keys below as well: deploy.sh cannot tell that such a database is new.
AGENT_DATABASE_URL=
AGENT_POSTGRES_PASSWORD=

# Stable root for encrypted settings, shared by the API and MCP listener.
# Leave empty on a new installation for deploy.sh to generate; otherwise at
# least 32 random bytes. Never change it: saved secrets would stop decrypting.
# Existing deployments using AGENT_SESSION_SECRET as their root must use
# that exact original value here before removing the legacy env entry.
AGENT_SETTINGS_ENCRYPTION_KEY=

# The account system's key: every session, emailed token and abuse counter is
# hashed under a key derived from it. Leave empty on a new installation for
# deploy.sh to generate; otherwise at least 32 random bytes, different from
# AGENT_SESSION_SECRET. Replacing it signs everyone out and voids every
# emailed link.
AGENT_LOCAL_SESSION_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────
# Each line below can stay commented out; its default is described beside it.
#
# deploy.sh exports the commit it deploys as AGENT_DEPLOYMENT_SHA; a Compose
# command run by hand exports the checkout's exact git revision itself, as
# described in docs/developer/operations.md. The web app is served at the root
# of its own hostname, with the API at /api on the same origin.

# The Docker network this stack's services share. Another stack's reverse proxy
# that joins it resolves `web` and `control-plane` by name.
# AGENT_NETWORK_NAME=cloud-agent

# Administrator recovery token, independent of any account: a bearer token for
# the admin API and the /setup page when no administrator can
# sign in. Unset opens nothing. Use at least 32 random bytes.
# ADMIN_TOKEN=

# First-time Server setup prefills this node's address; deploy.sh supplies its
# FQDN (or hostname). Set it only to suggest an SSH alias instead.
# AGENT_CONTROL_PLANE_SSH_HOST=

# Optional pgAdmin website (Admin -> Database). Enable COMPOSE_PROFILES=pgadmin
# (or edge,pgadmin for a standalone origin) and set BOOTSTRAP_URL and DIR.
# The first admin chooses pgAdmin's separate login in Admin -> Database.
# For the bundled service: http://pgadmin:5050
# AGENT_PGADMIN_BOOTSTRAP_URL=
# For the bundled service: /var/lib/cloud-agent/pgadmin-bootstrap
# AGENT_PGADMIN_BOOTSTRAP_DIR=
# Optional public proxy URL for first setup, ending in /admin/agent/pgadmin.
# Normally derived from the saved web base URL + /api/admin/agent/pgadmin.
# AGENT_PGADMIN_BOOTSTRAP_PUBLIC_URL=
# Optional custom server definitions; bundled defaults use postgres:5432 and
# database/user cloudagent. No database password belongs in this JSON file.
# AGENT_PGADMIN_SERVERS_FILE=/absolute/path/servers.json
# Optional custom startup wrapper; the default is included in the release.
# AGENT_PGADMIN_ENTRYPOINT_FILE=/absolute/path/pgadmin-entrypoint.py
# For HTTP-only local development; keep True on HTTPS deployments.
# AGENT_PGADMIN_COOKIE_SECURE=False

# Optional trusted compute deployment bundles mounted read-only. Their
# credential encryption key lives in the settings, generated on first start.
# AGENT_COMPUTE_CONFIG=
# AGENT_COMPUTE_DIRECTORY=

# Optional absolute path to an operator-owned private Compose override. Keep the
# file outside the checkout; deploy.sh validates it and appends it after release
# overlays in both source and artifact deployments.
# AGENT_CONTROL_PLANE_COMPOSE_OVERRIDE_FILE=

# Provision AWS credentials only for the main control-plane process using the
# standard SDK chain, preferably an IAM workload role. Environment credentials
# require a private main-service Compose override (see docs/developer/operations.md);
# the base Compose does not forward these variables to containers.
# Never provision them on runner hosts, sandboxes, the web app or MCP relay.
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional deployment-managed GitHub App key mount. Usually leave absent and
# save an encrypted inline private key in Admin Settings instead.
# AGENT_GITHUB_APP_PRIVATE_KEY_FILE=/private/path/github-app.pem

# Optional edge for a dedicated hostname. Leave unset when a parent site proxies.
# COMPOSE_PROFILES=edge
# AGENT_EDGE_BIND=127.0.0.1
# AGENT_EDGE_PORT=3003

# Measurement collection is controlled from Admin -> Measurements; nothing here
# is needed for it. These static experiment overrides stay deployment
# configuration (see ENVIRONMENT.md) and default to off.
# AGENT_OPERATION_PROFILING_ENABLED=false
# AGENT_OPERATION_PROFILING_RUN=
# AGENT_OPERATION_PROFILING_SINK=
# AGENT_OPERATION_PROFILING_MODE=
# AGENT_OPERATION_PROFILING_DEPLOYMENT=default
