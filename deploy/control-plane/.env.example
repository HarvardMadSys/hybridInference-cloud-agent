# Control plane bootstrap — copy to the deploy checkout root as .env.
# Keep real values outside this public repository.
#
# Runtime URLs, identity, signing/user/compute keys, sandbox manager credentials,
# integrations, appearance and behavior are configured in Admin -> Settings.
# New deployments use <web base path>/setup with ADMIN_TOKEN before sign-in.
# Existing runtime env values are accepted for a one-time import only.

# Agent-owned PostgreSQL database; keep its DSN and initialization password
# consistent. The default PostgreSQL user and database are both cloudagent.
AGENT_DATABASE_URL=
AGENT_POSTGRES_PASSWORD=

# Stable root for encrypted settings, shared by the API and MCP listener.
# Generate at least 32 random bytes and preserve this key with DB backups.
# Existing deployments using AGENT_SESSION_SECRET as their root must use
# that exact original value here before removing the legacy env entry.
AGENT_SETTINGS_ENCRYPTION_KEY=

# Separate administrator recovery credential, independent of Gateway sign-in.
# Required for first-run setup. Kept outside the DB so recovery remains usable.
ADMIN_TOKEN=

# The deploy command exports the target commit. For first-run setup, export
# the current checkout's exact git revision as described in docs/operations.md.
AGENT_DEPLOYMENT_SHA=

# Editable first-time Server setup host defaults. When the control-plane value
# is empty, deploy.sh supplies this node's FQDN (or hostname if unavailable).
# Override for an SSH alias.
# The gateway defaults to the saved Gateway API URL's hostname.
AGENT_CONTROL_PLANE_SSH_HOST=
AGENT_GATEWAY_SSH_HOST=

# Image routing is chosen before the web application can access its database.
# For a dedicated hostname use empty BASE_PATH and /api for API_URL instead.
AGENT_WEB_BASE_PATH=/agents
AGENT_WEB_API_URL=/agents/api

# Optional pgAdmin website (Admin -> Database). Enable COMPOSE_PROFILES=pgadmin
# (or edge,pgadmin for a standalone origin) and set BOOTSTRAP_URL and DIR.
# The first admin chooses pgAdmin's separate login in Admin -> Database.
# For the bundled service: http://pgadmin:5050
AGENT_PGADMIN_BOOTSTRAP_URL=
# For the bundled service: /var/lib/cloud-agent/pgadmin-bootstrap
AGENT_PGADMIN_BOOTSTRAP_DIR=
# Optional public proxy URL for first setup, ending in /admin/agent/pgadmin.
# Normally derived from the saved web base URL + /api/admin/agent/pgadmin.
AGENT_PGADMIN_BOOTSTRAP_PUBLIC_URL=
# Optional custom server definitions; bundled defaults use postgres:5432 and
# database/user cloudagent. No database password belongs in this JSON file.
# AGENT_PGADMIN_SERVERS_FILE=/absolute/path/servers.json
# Optional custom startup wrapper; the default is included in the release.
# AGENT_PGADMIN_ENTRYPOINT_FILE=/absolute/path/pgadmin-entrypoint.py
# For HTTP-only local development; keep True on HTTPS deployments.
# AGENT_PGADMIN_COOKIE_SECURE=False

# Must agree with the reverse proxy or Gateway frontend joining this network.
AGENT_NETWORK_NAME=cloud-agent

# Optional trusted compute deployment bundles mounted read-only.
# deploy.sh generates this independent key into the persistent .env when it is
# blank. Keep it stable: changing it requires re-entering stored provider, SSH,
# and server-setup credentials. Preserve it with database backups.
AGENT_COMPUTE_SECRET_KEY=
AGENT_COMPUTE_CONFIG=
AGENT_COMPUTE_DIRECTORY=

# Optional sandbox deletion archives. These nonsecret S3 values are imported
# once; subsequent changes use Admin -> Settings -> Application -> Sandbox archives.
# Deletion stays disabled without a bucket. Archives use conditional single
# PUTs, up to 5 GiB, with independently verified full-object SHA-256 checksums.
AGENT_SANDBOX_ARCHIVE_S3_BUCKET=
AGENT_SANDBOX_ARCHIVE_S3_REGION=
AGENT_SANDBOX_ARCHIVE_S3_ENDPOINT=
AGENT_SANDBOX_ARCHIVE_S3_PREFIX=sandbox-archives
# Optional absolute path to an operator-owned private Compose override. Keep the
# file outside the checkout; deploy.sh validates it and appends it after release
# overlays in both source and artifact deployments.
AGENT_CONTROL_PLANE_COMPOSE_OVERRIDE_FILE=

# Provision AWS credentials only for the main control-plane process using the
# standard SDK chain, preferably an IAM workload role. Environment credentials
# require a private main-service Compose override (see docs/operations.md);
# the base Compose does not forward these variables to containers.
# Never provision them on runner hosts, sandboxes, the web app or MCP relay.
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional deployment-managed GitHub App key mount. Usually leave absent and
# save an encrypted inline private key in Admin Settings instead.
# AGENT_GITHUB_APP_PRIVATE_KEY_FILE=/private/path/github-app.pem

# Optional edge for a dedicated hostname. Leave unset when the Gateway proxies.
# COMPOSE_PROFILES=edge
# AGENT_EDGE_BIND=127.0.0.1
# AGENT_EDGE_PORT=3003

# Static experiment overrides remain deployment configuration. Ordinary
# measurement collection is controlled in the database from Admin -> Measurements.
AGENT_OPERATION_PROFILING_ENABLED=false
AGENT_OPERATION_PROFILING_RUN=
AGENT_OPERATION_PROFILING_SINK=
AGENT_OPERATION_PROFILING_MODE=
AGENT_OPERATION_PROFILING_DEPLOYMENT=default
