# Trusted deployment template, copied as a secret file to the control plane.
# Replace example addresses, token and network ranges before enabling a profile.
# The bootstrap substitutes {deploy_root}, {host}, {node_id}, {allocation_id}.
# Never put CloudLab/API credentials or the management SSH key in this file.
# COMPOSE_PROJECT, AGENT_RUNNER_HOST, AGENT_HOST_STATE_ROOT, deployment SHA,
# Kata backend and one-time enrollment are set by the bootstrap itself.

AGENT_SANDBOX_IMAGE=cloud-agent-sandbox:pilot
# Must equal the stable control plane's existing pool-wide broker token.
AGENT_WORKSPACE_BROKER_TOKEN=REPLACE_WITH_EXISTING_POOL_BROKER_TOKEN

# Three separate, restricted keys on their respective stable machines.
AGENT_TUNNEL_SSH_DESTINATION=agent-inference@gateway.example.org
AGENT_TUNNEL_SSH_KEY={deploy_root}/.compute-secrets/gateway.key
AGENT_TUNNEL_SSH_KNOWN_HOSTS={deploy_root}/.compute-secrets/gateway.known_hosts
AGENT_TUNNEL_REMOTE_HOST=127.0.0.1
AGENT_TUNNEL_REMOTE_PORT=8080

AGENT_MCP_TUNNEL_SSH_DESTINATION=agent-mcp@control.example.org
AGENT_MCP_TUNNEL_SSH_KEY={deploy_root}/.compute-secrets/mcp.key
AGENT_MCP_TUNNEL_SSH_KNOWN_HOSTS={deploy_root}/.compute-secrets/mcp.known_hosts
AGENT_MCP_TUNNEL_REMOTE_HOST=127.0.0.1
AGENT_MCP_TUNNEL_REMOTE_PORT=8001

AGENT_CONTROL_PLANE_TUNNEL_SSH_DESTINATION=agent-control@control.example.org
AGENT_CONTROL_PLANE_TUNNEL_SSH_KEY={deploy_root}/.compute-secrets/control.key
AGENT_CONTROL_PLANE_TUNNEL_SSH_KNOWN_HOSTS={deploy_root}/.compute-secrets/control.known_hosts
AGENT_CONTROL_PLANE_TUNNEL_REMOTE_HOST=127.0.0.1
AGENT_CONTROL_PLANE_TUNNEL_REMOTE_PORT=8000

# Example only: use the actual control-plane Docker bridge gateway. Never
# wildcard or loopback. Reserve a DIFFERENT port for each overlapping profile.
AGENT_BROKER_REVERSE_BIND=172.30.0.1
AGENT_BROKER_REVERSE_PORT=19092
AGENT_WORKSPACE_BROKER_ADVERTISE_URL=http://172.30.0.1:19092

# Pick a range that does not overlap actual host/site routes or protected CIDRs.
AGENT_EGRESS_CHAT_NETWORK_POOL=172.29.0.0/16
AGENT_EGRESS_DNS_SERVER=1.1.1.1
AGENT_EGRESS_PROTECTED_CIDRS=192.0.2.0/24
AGENT_HOST_SLOTS=3
AGENT_RETAINED_DOCKER_DATA_ROOT=/var/lib/docker
AGENT_SHARED_RESIDENT_CAPACITY=8
AGENT_HOST_STORAGE_PROBE=overlay_root
