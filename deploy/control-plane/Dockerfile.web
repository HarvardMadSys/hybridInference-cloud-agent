# The cloud agent's web app.
#
# Next.js in `standalone` output mode, which emits a self-contained server
# under `.next/standalone` — so the runtime image carries neither the source
# nor the dev dependencies.
#
# Two classes of configuration, and the difference is the whole point:
#
#   * **Build arguments** are substituted into the bundle during `next build`.
#     `basePath` is resolved by `next.config.js` at that moment, and
#     `NEXT_PUBLIC_AGENT_API_URL` is how the browser reaches the control plane.
#     Both describe the image *variant* — where this app is mounted — so a
#     deployment that changes one rebuilds.
#   * **Runtime environment** is read by the server on every request. The
#     deployment's identity — product name, organisation, status page, the
#     gateway's origin — is in this class. Setting one of those on the running
#     container changes the site with no rebuild, and this image carries no
#     deployment's brand at build time.
#
# A variable in the wrong class fails quietly, which is worth stating plainly:
# a `NEXT_PUBLIC_*` set only on the running container does nothing at all, and
# a runtime variable passed only as a build argument is discarded before the
# server starts.

FROM node:20-alpine AS builder
WORKDIR /app

# Dependencies first, so a source-only change does not reinstall them.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

# Declared here because Docker only passes a build argument to the stage that
# names it. Empty defaults so a plain `docker build` still produces a working
# image — one that owns its hostname and signs nobody in, which is the honest
# result of configuring nothing.
#
# Every `NEXT_PUBLIC_*` the app reads belongs here. One that ENVIRONMENT.md
# documents and this list omits is a knob no deployment can turn: the bundle is
# built with the code's fallback and setting the variable anywhere — compose,
# the host, the running container — changes nothing. `NEXT_PUBLIC_STATUS_URL`
# was exactly that, and the header's Status link pointed at the empty string.
ARG NEXT_PUBLIC_BASE_PATH=
ARG NEXT_PUBLIC_AGENT_API_URL=
ARG NEXT_PUBLIC_BUILD_SHA=
ARG NEXT_PUBLIC_BUILD_TIMESTAMP=
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH \
    NEXT_PUBLIC_AGENT_API_URL=$NEXT_PUBLIC_AGENT_API_URL \
    NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA \
    NEXT_PUBLIC_BUILD_TIMESTAMP=$NEXT_PUBLIC_BUILD_TIMESTAMP \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Not root. This process is reachable from a reverse proxy that is reachable
# from the internet.
RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

# `standalone` carries its own minimal node_modules and server.js. Static
# assets are emitted outside it and have to be copied alongside, or every
# stylesheet and script 404s while the HTML renders fine — a page that loads
# unstyled and inert.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# No `public/` copy. This app has no such directory, and `COPY` of a missing
# path fails the build rather than skipping it — the usual boilerplate line
# would make this Dockerfile unbuildable from the first `docker build`. Add it
# back the day something is put there.

# What this image is, in the two places a deployment looks: OCI's own labels,
# and one of ours naming the artifact's role. A resolver reads both out of the
# platform image it is about to run and compares them with the release
# manifest — the revision against the manifest's source commit, the role
# against the artifact it stands in for — so a build matrix that swaps two
# digests is caught where the release is consumed rather than where it is
# deployed. `SOURCE_COMMIT` is supplied by the publication build; an image
# built by hand says `unknown`, and a resolver refuses it.
ARG SOURCE_COMMIT=unknown
ARG NEXT_PUBLIC_BASE_PATH=
LABEL org.opencontainers.image.source="https://github.com/HarvardMadSys/hybridInference-cloud-agent" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.hybridinference.artifact.role="web" \
      io.hybridinference.artifact.base_path="${NEXT_PUBLIC_BASE_PATH}"

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
