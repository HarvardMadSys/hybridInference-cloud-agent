# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Testing / coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.local-ci/
apps/frontend/playwright-report/
apps/frontend/test-results/

# Environment — never commit secrets; see ENVIRONMENT.md
.env
.env.*
!.env.example
*.pem
*.key
.compute-secrets/
pgadmin-password

# Node / Next.js (apps/frontend/)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local agent workspaces
/workspaces/

# Written by deploy.sh on the deployment host: which commit is actually running.
.deployed-sha
.deployed-at
# Host readiness is deployment metadata, written beside .deployed-sha.
.shared-live-ready
# The host stack's dedicated, read-only-bound storage attestation directory.
.storage-probe/
# Legacy file from the earlier single-file bind deployment.
.storage-probe-verdict
# Local inference test credential (never commit).
/api_key
# Docs translation: catalog templates are regenerated by `make docs-gettext`,
# and Sphinx compiles .mo files from the committed .po catalogs at build time.
docs/gettext/
docs/developer/locale/**/*.mo
