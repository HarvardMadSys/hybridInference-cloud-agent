{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash",
            "args": [
              "-c",
              "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-pr-check.sh\" || exit 2"
            ],
            "timeout": 3600,
            "statusMessage": "Running the required local checks before creating the pull request"
          }
        ]
      },
      {
        "matcher": "^mcp__.*__create_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-pr-check.sh\" || exit 2"
            ],
            "timeout": 3600,
            "statusMessage": "Running the required local checks before creating the pull request"
          }
        ]
      }
    ]
  }
}
